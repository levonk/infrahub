# === Hosts-file blocklist (all machines) ===

levonk-deploy-hosts-blocklist:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Deploying hosts-file blocklist to all levonk machines..."
    echo "  → OCI cloud server + isolation VMs (Oracle Linux)..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_BOOTSTRAP}} --tags hosts-blocklist --vault-password-file {{VAULT_PASSWORD}}
    echo "  → Localnet hosts (Linux)..."
    devbox run -- ansible-playbook -i {{LOCALNET_INVENTORY}} {{PB_LOCALNET_TAILSCALE}} --tags hosts-blocklist --ask-vault-pass
    echo "  → AI inference host / kckinai (NVIDIA Linux)..."
    devbox run -- ansible-playbook -i {{LOCALNET_INVENTORY}} {{PB_AI_INFERENCE}} --tags hosts-blocklist --limit kckinai --ask-vault-pass
    echo "  → Windows Docker hosts..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} {{PB_WINDOWS_HARDEN}} --tags hosts-blocklist --vault-password-file {{VAULT_PASSWORD}}
    echo "  → macOS hosts..."
    devbox run -- ansible-playbook -i {{MACOS_INVENTORY}} {{PB_MACOS_BOOTSTRAP}} --tags hosts-blocklist --vault-password-file {{VAULT_PASSWORD}} --ask-become-pass
    echo "Hosts-file blocklist deployed to all machines."

levonk-deploy-hosts-blocklist-check:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Dry-run hosts-file blocklist deployment (check mode)..."
    echo "  → OCI cloud server + isolation VMs (Oracle Linux)..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_BOOTSTRAP}} --tags hosts-blocklist --check --diff --vault-password-file {{VAULT_PASSWORD}}
    echo "  → Localnet hosts (Linux)..."
    devbox run -- ansible-playbook -i {{LOCALNET_INVENTORY}} {{PB_LOCALNET_TAILSCALE}} --tags hosts-blocklist --check --diff --ask-vault-pass
    echo "  → AI inference host / kckinai (NVIDIA Linux)..."
    devbox run -- ansible-playbook -i {{LOCALNET_INVENTORY}} {{PB_AI_INFERENCE}} --tags hosts-blocklist --check --diff --limit kckinai --ask-vault-pass
    echo "  → Windows Docker hosts..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} {{PB_WINDOWS_HARDEN}} --tags hosts-blocklist --check --diff --vault-password-file {{VAULT_PASSWORD}}
    echo "  → macOS hosts..."
    devbox run -- ansible-playbook -i {{MACOS_INVENTORY}} {{PB_MACOS_BOOTSTRAP}} --tags hosts-blocklist --check --diff --vault-password-file {{VAULT_PASSWORD}} --ask-become-pass
    echo "Dry-run complete."

# === Validation ===

levonk-syntax:
    @echo "Checking playbook syntax (with levonk inventories)..."
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_BOOTSTRAP}} || true
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_VPN}} || true
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_INFRA}} || true
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_VMS}} || true
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_SITE}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} {{PB_WINDOWS_BOOTSTRAP}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} {{PB_WORLDMONITOR}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} {{PB_BASE_DEV}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} -i {{CNO_INVENTORY}} {{PB_RUSTFS}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} -i {{CNO_INVENTORY}} {{PB_WAZUH}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} -i {{CNO_INVENTORY}} {{PB_QM}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} {{PB_CROC_RELAY}} || true
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_PAPERCLIP}} || true
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_VAL_PAPERCLIP}} || true
    devbox run -- ansible-playbook --syntax-check -i {{CNO_INVENTORY}} {{PB_LOCAL_REGISTRY}} || true
    devbox run -- ansible-playbook --syntax-check -i {{MACOS_INVENTORY}} {{PB_MACOS_BOOTSTRAP}} || true
    devbox run -- ansible-playbook --syntax-check -i {{NL_INVENTORY}} {{PB_WINDOWS_HARDEN}} || true
    devbox run -- ansible-playbook --syntax-check -i {{LOCALNET_INVENTORY}} {{PB_LOCALNET_TAILSCALE}} || true
    devbox run -- ansible-playbook --syntax-check -i {{LOCALNET_INVENTORY}} {{PB_AI_INFERENCE}} || true
    @echo "Syntax check complete."

levonk-validate-bootstrap:
    @echo "Validating bootstrap deployment..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_VAL_BOOTSTRAP}}

levonk-validate-vpn:
    @echo "Validating VPN deployment..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_VAL_VPN}}

levonk-validate-infra:
    @echo "Validating infrastructure deployment..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_VAL_INFRA}}

levonk-validate-vms:
    @echo "Validating VM deployment..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_VAL_VMS}}

levonk-validate-verdaccio:
    @echo "Validating Verdaccio NPM Registry deployment..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} -i {{CNO_INVENTORY}} {{PB_VAL_VERDACCIO}} --vault-password-file {{VAULT_PASSWORD}}

levonk-validate-paperclip:
    @echo "Validating Paperclip AI Orchestration deployment..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_VAL_PAPERCLIP}} --vault-password-file {{VAULT_PASSWORD}}

levonk-validate-all: levonk-validate-bootstrap levonk-validate-vpn levonk-validate-infra levonk-validate-vms
    @echo "All validation playbooks complete."

levonk-final-audit:
    @echo "Running final security audit..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_FINAL_AUDIT}}
