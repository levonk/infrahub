# Levonk client-specific justfile.
#
# All levonk deployment recipes live HERE, not in the parent justfile.
# The parent justfile only contains shared/generic recipes (lint, test, etc.).
#
# Architecture map: levonk/active/02-config/ansible/infrastructure/hosts.yml
#   cno (oci-cloud-server) → arm64   nl (dtop202311) → amd64
#
# Build workflow (AGENTS.md Invariant #2): build on Mac → push to OCI registry → pull on target.
# The build script uses docker buildx for native multi-arch (amd64+arm64) in one command.

INFRAHUB_ROOT := justfile_directory() + "/.."
ANSIBLE_ROOT := INFRAHUB_ROOT + "/shared/active/02-config/ansible"
CNO_INVENTORY := INFRAHUB_ROOT + "/levonk/active/02-config/ansible/inventories/oci.yml"
NL_INVENTORY := INFRAHUB_ROOT + "/levonk/active/02-config/ansible/inventories/windows-docker.yml"
LOCALNET_INVENTORY := INFRAHUB_ROOT + "/levonk/active/02-config/ansible/inventories/localnet.yml"
MACOS_INVENTORY := INFRAHUB_ROOT + "/levonk/active/02-config/ansible/inventories/macos-hosts.yml"
VAULT_PASSWORD := env_var_or_default("HOME", "") + "/.ansible/vault_password"
BUILD_SCRIPT := INFRAHUB_ROOT + "/scripts/build-and-push-images.sh"

# Playbooks
PB_BOOTSTRAP := ANSIBLE_ROOT + "/playbooks/cloud-server-bootstrap.yml"
PB_VPN := ANSIBLE_ROOT + "/playbooks/cloud-server-vpn.yml"
PB_NORDVPN := ANSIBLE_ROOT + "/playbooks/cloud-server-nordvpn.yml"
PB_INFRA := ANSIBLE_ROOT + "/playbooks/cloud-server-infra.yml"
PB_VMS := ANSIBLE_ROOT + "/playbooks/cloud-server-vms.yml"
PB_SITE := ANSIBLE_ROOT + "/playbooks/cloud-server-site.yml"
PB_LOCALNET_TAILSCALE := ANSIBLE_ROOT + "/playbooks/localnet-tailscale.yml"
PB_AI_INFERENCE := ANSIBLE_ROOT + "/playbooks/bootstrap-ai-inference-host.yml"
PB_WINDOWS_EXIT_NODES := ANSIBLE_ROOT + "/playbooks/deploy-windows-exit-nodes.yml"
PB_HOST_EXIT_NODES := INFRAHUB_ROOT + "/levonk/active/02-config/ansible/playbooks/configure-host-exit-nodes.yml"
PB_WINDOWS_BOOTSTRAP := ANSIBLE_ROOT + "/playbooks/bootstrap-windows-docker-host.yml"
PB_WINDOWS_HARDEN := ANSIBLE_ROOT + "/playbooks/harden-windows-host.yml"
PB_WORLDMONITOR := ANSIBLE_ROOT + "/playbooks/deploy-worldmonitor.yml"
PB_BASE_DEV := ANSIBLE_ROOT + "/playbooks/deploy-base-dev.yml"
PB_RUSTFS := ANSIBLE_ROOT + "/playbooks/deploy-rustfs.yml"
PB_CROC_RELAY := ANSIBLE_ROOT + "/playbooks/deploy-croc-relay.yml"
PB_WAZUH := ANSIBLE_ROOT + "/playbooks/deploy-wazuh.yml"
PB_QM := ANSIBLE_ROOT + "/playbooks/deploy-qm.yml"
PB_VERDACCIO := ANSIBLE_ROOT + "/playbooks/deploy-verdaccio.yml"
PB_PAPERCLIP := ANSIBLE_ROOT + "/playbooks/deploy-paperclip.yml"
PB_LOCAL_REGISTRY := ANSIBLE_ROOT + "/playbooks/deploy-local-registry.yml"
PB_MACOS_BOOTSTRAP := ANSIBLE_ROOT + "/playbooks/bootstrap-macos-host.yml"
PB_VAL_BOOTSTRAP := ANSIBLE_ROOT + "/playbooks/validate-bootstrap.yml"
PB_VAL_VPN := ANSIBLE_ROOT + "/playbooks/validate-vpn.yml"
PB_VAL_INFRA := ANSIBLE_ROOT + "/playbooks/validate-infra.yml"
PB_VAL_VMS := ANSIBLE_ROOT + "/playbooks/validate-vms.yml"
PB_VAL_VERDACCIO := ANSIBLE_ROOT + "/playbooks/validate-verdaccio.yml"
PB_VAL_PAPERCLIP := ANSIBLE_ROOT + "/playbooks/validate-paperclip.yml"
PB_FINAL_AUDIT := ANSIBLE_ROOT + "/playbooks/final-audit.yml"

# === Exit Node Images ===

# Build the two locally-built exit-node images (localnet-base-alpine + localnet-proxy-tor)
# for both amd64 and arm64, push to the OCI registry. Skips if already up-to-date.
levonk-build-exit-nodes:
    @echo "Building exit-node images (multi-arch amd64+arm64) → push to registry..."
    bash {{BUILD_SCRIPT}} localnet-base-alpine localnet-proxy-tor

# Force rebuild exit-node images (ignores cache).
levonk-build-exit-nodes-force:
    @echo "Force rebuilding exit-node images (multi-arch amd64+arm64) → push to registry..."
    FORCE_REBUILD=1 bash {{BUILD_SCRIPT}} localnet-base-alpine localnet-proxy-tor

# Check if exit-node images are up-to-date (exit 0 = fresh, 1 = stale).
levonk-check-exit-nodes:
    @echo "Checking exit-node image staleness..."
    @bash {{BUILD_SCRIPT}} --check localnet-base-alpine && \
     bash {{BUILD_SCRIPT}} --check localnet-proxy-tor && \
     echo "All exit-node images are up-to-date." || \
     echo "Some exit-node images are stale — run 'just levonk-build-exit-nodes'."

# === Exit Node Deployment ===

# Deploy exit nodes on cno (OCI, arm64): NordVPN + Tor + Tailscale sidecars.
# Builds images first if stale, then deploys via cloud-server-vpn.yml.
levonk-deploy-exit-nodes-cno: levonk-build-exit-nodes
    @echo "Deploying exit nodes on cno (OCI)..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_VPN}} --vault-password-file {{VAULT_PASSWORD}}

# Dry-run cno exit node deployment (check mode).
levonk-deploy-exit-nodes-cno-check:
    @echo "Dry-run exit node deployment on cno (OCI)..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_VPN}} --check --diff --vault-password-file {{VAULT_PASSWORD}}

# Deploy exit nodes on nl (Windows dtop202311, amd64): NordVPN + Tor + Tailscale sidecars.
# Builds images first if stale, then deploys via deploy-windows-exit-nodes.yml.
levonk-deploy-exit-nodes-nl: levonk-build-exit-nodes
    @echo "Deploying exit nodes on nl (Windows dtop202311)..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} {{PB_WINDOWS_EXIT_NODES}} --vault-password-file {{VAULT_PASSWORD}}

# Dry-run nl exit node deployment (check mode).
levonk-deploy-exit-nodes-nl-check:
    @echo "Dry-run exit node deployment on nl (Windows dtop202311)..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} {{PB_WINDOWS_EXIT_NODES}} --check --diff --vault-password-file {{VAULT_PASSWORD}}

# Deploy exit nodes on BOTH networks (cno first, then nl).
levonk-deploy-exit-nodes-all: levonk-deploy-exit-nodes-cno levonk-deploy-exit-nodes-nl
    @echo "Exit nodes deployed on both cno and nl."

# === Host-Level Exit Nodes (plain egress, no Tor/VPN container) ===
# Enables the host's own Tailscale daemon as an exit node.
# OCI (cno) is already configured via vpn-tailscale role (no action needed).
# Windows (nl) needs IP forwarding + `tailscale set --advertise-exit-node`.
# macOS (lzkmbp2016, lzkmbp2018) needs sysctl ip.forwarding + tailscale set.
# See: levonk/active/02-config/ansible/playbooks/configure-host-exit-nodes.yml

# Configure host-level exit nodes on nl (Windows dtop202311).
levonk-configure-host-exit-nodes-nl:
    @echo "Configuring host-level exit node on nl (Windows dtop202311)..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} {{PB_HOST_EXIT_NODES}} --vault-password-file {{VAULT_PASSWORD}}

# Dry-run host exit node configuration on nl (check mode).
levonk-configure-host-exit-nodes-nl-check:
    @echo "Dry-run host exit node configuration on nl..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} {{PB_HOST_EXIT_NODES}} --check --diff --vault-password-file {{VAULT_PASSWORD}}

# Configure host-level exit nodes on laptops (lzkmbp2016, lzkmbp2018).
# NOTE: IP forwarding is managed by nix-darwin (infra.networking.ipForwarding).
#       Run `darwin-rebuild switch --flake .#<hostname>` first, then this recipe.
levonk-configure-host-exit-nodes-laptops:
    @echo "Configuring host-level exit nodes on laptops (lzkmbp2016, lzkmbp2018)..."
    devbox run -- ansible-playbook -i {{MACOS_INVENTORY}} {{PB_HOST_EXIT_NODES}} --vault-password-file {{VAULT_PASSWORD}}

# Dry-run host exit node configuration on laptops (check mode).
levonk-configure-host-exit-nodes-laptops-check:
    @echo "Dry-run host exit node configuration on laptops..."
    devbox run -- ansible-playbook -i {{MACOS_INVENTORY}} {{PB_HOST_EXIT_NODES}} --check --diff --vault-password-file {{VAULT_PASSWORD}}

# Configure host-level exit nodes on ALL hosts (Windows + laptops).
levonk-configure-host-exit-nodes-all:
    @echo "Configuring host-level exit nodes on all hosts (nl + laptops)..."
    devbox run -- ansible-playbook -i {{NL_INVENTORY}} -i {{MACOS_INVENTORY}} {{PB_HOST_EXIT_NODES}} --vault-password-file {{VAULT_PASSWORD}}

# === NordVPN-only (legacy single-service deploy, if needed) ===

levonk-deploy-nordvpn-cno:
    @echo "Deploying NordVPN on cno (OCI)..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_NORDVPN}} --vault-password-file {{VAULT_PASSWORD}}

# === Service Catalog ===

# Regenerate levonk/SERVICES.md from infrastructure YAML (includes arch column).
levonk-generate-service-catalog:
    @echo "Generating SERVICES.md from infrastructure YAML..."
    devbox run -- python3 {{ANSIBLE_ROOT}}/scripts/generate_service_catalog.py

