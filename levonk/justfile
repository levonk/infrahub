# Deploy Paperclip AI Orchestration on cno (OCI).
# Prerequisites: localnet-ai-paperclip image built+pushed, vault secret present,
# Traefik + Authelia deployed on cno, DNS CNAME paperclip.levonk.com configured.
levonk-build-paperclip:
    @echo "Building localnet-ai-paperclip image (multi-arch) → push to registry..."
    bash {{BUILD_SCRIPT}} localnet-ai-paperclip

levonk-build-paperclip-force:
    @echo "Force rebuilding localnet-ai-paperclip image..."
    FORCE_REBUILD=1 bash {{BUILD_SCRIPT}} localnet-ai-paperclip

levonk-check-paperclip:
    @echo "Checking localnet-ai-paperclip image staleness..."
    @bash {{BUILD_SCRIPT}} --check localnet-ai-paperclip && \
     echo "localnet-ai-paperclip is up-to-date." || \
     echo "localnet-ai-paperclip is stale — run 'just levonk-build-paperclip'."

levonk-deploy-paperclip: levonk-build-paperclip
    @echo "Deploying Paperclip AI Orchestration on cno (OCI)..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_PAPERCLIP}} --vault-password-file {{VAULT_PASSWORD}}

levonk-deploy-paperclip-check:
    @echo "Dry-run Paperclip deployment (check mode)..."
    devbox run -- ansible-playbook -i {{CNO_INVENTORY}} {{PB_PAPERCLIP}} --check --diff --vault-password-file {{VAULT_PASSWORD}}

