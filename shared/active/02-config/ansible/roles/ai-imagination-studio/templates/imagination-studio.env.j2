# Imagination Studio environment — managed by the ai-imagination-studio Ansible role.
# Consumed via systemd EnvironmentFile= by imagination-studio.service; read by
# scripts/app.sh and app/server.py from the process environment.
#
# HOST is the host's tailscale IPv4: the app listens on the tailnet interface
# only — never 0.0.0.0, never the LAN address.
HOST={{ ai_studio_bind_ip }}
PORT={{ ai_studio_port }}
STUDIO_HOME={{ ai_studio_home }}
PREFIX={{ ai_studio_prefix }}
{% for key, value in ai_studio_env_extra.items() %}
{{ key }}={{ value }}
{% endfor %}
