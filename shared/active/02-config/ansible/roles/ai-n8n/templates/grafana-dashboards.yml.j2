# Grafana dashboard provider provisioning
# Generated by Ansible — DO NOT EDIT MANUALLY
# Dashboards are loaded from /var/lib/grafana/dashboards/ inside the container.

apiVersion: 1

providers:
  - name: "n8n Dashboards"
    orgId: 1
    folder: "n8n"
    type: file
    disableDeletion: false
    editable: true
    updateIntervalSeconds: "{{ infra_healthcheck_interval }}"
    options:
      path: /var/lib/grafana/dashboards
