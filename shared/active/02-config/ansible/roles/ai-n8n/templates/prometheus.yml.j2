# Prometheus configuration for n8n observability
# Generated by Ansible — DO NOT EDIT MANUALLY
# Scrapes n8n /metrics endpoint on the n8n container (same Docker network)

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "n8n"
    static_configs:
      - targets:
          - "{{ n8n_container_name }}:{{ n8n_container_port }}"
    metrics_path: /metrics
