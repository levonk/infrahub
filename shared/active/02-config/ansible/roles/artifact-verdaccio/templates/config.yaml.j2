# Verdaccio Configuration — rendered by Ansible
# Domain: {{ verdaccio_domain }}

storage: /verdaccio/storage
plugins: /verdaccio/plugins

web:
  title: localnet NPM Registry ({{ verdaccio_domain }})
  enable: true

auth:
  htpasswd:
    file: /verdaccio/conf/htpasswd
    algorithm: bcrypt
    rounds: 10  # project-lint: disable=magic-int  hash/rounds parameter, not a standalone magic number
    max_users: -1

uplinks:
  npmjs:
    url: https://registry.npmjs.org/
    timeout: "{{ infra_timeout_default }}"

packages:
  '@levonk/*':
    access: $all
    publish: $authenticated
    unpublish: $authenticated
    proxy: npmjs

  '**':
    access: $all
    publish: $authenticated
    unpublish: $authenticated
    proxy: npmjs

server:
  keepAliveTimeout: "{{ infra_timeout_long }}"

log: {type: stdout, format: pretty, level: http}

listen: {{ infra_network_bind_all }}:{{ verdaccio_container_port }}
