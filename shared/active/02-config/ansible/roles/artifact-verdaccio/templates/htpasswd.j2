# Verdaccio htpasswd — rendered by Ansible
# When vault_verdaccio_admin_password is empty (vault not yet populated), a
# locked placeholder is rendered so the file is valid but login is impossible.
{{ verdaccio_admin_username }}:{{ (verdaccio_admin_password | default('') | length > 0) | ternary(verdaccio_admin_password | password_hash('bcrypt', rounds=10), '!!locked-no-password-set') }}  # project-lint: disable=magic-int  hash/rounds parameter, not a standalone magic number
