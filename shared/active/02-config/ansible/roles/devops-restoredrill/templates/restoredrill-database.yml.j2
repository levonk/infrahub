# restoredrill config for {{ db_item.name }}
# Generated by Ansible — DO NOT EDIT MANUALLY
# Source: shared/active/02-config/ansible/roles/devops-restoredrill/templates/restoredrill-database.yml.j2

backup:
  source: "{{ restoredrill_backup_dir }}/{{ db_item.name }}-latest.dump"
  format: "{% if restoredrill_backup_format == 'custom' %}pg_dump_custom{% else %}pg_dump_sql{% endif %}"

postgres:
  image: "{{ db_item.postgres_image | default(restoredrill_postgres_image) }}"

sandbox:
  keep: on-failure

checks:
  min_size_bytes: 1024
  archive_integrity: true
  rpo_target: "{{ db_item.rpo_target | default('25h') }}"
  min_tables: "{{ db_item.min_tables | default(1) }}"
  sequence_integrity: true
{% if db_item.rto_target is defined %}
  rto_target: "{{ db_item.rto_target }}"
{% endif %}
{% if db_item.verify_as_role is defined %}
  verify_as_role: "{{ db_item.verify_as_role }}"
{% endif %}
{% if db_item.row_counts is defined %}
  row_counts:
{% for rc in db_item.row_counts %}
    - table: {{ rc.table }}
      min: {{ rc.min }}
{% endfor %}
{% endif %}
{% if db_item.queries is defined %}
  queries:
{% for q in db_item.queries %}
    - name: "{{ q.name }}"
      sql: "{{ q.sql }}"
{% endfor %}
{% endif %}

{% if restoredrill_slack_webhook_url | length > 0 or restoredrill_webhook_url | length > 0 %}
notify:
{% if restoredrill_slack_webhook_url | length > 0 %}
  slack_webhook_url: "{{ restoredrill_slack_webhook_url }}"
{% endif %}
{% if restoredrill_webhook_url | length > 0 %}
  webhook_url: "{{ restoredrill_webhook_url }}"
{% endif %}
{% endif %}

output:
  prometheus_textfile: "{{ restoredrill_prometheus_textfile }}"

report:
  path: "{{ restoredrill_report_dir }}/restoredrill-{{ db_item.name }}-report.json"
