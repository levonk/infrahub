#!/bin/bash
# restoredrill drill wrapper for {{ db_item.name }}
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# This script does three things:
#   1. pg_dump the {{ db_item.container }} Postgres container → backup file
#   2. Run restoredrill against that backup → verify it restores
#   3. Rotate old backups (keep {{ restoredrill_backup_retention_count }} most recent)
#
# Exit codes:
#   0 = drill passed (backup created + restored + all checks passed)
#   non-zero = drill failed (see restoredrill report for details)

set -euo pipefail

DB_NAME="{{ db_item.name }}"
DB_CONTAINER="{{ db_item.container }}"
DB_DATABASE="{{ db_item.db_name }}"
DB_USER="{{ db_item.db_user }}"
DB_PASSWORD="{{ db_item.db_password | default(vault_restoredrill_pg_password | default('')) }}"
BACKUP_DIR="{{ restoredrill_backup_dir }}"
BACKUP_FILE="${BACKUP_DIR}/${DB_NAME}-$(date -u +%Y%m%dT%H%M%SZ).dump"
LATEST_LINK="${BACKUP_DIR}/${DB_NAME}-latest.dump"
CONFIG_FILE="{{ restoredrill_config_dir }}/restoredrill-${DB_NAME}.yml"
RESTOREDDRILL="{{ restoredrill_binary_path }}"
RETENTION={{ restoredrill_backup_retention_count }}
DUMP_FORMAT="{% if restoredrill_backup_format == 'custom' %}-Fc{% else %}-Fp{% endif %}"
DOCKER_NETWORK="{{ restoredrill_docker_network }}"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Starting restoredrill drill for ${DB_NAME}"

# ---------------------------------------------------------------------------
# Step 1: pg_dump from the running Postgres container
# ---------------------------------------------------------------------------
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Creating backup of ${DB_DATABASE} from ${DB_CONTAINER}"

# Run pg_dump inside the Postgres container, stream the dump to the host.
# Uses docker exec + stdout redirect — no need to copy pg_dump binary to host.
docker exec -e PGPASSWORD="${DB_PASSWORD}" "${DB_CONTAINER}" \
  pg_dump ${DUMP_FORMAT} -U "${DB_USER}" -d "${DB_DATABASE}" \
  > "${BACKUP_FILE}"

if [ ! -s "${BACKUP_FILE}" ]; then
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] ERROR: Backup file is empty — pg_dump failed"
  exit 1
fi

BACKUP_SIZE=$(stat -c %s "${BACKUP_FILE}" 2>/dev/null || stat -f %z "${BACKUP_FILE}")
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Backup created: ${BACKUP_FILE} (${BACKUP_SIZE} bytes)"

# Update the -latest symlink to point at the new backup
ln -sfn "$(basename "${BACKUP_FILE}")" "${LATEST_LINK}"

# ---------------------------------------------------------------------------
# Step 2: Run restoredrill to verify the backup restores
# ---------------------------------------------------------------------------
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Running restoredrill verification"

"${RESTOREDDRILL}" \
  --config "${CONFIG_FILE}" \
  --trigger {{ restoredrill_trigger }} \
  --triggered-by "{{ restoredrill_triggered_by }}"

DRILL_EXIT=$?
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] restoredrill exit code: ${DRILL_EXIT}"

# ---------------------------------------------------------------------------
# Step 3: Rotate old backups (keep N most recent)
# ---------------------------------------------------------------------------
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Rotating backups (keeping ${RETENTION} most recent)"

# List backups for this DB (excluding the -latest symlink), oldest first
ls -1t "${BACKUP_DIR}/${DB_NAME}"-*.dump 2>/dev/null | grep -v 'latest' | tail -n +$((RETENTION + 1)) | while read -r old_file; do
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Removing old backup: ${old_file}"
  rm -f "${old_file}"
done

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Drill for ${DB_NAME} complete (exit: ${DRILL_EXIT})"
exit ${DRILL_EXIT}
