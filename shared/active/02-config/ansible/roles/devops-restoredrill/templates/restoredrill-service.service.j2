# systemd service for restoredrill {{ db_item.name }} drill
# Generated by Ansible — DO NOT EDIT MANUALLY
[Unit]
Description=restoredrill backup + restore verification for {{ db_item.name }}
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart={{ restoredrill_config_dir }}/restoredrill-drill-{{ db_item.name }}.sh
User=root
Group=root
# Timeout: allow up to 30 minutes for large databases
TimeoutStartSec={{ infra_timeout_half_hour }}
# Standard output/error go to journald
StandardOutput=journal
StandardError=journal
# Working directory for relative paths in restoredrill config
WorkingDirectory={{ restoredrill_config_dir }}
