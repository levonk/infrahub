http:
  pprof:
    port: 6060
    enabled: false
  doh:
    routes:
      - GET /dns-query
      - POST /dns-query
      - GET /dns-query/{ClientID}
      - POST /dns-query/{ClientID}
    insecure_enabled: false
  address: {{ infra_network_bind_all }}:{{ dns_lite_adguard_web_container_port }}
  session_ttl: 30d
users:
  - name: {{ dns_lite_adguard_admin_user }}
    password: {{ dns_lite_adguard_admin_password_hash }}
auth_attempts: {{ infra_auth_attempts_default }}
block_auth_min: {{ infra_delay_long }}
http_proxy: ""
language: ""
theme: auto
dns:
  bind_hosts:
    - {{ infra_network_bind_all }}
  port: {{ dns_lite_adguard_dns_container_port }}
  anonymize_client_ip: false
  ratelimit: 20
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []
  refuse_any: true
  upstream_dns:
    - {{ dns_lite_unbound_ip }}:{{ dns_lite_unbound_container_port }}
  upstream_dns_file: ""
  bootstrap_dns:
    - {{ infra_dns_cloudflare_primary }}
    - {{ infra_dns_quad9_primary }}
  fallback_dns:
{% for upstream in dns_lite_fallback_upstreams %}
    - {{ upstream }}
{% endfor %}
  upstream_mode: load_balance
  fastest_timeout: {{ infra_timeout_one_second }}s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies: []
  cache_enabled: true
  cache_size: {{ infra_size_4m }}
  cache_ttl_min: {{ infra_timeout_long }}
  cache_ttl_max: {{ infra_timeout_day_long }}
  cache_optimistic: true
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: true
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: {{ infra_worker_count_high }}
  handle_ddr: true
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: {{ infra_delay_long }}s
  private_networks: []
  use_private_ptr_resolvers: true
  local_ptr_upstreams: []
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: true
  pending_requests:
    enabled: true
tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: {{ infra_port_proxy_https_host }}
  port_dns_over_tls: {{ infra_port_dns_dot_host }}
  port_dns_over_quic: {{ infra_port_dns_doq_host }}
  port_dnscrypt: {{ infra_port_dns_dnscrypt_host }}
  dnscrypt_config_file: ""
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false
querylog:
  dir_path: ""
  ignored: []
  interval: 90d
  size_memory: 1000
  enabled: true
  ignored_enabled: false
  file_enabled: true
statistics:
  dir_path: ""
  ignored: []
  interval: 1d
  enabled: true
  ignored_enabled: false
filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2
whitelist_filters: []
user_rules: []
dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: {{ infra_timeout_day_long }}
    icmp_timeout_msec: {{ infra_timeout_request }}
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: {{ infra_timeout_day_long }}
    ra_slaac_only: false
    ra_allow_slaac: false
filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: UTC
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites: []
  safe_fs_patterns: []
  max_http_size: 256MB
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 24
  blocked_response_ttl: {{ infra_dns_ttl_short }}
  filtering_enabled: true
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true
clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []
log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: {{ infra_log_max_size_mb }}
  max_age: 3
  compress: false
  local_time: false
  verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0
schema_version: {{ dns_lite_adguard_schema_version }}
