# dnscrypt-proxy — lite privacy tier (managed by Ansible, dns-lite role)
# Combined DNSCrypt + ODoH: the full chain runs these as separate tiers for
# CoreDNS-ordered fallback; on small hosts one process covers both. Anonymized
# routing via '*' auto-selects compatible relays per server.
#
# Privacy model (per shared/docs/pipelines/dns/complete-dns-chain.md):
#   - ODoH: relay sees client IP but not query; target sees query but not IP
#   - Anonymized DNSCrypt: same split via relay forwarding

listen_addresses = ['0.0.0.0:{{ dns_lite_dnscrypt_container_port }}']

ipv4_servers = true
ipv6_servers = false

dnscrypt_servers = true
doh_servers = false
odoh_servers = true

require_dnssec = true
require_nolog = true
require_nofilter = true

lb_strategy = 'p2'

# Bootstrap resolvers — used only to resolve the source-list hostnames and
# DoH/ODoH endpoint names before encrypted DNS is up (see complete-dns-chain.md:
# providers are bootstrap-only, never in the resolution chain).
bootstrap_resolvers = ['{{ infra_dns_cloudflare_primary }}:53', '{{ infra_dns_quad9_primary }}:53']
ignore_system_dns = true

[sources]

  [sources.'public-resolvers']
    urls = ['https://raw.githubusercontent.com/DNSCrypt/dnscrypt-resolvers/master/v3/public-resolvers.md', 'https://download.dnscrypt.info/resolvers-list/v3/public-resolvers.md']
    cache_file = 'public-resolvers.md'
    minisign_key = 'RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3'
    refresh_delay = 72
    prefix = ''

  [sources.'relays']
    urls = ['https://raw.githubusercontent.com/DNSCrypt/dnscrypt-resolvers/master/v3/relays.md', 'https://download.dnscrypt.info/resolvers-list/v3/relays.md']
    cache_file = 'relays.md'
    minisign_key = 'RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3'
    refresh_delay = 72
    prefix = ''

  [sources.'odoh-servers']
    urls = ['https://raw.githubusercontent.com/DNSCrypt/dnscrypt-resolvers/master/v3/odoh-servers.md', 'https://download.dnscrypt.info/resolvers-list/v3/odoh-servers.md']
    cache_file = 'odoh-servers.md'
    minisign_key = 'RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3'
    refresh_delay = 72
    prefix = ''

  [sources.'odoh-relays']
    urls = ['https://raw.githubusercontent.com/DNSCrypt/dnscrypt-resolvers/master/v3/odoh-relays.md', 'https://download.dnscrypt.info/resolvers-list/v3/odoh-relays.md']
    cache_file = 'odoh-relays.md'
    minisign_key = 'RWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3'
    refresh_delay = 72
    prefix = ''

[anonymized_dns]

# '*' auto-selects a compatible relay for every server — anonymized DNSCrypt
# for dnscrypt servers, relay-pinned ODoH for ODoH servers.
routes = [
  { server_name = '*', via = ['*'] }
]
