# Managed by Ansible — dns-lite role
# Unbound recursive resolver (single tier: direct root resolution, DNSSEC-validating)
# Derived from services/dns/unbound unbound-root.conf.template.

server:
    interface: 0.0.0.0
    port: {{ dns_lite_unbound_container_port }}
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes

    # DNSSEC validation
    module-config: "validator iterator"
    val-permissive-mode: no
    val-clean-additional: yes
    # Primed from the role's files/root.key (KSK-2017 + KSK-2024 DS records) in
    # a writable dir mount — unbound rolls the anchor via temp-file + rename,
    # which a file bind-mount would reject.
    auto-trust-anchor-file: "/var/lib/unbound/root.key"

    # Extended DNS Errors (RFC 8914)
    ede: yes

    # Caching
    cache-min-ttl: 60
    cache-max-ttl: 86400
    serve-expired: yes
    serve-expired-ttl: 86400
    prefetch: yes
    num-threads: 2
    so-reuseport: yes

    # Privacy
    qname-minimisation: yes
    edns-buffer-size: 1232
    harden-glue: yes
    harden-dnssec-stripped: yes
    harden-referral-path: yes
    use-caps-for-id: yes
    hide-identity: yes
    hide-version: yes

    # Logging
    verbosity: 1
    use-syslog: no
    logfile: ""

    # Access control — container network + localhost only; AdGuard is the
    # sole client in the reduced chain.
    access-control: 0.0.0.0/0 refuse
    access-control: {{ dns_lite_network_subnet }} allow
    access-control: 127.0.0.0/8 allow
