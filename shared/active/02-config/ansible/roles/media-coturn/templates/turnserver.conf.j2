# coturn TURN/STUN server configuration
# Generated by Ansible — DO NOT EDIT MANUALLY
# Realm: {{ media_coturn_realm }}
# Purpose: WebRTC voice chat relay for Local Watch Party

# Network
listening-port={{ media_coturn_stun_turn_container_port }}
listening-ip={{ media_coturn_bind_address }}  # project-lint: disable=magic-ipv4  bind address from infra vars
{% if media_coturn_external_ip | length > 0 %}
external-ip={{ media_coturn_external_ip }}
{% endif %}

# Relay port range
min-port={{ media_coturn_relay_min_port }}
max-port={{ media_coturn_relay_max_port }}

# Authentication
lt-cred-mech
realm={{ media_coturn_realm }}
fingerprint
user={{ media_coturn_username }}:{{ media_coturn_password }}

# Hardening
no-multicast-peers
no-loopback-peers
stale-nonce={{ media_coturn_stale_nonce | default('600') }}  # project-lint: disable=magic-int  coturn nonce lifetime in seconds

# Rate limiting and quotas
unauthorized-ratelimit
unauthorized-ratelimit-rps={{ media_coturn_ratelimit_rps | default('10') }}  # project-lint: disable=magic-int  coturn rate limit per second
user-quota={{ media_coturn_user_quota | default('10') }}  # project-lint: disable=magic-int  max allocations per user
total-quota={{ media_coturn_total_quota | default('100') }}  # project-lint: disable=magic-int  max total allocations

# Bandwidth limits (1 Mbps per session, 10 Mbps total)
max-bps={{ media_coturn_max_bps | default('1048576') }}  # project-lint: disable=magic-int  1 Mbps per session in bytes/sec
total-bps={{ media_coturn_total_bps | default('10485760') }}  # project-lint: disable=magic-int  10 Mbps total in bytes/sec

# Logging
log-file=stdout
simple-log
