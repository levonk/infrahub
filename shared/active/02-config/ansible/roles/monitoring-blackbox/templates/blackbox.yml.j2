---
# blackbox_exporter module configuration
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Modules used by prometheus.yml.j2 scrape jobs:
#   http_up     — HTTP(S) endpoint; any non-5xx response = service alive
#   tcp_connect — raw TCP connect (databases, proxies, SOCKS, Redis, SSH)
#   dns_udp     — DNS query for {{ infra_domain_base | default('the base domain') }}
#   icmp_ping   — ICMP echo (host/egress reachability)

modules:
  http_up:
    prober: http
    timeout: 10s  # project-lint: disable=magic-unitnum  duration
    http:
      method: GET
      # Any response below 500 proves the HTTP stack is alive (login pages,
      # auth redirects, API root 404s are all "up"). 5xx = broken.
      valid_status_codes: [200, 201, 202, 203, 204, 301, 302, 307, 308, 400, 401, 403, 404]  # project-lint: disable=magic-int  http status codes
      follow_redirects: true
      preferred_ip_protocol: ip4
      tls_config:
        insecure_skip_verify: true

  tcp_connect:
    prober: tcp
    timeout: 5s  # project-lint: disable=magic-unitnum  duration
    tcp:
      preferred_ip_protocol: ip4

  dns_udp:
    prober: dns
    timeout: 5s  # project-lint: disable=magic-unitnum  duration
    dns:
      query_name: "{{ infra_domain_base | default('example.com') }}"
      query_type: A
      valid_rcodes:
        - NOERROR
      preferred_ip_protocol: ip4
      transport_protocol: udp

  icmp_ping:
    prober: icmp
    timeout: 5s  # project-lint: disable=magic-unitnum  duration
    icmp:
      preferred_ip_protocol: ip4
