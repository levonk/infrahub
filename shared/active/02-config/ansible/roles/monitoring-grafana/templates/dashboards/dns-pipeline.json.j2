{% raw %}
{
  "dashboard": {
    "id": null,
    "uid": "dns-pipeline",
    "title": "DNS Pipeline",
    "tags": ["pipeline", "observability"],
    "timezone": "browser",
    "schemaVersion": 41,  # project-lint: disable=magic-int  grafana schema version
    "refresh": "30s",  # project-lint: disable=magic-unitnum  dashboard refresh interval
    "time": {
      "from": "now-6h",  # project-lint: disable=magic-unitnum  dashboard time range
      "to": "now"
    },
    "templating": {
      "list": []
    },
    "panels": [
      {
        "id": 1,  # project-lint: disable=magic-int  grafana panel id
        "type": "stat",
        "title": "DNS Pipeline Service Status",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "up{pipeline=\"dns\"}", "legendFormat": "{{job}}"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}  # project-lint: disable=magic-int  grafana threshold value
          }
        },
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "orientation": "horizontal"
        }
      },
      {
        "id": 2,  # project-lint: disable=magic-int  grafana panel id
        "type": "stat",
        "title": "DNS Synthetic Probe Results",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "dns_pipeline_probe_success", "legendFormat": "{{query}}"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}  # project-lint: disable=magic-int  grafana threshold value
          }
        },
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "orientation": "horizontal"
        }
      },
      {
        "id": 3,  # project-lint: disable=magic-int  grafana panel id
        "type": "timeseries",
        "title": "DNS Query Latency",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "dns_pipeline_probe_duration_seconds", "legendFormat": "{{query}}", "refId": "A"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
            "unit": "s"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "id": 4,  # project-lint: disable=magic-int  grafana panel id
        "type": "stat",
        "title": "DNS Pipeline Alert Count",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "count(ALERTS{pipeline=\"dns\", alertstate=\"firing\"})", "legendFormat": "firing"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}  # project-lint: disable=magic-int  grafana threshold value
          }
        },
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "orientation": "horizontal"
        }
      }
    ]
  },
  "overwrite": true
}
{% endraw %}
