{% raw %}
{
  "dashboard": {
    "id": null,
    "uid": "infrastructure",
    "title": "Infrastructure",
    "tags": ["pipeline", "observability"],
    "timezone": "browser",
    "schemaVersion": 41,  # project-lint: disable=magic-int  grafana schema version
    "refresh": "30s",  # project-lint: disable=magic-unitnum  dashboard refresh interval
    "time": {
      "from": "now-6h",  # project-lint: disable=magic-unitnum  dashboard time range
      "to": "now"
    },
    "templating": {
      "list": []
    },
    "panels": [
      {
        "id": 1,  # project-lint: disable=magic-int  grafana panel id
        "type": "stat",
        "title": "Monitoring Service Status",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "up{job=~\"prometheus|loki|grafana|alertmanager|uptime-kuma|node_exporter\"}", "legendFormat": "{{job}}"}
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}  # project-lint: disable=magic-int  grafana threshold value
          }
        },
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "orientation": "horizontal"
        }
      },
      {
        "id": 2,  # project-lint: disable=magic-int  grafana panel id
        "type": "timeseries",
        "title": "CPU Usage",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}", "refId": "A"}  # project-lint: disable=magic-int  promql expression constant
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]},  # project-lint: disable=magic-int  grafana threshold value
            "unit": "percent"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "id": 3,  # project-lint: disable=magic-int  grafana panel id
        "type": "timeseries",
        "title": "Memory Usage",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "100 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100)", "legendFormat": "{{instance}}", "refId": "A"}  # project-lint: disable=magic-int  promql expression constant
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]},  # project-lint: disable=magic-int  grafana threshold value
            "unit": "percent"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "id": 4,  # project-lint: disable=magic-int  grafana panel id
        "type": "timeseries",
        "title": "Disk Usage",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} * 100)", "legendFormat": "{{instance}}", "refId": "A"}  # project-lint: disable=magic-int  promql expression constant
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]},  # project-lint: disable=magic-int  grafana threshold value
            "unit": "percent"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "single", "sort": "none"}
        }
      },
      {
        "id": 5,  # project-lint: disable=magic-int  grafana panel id
        "type": "stat",
        "title": "Container Count",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "count(container_last_seen)", "legendFormat": "total"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
          }
        },
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "orientation": "horizontal"
        }
      },
      {
        "id": 6,  # project-lint: disable=magic-int  grafana panel id
        "type": "stat",
        "title": "Infrastructure Alert Count",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {"expr": "count(ALERTS{pipeline=\"infra\", alertstate=\"firing\"})", "legendFormat": "firing"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},  # project-lint: disable=magic-int  grafana panel grid position
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}  # project-lint: disable=magic-int  grafana threshold value
          }
        },
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "orientation": "horizontal"
        }
      }
    ]
  },
  "overwrite": true
}
{% endraw %}
