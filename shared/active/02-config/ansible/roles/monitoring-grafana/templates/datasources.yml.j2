# Grafana datasource provisioning
# Generated by Ansible - DO NOT EDIT MANUALLY
apiVersion: 1  # project-lint: disable=magic-int  api version
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: "http://{{ infra_hostname_monitoring_prometheus }}:{{ infra_port_monitoring_prometheus_container }}"
    isDefault: true
    editable: false
    jsonData:
      timeInterval: 15s  # project-lint: disable=magic-unitnum  duration
  - name: Loki
    type: loki
    access: proxy
    url: "http://{{ infra_hostname_monitoring_loki }}:{{ infra_port_monitoring_loki_container }}"
    editable: false
    jsonData:
      maxLines: 1000  # project-lint: disable=magic-int  max lines
