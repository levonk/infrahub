---
# Loki configuration (single-node, filesystem storage)
# Generated by Ansible — DO NOT EDIT MANUALLY

auth_enabled: false

server:
  http_listen_port: {{ monitoring_loki_container_port }}
  grpc_listen_port: 9096  # project-lint: disable=magic-int  grpc port

common:
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1  # project-lint: disable=magic-int  replication factor
  ring:
    instance_addr: 127.0.0.1  # project-lint: disable=all  instance address
    kvstore:
      store: inmemory

compactor:
  working_directory: /loki/compactor
  compaction_interval: 10m  # project-lint: disable=magic-unitnum  duration
  retention_enabled: true
  retention_delete_delay: 2h  # project-lint: disable=magic-unitnum  duration
  retention_delete_worker_count: 150  # project-lint: disable=magic-int  worker count
  delete_request_store: filesystem

limits_config:
  retention_period: {{ monitoring_loki_retention_period }}
  reject_old_samples: true
  reject_old_samples_max_age: 168h  # project-lint: disable=magic-unitnum  duration

schema_config:
  configs:
    - from: 2020-10-24  # project-lint: disable=magic-int  schema date
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h  # project-lint: disable=magic-unitnum  duration

storage_config:
  tsdb_shipper:
    active_index_directory: /loki/index
    cache_location: /loki/index_cache
  filesystem:
    directory: /loki/chunks

ruler:
  alertmanager_url: "http://{{ infra_hostname_monitoring_alertmanager }}:{{ infra_port_monitoring_alertmanager_container }}"
