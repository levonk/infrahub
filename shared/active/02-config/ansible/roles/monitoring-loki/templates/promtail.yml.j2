---
# Promtail configuration for Docker log collection
# Generated by Ansible — DO NOT EDIT MANUALLY

server:
  http_listen_port: 9080  # project-lint: disable=magic-int  http port
  grpc_listen_port: 0  # project-lint: disable=magic-int  grpc port

positions:
  filename: /etc/promtail/positions.yaml

clients:
  - url: "{{ monitoring_promtail_loki_url }}"

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s  # project-lint: disable=magic-unitnum  duration
    relabel_configs:
      - source_labels: [__meta_docker_container_name]
        regex: '/(.*)'
        target_label: 'container'
      - source_labels: [__meta_docker_container_log_stream]
        target_label: 'logstream'
    pipeline_stages:
      - docker: {}
      - timestamp:
          source: time
          format: RFC3339Nano
      - output:
          source: log
