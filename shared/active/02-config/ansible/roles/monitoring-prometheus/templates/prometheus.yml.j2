---
# Prometheus scrape configuration for the pipeline-observability stack
# Generated by Ansible — DO NOT EDIT MANUALLY

global:
  scrape_interval: 15s  # project-lint: disable=magic-unitnum  duration
  evaluation_interval: 15s  # project-lint: disable=magic-unitnum  duration
  external_labels:
    client: '{{ infra_client | default("levonk") }}'
    cluster: '{{ infra_domain_base }}'

rule_files:
  - '/etc/prometheus/rules/*.yml'

alerting:
  alertmanagers:
    - scheme: http
      static_configs:
        - targets:
            - '{{ infra_hostname_monitoring_alertmanager }}:{{ infra_port_monitoring_alertmanager_container }}'

scrape_configs:
  # Self-monitoring
  - job_name: 'prometheus'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_prometheus_container_port }}'
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'prometheus'

  # Proxy / ingress
  - job_name: 'traefik'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_traefik | default("traefik") }}:{{ proxy_traefik_metrics_port | default("8883") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'infra'
          stage: 'ingress'
          service: 'traefik'

  # SSO
  - job_name: 'authelia'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_authelia | default("authelia") }}:{{ proxy_authelia_metrics_port | default("9092") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'infra'
          stage: 'sso'
          service: 'authelia'

  # Security / IDS
  - job_name: 'crowdsec'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_crowdsec | default("crowdsec") }}:{{ security_crowdsec_prometheus_port | default("6060") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'infra'
          stage: 'security'
          service: 'crowdsec'

  # DNS resolver
  - job_name: 'coredns'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - 'localnet-dns-coredns:{{ infra_port_dns_coredns_prometheus_host | default("9154") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'dns'
          stage: 'resolver'
          service: 'coredns'

  # DNS router
  - job_name: 'dnsdist'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - 'localnet-dns-dnsdist:{{ infra_port_dns_dnsdist_metrics_host | default("8083") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'dns'
          stage: 'router'
          service: 'dnsdist'

  # Host metrics
  - job_name: 'node_exporter'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_node_exporter }}:{{ infra_port_monitoring_node_exporter_container }}'
        labels:
          pipeline: 'infra'
          stage: 'host'
          service: 'node-exporter'

  # Log aggregation
  - job_name: 'loki'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_loki }}:{{ infra_port_monitoring_loki_container }}'
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'loki'

  # Docker service discovery for any container with label prometheus.io/scrape=true
  - job_name: 'docker'
    docker_sd_configs:
      - host: 'unix:///var/run/docker.sock'
        refresh_interval: 5s  # project-lint: disable=magic-unitnum  duration
    relabel_configs:
      - source_labels: [__meta_docker_container_label_prometheus_io_scrape]
        regex: 'true'
        action: keep
      - source_labels: [__meta_docker_container_name]
        regex: '/(.*)'
        target_label: 'container'
