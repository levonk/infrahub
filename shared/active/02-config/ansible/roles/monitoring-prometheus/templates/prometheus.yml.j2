---
# Prometheus scrape configuration for the pipeline-observability stack
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Two scrape layers:
#   1. Native /metrics scrapes  — services that expose Prometheus metrics
#   2. blackbox /probe scrapes  — everything else, derived from services.yml
#      via monitoring_service_probes (monitoring-catalog role)

global:
  scrape_interval: 15s  # project-lint: disable=magic-unitnum  duration
  evaluation_interval: 15s  # project-lint: disable=magic-unitnum  duration
  external_labels:
    client: '{{ infra_client | default("levonk") }}'
    cluster: '{{ infra_domain_base }}'

rule_files:
  - '/etc/prometheus/rules/*.yml'

alerting:
  alertmanagers:
    - scheme: http
      static_configs:
        - targets:
            - '{{ infra_hostname_monitoring_alertmanager }}:{{ infra_port_monitoring_alertmanager_container }}'

scrape_configs:
  # ==========================================================================
  # Native /metrics scrapes
  # ==========================================================================

  - job_name: 'prometheus'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_prometheus_container_port }}'
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'prometheus'

  - job_name: 'traefik'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_traefik | default("traefik") }}:{{ proxy_traefik_metrics_container_port | default("8883") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'infra'
          stage: 'ingress'
          service: 'traefik'

  - job_name: 'authelia'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_authelia | default("authelia") }}:{{ proxy_authelia_metrics_container_port | default("9092") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'infra'
          stage: 'auth'
          service: 'authelia'

  - job_name: 'crowdsec'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_crowdsec | default("crowdsec") }}:{{ security_crowdsec_prometheus_container_port | default("6060") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'infra'
          stage: 'security'
          service: 'crowdsec'

  - job_name: 'litellm'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_litellm | default("litellm") }}:{{ infra_port_ai_litellm_container | default("4000") }}'  # project-lint: disable=magic-int  litellm port
        labels:
          pipeline: 'ai'
          stage: 'gateway'
          service: 'litellm'

  # DNS pipeline — on localnet-network (Prometheus is attached to it)
  - job_name: 'coredns'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - 'localnet-dns-coredns:{{ infra_port_dns_coredns_metrics_host | default("9153") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'dns'
          stage: 'resolver'
          service: 'coredns'

  - job_name: 'dnsdist'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - 'localnet-dns-dnsdist:{{ infra_port_dns_dnsdist_metrics_container | default("8083") }}'  # project-lint: disable=magic-int  metrics port
        labels:
          pipeline: 'dns'
          stage: 'router'
          service: 'dnsdist'

  # Monitoring stack self-monitoring
  - job_name: 'grafana'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_grafana }}:{{ infra_port_monitoring_grafana_container }}'
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'grafana'

  - job_name: 'alertmanager'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_alertmanager }}:{{ infra_port_monitoring_alertmanager_container }}'
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'alertmanager'

  - job_name: 'uptime-kuma'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_uptime_kuma }}:{{ infra_port_monitoring_uptime_kuma_container }}'
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'uptime-kuma'

  - job_name: 'blackbox'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_blackbox | default("localnet-monitoring-blackbox") }}:{{ infra_port_monitoring_blackbox_container | default("9115") }}'  # project-lint: disable=magic-int  blackbox port
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'blackbox'

  - job_name: 'node_exporter'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_node_exporter }}:{{ infra_port_monitoring_node_exporter_container }}'
        labels:
          pipeline: 'infra'
          stage: 'host'
          service: 'node-exporter'

  - job_name: 'loki'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ infra_hostname_monitoring_loki }}:{{ infra_port_monitoring_loki_container }}'
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'loki'

  - job_name: 'promtail'
    metrics_path: '/metrics'
    static_configs:
      - targets:
          - '{{ monitoring_promtail_container_name | default("localnet-monitoring-promtail") }}:{{ infra_port_monitoring_promtail_container | default("9080") }}'  # project-lint: disable=magic-int  promtail port
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'promtail'

  # ==========================================================================
  # blackbox /probe scrapes — every catalog service gets probe_success
  # Labels: pipeline / stage / service / machine (from services.yml)
  # ==========================================================================

  - job_name: 'blackbox-http'
    metrics_path: '/probe'
    params:
      module: [http_up]
    static_configs:
{% for p in ((monitoring_service_probes | default([])) + (monitoring_extra_probes | default([]))) | selectattr('type', 'equalto', 'http') %}
      - targets: ['{{ p.url }}']
        labels:
          service: '{{ p.service }}'
          pipeline: '{{ p.pipeline }}'
          stage: '{{ p.stage }}'
          machine: '{{ p.machine }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '{{ infra_hostname_monitoring_blackbox | default("localnet-monitoring-blackbox") }}:{{ infra_port_monitoring_blackbox_container | default("9115") }}'  # project-lint: disable=magic-int  blackbox port

  - job_name: 'blackbox-tcp'
    metrics_path: '/probe'
    params:
      module: [tcp_connect]
    static_configs:
{% for p in ((monitoring_service_probes | default([])) + (monitoring_extra_probes | default([]))) | selectattr('type', 'equalto', 'tcp') %}
      - targets: ['{{ p.target }}']
        labels:
          service: '{{ p.service }}'
          pipeline: '{{ p.pipeline }}'
          stage: '{{ p.stage }}'
          machine: '{{ p.machine }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '{{ infra_hostname_monitoring_blackbox | default("localnet-monitoring-blackbox") }}:{{ infra_port_monitoring_blackbox_container | default("9115") }}'  # project-lint: disable=magic-int  blackbox port

  - job_name: 'blackbox-dns'
    metrics_path: '/probe'
    params:
      module: [dns_udp]
    static_configs:
{% for p in ((monitoring_service_probes | default([])) + (monitoring_extra_probes | default([]))) | selectattr('type', 'equalto', 'dns') %}
      - targets: ['{{ p.target }}']
        labels:
          service: '{{ p.service }}'
          pipeline: '{{ p.pipeline }}'
          stage: '{{ p.stage }}'
          machine: '{{ p.machine }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: '{{ infra_hostname_monitoring_blackbox | default("localnet-monitoring-blackbox") }}:{{ infra_port_monitoring_blackbox_container | default("9115") }}'  # project-lint: disable=magic-int  blackbox port

  # Docker service discovery — containers explicitly opting in via
  # label prometheus.io/scrape=true get scraped for native metrics.
  - job_name: 'docker'
    docker_sd_configs:
      - host: 'unix:///var/run/docker.sock'
        refresh_interval: 30s  # project-lint: disable=magic-unitnum  duration
    relabel_configs:
      - source_labels: [__meta_docker_container_label_prometheus_io_scrape]
        regex: 'true'
        action: keep
      - source_labels: [__meta_docker_container_name]
        regex: '/(.*)'
        target_label: 'container'
