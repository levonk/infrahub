---
# Prometheus alerting rules for the AI pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY

groups:
  - name: ai_pipeline_alerts
    rules:
      - alert: OmnigentDown
        expr: up{job="omnigent"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'agent'
          service: 'omnigent'
          severity: 'critical'
        annotations:
          summary: 'Omnigent container is down'
          description: 'Omnigent (AI pipeline entry point) is not responding to Prometheus scrapes.'

      - alert: PiDown
        expr: up{job="pi"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'agent'
          service: 'pi'
          severity: 'critical'
        annotations:
          summary: 'Pi agent is down'
          description: 'Pi agent is not responding to Prometheus scrapes.'

      - alert: LiteLLMDown
        expr: up{job="litellm"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'gateway'
          service: 'litellm'
          severity: 'critical'
        annotations:
          summary: 'LiteLLM gateway is down'
          description: 'LiteLLM gateway is not responding; all AI traffic stops here.'

      - alert: HeadroomDown
        expr: up{job="headroom"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'compression'
          service: 'headroom'
          severity: 'critical'
        annotations:
          summary: 'Headroom compression is down'
          description: 'Headroom compression service is not responding to Prometheus scrapes.'

      - alert: OmniRouteDown
        expr: up{job="omniroute"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'routing'
          service: 'omniroute'
          severity: 'critical'
        annotations:
          summary: 'OmniRoute routing is down'
          description: 'OmniRoute routing service is not responding to Prometheus scrapes.'

      - alert: ForgeDown
        expr: up{job="forge"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'forge'
          service: 'forge'
          severity: 'critical'
        annotations:
          summary: 'Forge is down'
          description: 'Forge service is not responding to Prometheus scrapes.'

      - alert: IronProxyDown
        expr: up{job="iron-proxy"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'iron-proxy'
          service: 'iron-proxy'
          severity: 'critical'
        annotations:
          summary: 'Iron-Proxy is down'
          description: 'Iron-Proxy service is not responding to Prometheus scrapes.'

      - alert: NordVPNEgressDown
        expr: up{job="nordvpn", pipeline="ai"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'egress'
          service: 'nordvpn'
          severity: 'critical'
        annotations:
          summary: 'NordVPN egress is down'
          description: 'AI pipeline cannot reach the internet via the NordVPN exit node.'

      - alert: AIPipelineSyntheticProbeFailed
        expr: ai_pipeline_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'synthetic-probe'
          service: 'ai-probe'
          severity: 'critical'
        annotations:
          summary: 'AI pipeline end-to-end probe failed'
          description: 'The AI pipeline synthetic probe did not return a valid OpenAI-compatible response.'

      - alert: AIPipelineDegraded
        expr: ai_pipeline_probe_success{probe="litellm"} == 0
        for: 5m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'synthetic-probe'
          severity: 'warning'
        annotations:
          summary: 'AI pipeline degraded'
          description: 'The AI pipeline LiteLLM synthetic probe has been failing for 5 minutes.'  # project-lint: disable=magic-int  minutes in description
