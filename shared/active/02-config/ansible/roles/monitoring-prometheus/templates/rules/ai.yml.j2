---
# Prometheus alerting rules for the AI pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Chain topology source of truth: shared/docs/pipelines/ai/PIPELINE-AI.md
# Implemented chain: Omnigent -> Pi -> LiteLLM -> Headroom -> OmniRoute
#                    -> Iron-Proxy -> Internet (NordVPN when egress chained)
# Deployed-but-deferred pipeline services (Forge, Privacy Orchestrator) are
# monitored as support nodes, not chain members.
#
# Signal sources:
#   up{job=...}        — native /metrics scrapes (litellm)
#   probe_success{...} — blackbox probes (everything else)
#   *_probe_success    — synthetic probe textfile metrics (node_exporter)

groups:
  - name: ai_pipeline_alerts
    rules:
      - alert: OmnigentDown
        expr: probe_success{service="omnigent"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'agent'
          service: 'omnigent'
          severity: 'critical'
        annotations:
          summary: 'Omnigent is down'
          description: 'Omnigent (AI pipeline entry point) is not responding to blackbox probes.'

      - alert: PiDown
        expr: probe_success{service="pi"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'agent'
          service: 'pi'
          severity: 'critical'
        annotations:
          summary: 'Pi agent is down'
          description: 'Pi agent (coding harness) is not responding to blackbox probes.'

      - alert: LiteLLMDown
        expr: (up{job="litellm"} == 0) or (probe_success{service="litellm"} == 0)
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'gateway'
          service: 'litellm'
          severity: 'critical'
        annotations:
          summary: 'LiteLLM gateway is down'
          description: 'LiteLLM gateway is not responding; all AI traffic stops here.'

      - alert: HeadroomDown
        expr: probe_success{service="headroom"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'compression'
          service: 'headroom'
          severity: 'critical'
        annotations:
          summary: 'Headroom compression is down'
          description: 'Headroom compression service is not responding to blackbox probes.'

      - alert: OmniRouteDown
        expr: probe_success{service="omniroute"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'routing'
          service: 'omniroute'
          severity: 'critical'
        annotations:
          summary: 'OmniRoute routing is down'
          description: 'OmniRoute routing service is not responding to blackbox probes.'

      - alert: IronProxyDown
        expr: probe_success{service="iron-proxy"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'iron-proxy'
          service: 'iron-proxy'
          severity: 'critical'
        annotations:
          summary: 'Iron-Proxy is down'
          description: 'Iron-Proxy egress firewall is not responding to blackbox probes.'

      - alert: NordVPNEgressDown
        expr: probe_success{service="nordvpn"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'egress'
          service: 'nordvpn'
          severity: 'critical'
        annotations:
          summary: 'NordVPN egress is down'
          description: 'AI pipeline cannot reach the internet via the NordVPN exit node.'

      # ── Deployed support services (not chain members per PIPELINE-AI.md) ──
      - alert: ForgeDown
        expr: probe_success{service="forge"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'forge'
          service: 'forge'
          severity: 'warning'
        annotations:
          summary: 'Forge is down'
          description: 'Forge tool-call repair service (Phase 2, deployed early) is not responding.'

      - alert: PrivacyOrchestratorDown
        expr: probe_success{service="privacy-orchestrator"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'privacy'
          service: 'privacy-orchestrator'
          severity: 'warning'
        annotations:
          summary: 'Privacy Orchestrator is down'
          description: 'Privacy Orchestrator PII service (Phase 5, deployed early) is not responding.'

      # ── Synthetic probes (ADR §4.1) ──
      - alert: AIPipelineSyntheticProbeFailed
        expr: ai_pipeline_probe_success{probe="omnigent"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'synthetic-probe'
          service: 'omnigent-probe'
          severity: 'critical'
        annotations:
          summary: 'AI pipeline end-to-end probe failed (Omnigent entry)'
          description: 'Full chain broken: Omnigent -> Pi -> LiteLLM -> Headroom -> OmniRoute -> Iron-Proxy -> egress.'

      - alert: AIPipelineGatewayProbeFailed
        expr: ai_pipeline_probe_success{probe="litellm"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'synthetic-probe'
          service: 'litellm-probe'
          severity: 'critical'
        annotations:
          summary: 'AI pipeline gateway probe failed (LiteLLM entry)'
          description: 'Gateway-to-egress chain broken: LiteLLM -> Headroom -> OmniRoute -> Iron-Proxy -> egress.'

      - alert: AIPipelineProbeUnconfigured
        expr: ai_pipeline_probe_configured == 0
        for: 10m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'synthetic-probe'
          severity: 'info'
        annotations:
          summary: 'AI pipeline synthetic probe is not configured'
          description: 'A probe API key (vault_litellm_synthetic_probe_key or vault_omnigent_synthetic_probe_key) is missing; the probe writes no success metric.'

      - alert: AIPipelineDegraded
        expr: ai_pipeline_probe_success{probe="litellm"} == 0
        for: 5m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'synthetic-probe'
          severity: 'warning'
        annotations:
          summary: 'AI pipeline degraded'
          description: 'The AI pipeline LiteLLM synthetic probe has been failing for 5 minutes.'  # project-lint: disable=magic-int  minutes in description
