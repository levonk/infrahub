---
# Prometheus alerting rules for app-level services (ADR-202608270001 §2)
# Paperclip and Buzz are AI pipeline request-origin peers; JobOps is a
# standalone app on dtop202311 (Windows Docker host).
# Generated by Ansible — DO NOT EDIT MANUALLY

groups:
  - name: apps_alerts
    rules:
      - alert: PaperclipDown
        expr: service_probe_success{service="paperclip"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'orchestration'
          service: 'paperclip'
          severity: 'critical'
        annotations:
          summary: 'Paperclip is down'
          description: 'Paperclip agent orchestration platform is not responding on its /health endpoint.'

      - alert: BuzzDown
        expr: service_probe_success{service="buzz"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'ai'
          stage: 'relay'
          service: 'buzz'
          severity: 'critical'
        annotations:
          summary: 'Buzz relay is down'
          description: 'Buzz Nostr relay is not responding on its /_liveness endpoint; buzz-agents cannot connect.'

      - alert: JobOpsDown
        expr: service_probe_success{service="jobops"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'apps'
          stage: 'standalone'
          service: 'jobops'
          severity: 'critical'
        annotations:
          summary: 'JobOps is down'
          description: 'JobOps (job application tracker) is not responding on its host port (dtop202311).'
