---
# Prometheus alerting rules for full service-catalog coverage
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Generic rules catch every blackbox probe target that does NOT have a
# dedicated named alert in ai/dns/web/vpn/infra.yml. Any service added to
# services.yml automatically gains a probe and is covered by these rules.

groups:
  - name: catalog_alerts
    rules:
      # Non-pipeline services (databases, UIs, storage, hosts) — warning level.
      # Covers pipeline="none" and pipeline="infra" probe targets.
      - alert: ServiceUnreachable
        expr: probe_success{pipeline=~"none|infra"} == 0
        for: 3m  # project-lint: disable=magic-unitnum  duration
        labels:
          severity: 'warning'
        annotations:
          summary: 'Service {% raw %}{{ $labels.service }}{% endraw %} is unreachable'
          description: 'Service {% raw %}{{ $labels.service }}{% endraw %} on {% raw %}{{ $labels.machine }}{% endraw %} is not responding to blackbox probes.'

      # Media pipeline services (nl/dtop202311) — warning level.
      - alert: MediaServiceUnreachable
        expr: probe_success{pipeline="media"} == 0
        for: 3m  # project-lint: disable=magic-unitnum  duration
        labels:
          severity: 'warning'
        annotations:
          summary: 'Media service {% raw %}{{ $labels.service }}{% endraw %} is unreachable'
          description: 'Media service {% raw %}{{ $labels.service }}{% endraw %} on {% raw %}{{ $labels.machine }}{% endraw %} is not responding to blackbox probes.'

      # Pipeline member services without a dedicated critical alert
      # (e.g. freellmapi, treg, agentmemory, unbound/dnscrypt variants).
      # Named-alerts services are excluded via the service!~ list.
      - alert: PipelineServiceUnreachable
        expr: >-
          probe_success{pipeline=~"ai|dns|web|vpn",
            service!~"omnigent|pi|litellm|headroom|omniroute|forge|iron-proxy|privacy-orchestrator|nordvpn|adguard|dnsdist|coredns|unbound-validator|unbound-tor|unbound-root|dnscrypt-plaintext|dnscrypt-odoh|dnscrypt-anon|tor-proxy|mitm|privoxy|varnish|gost|tor-exit|tailscale|tailscale-mesh|wireguard|host-egress|host-direct"}
          == 0
        for: 3m  # project-lint: disable=magic-unitnum  duration
        labels:
          severity: 'warning'
        annotations:
          summary: 'Pipeline service {% raw %}{{ $labels.service }}{% endraw %} ({% raw %}{{ $labels.pipeline }}{% endraw %}) is unreachable'
          description: 'Pipeline member {% raw %}{{ $labels.service }}{% endraw %} on {% raw %}{{ $labels.machine }}{% endraw %} (stage {% raw %}{{ $labels.stage }}{% endraw %}) is not responding to blackbox probes.'

  # ==========================================================================
  # Coverage gate — fires when a catalog probe target emits NO probe_success
  # series at all (scrape misconfiguration, missing blackbox target, broken
  # relabeling). One rule per service, generated from the catalog.
  # ==========================================================================
  - name: catalog_coverage
    rules:
{% set _seen = namespace(services=[]) %}
{% for p in ((monitoring_service_probes | default([])) + (monitoring_extra_probes | default([]))) | sort(attribute='service') %}
{%   if p.service not in _seen.services %}
{%     set _ = _seen.services.append(p.service) %}
      - alert: ServiceNotMonitored
        expr: absent(probe_success{service="{{ p.service }}"}) == 1
        for: 10m  # project-lint: disable=magic-unitnum  duration
        labels:
          severity: 'critical'
          service: '{{ p.service }}'
        annotations:
          summary: 'Catalog service {{ p.service }} emits no probe metrics'
          description: '{{ p.name }} ({{ p.pipeline }}/{{ p.stage }}, {{ p.machine }}) is in services.yml with a probe target but Prometheus never sees probe_success for it — coverage gap.'
{%   endif %}
{% endfor %}
