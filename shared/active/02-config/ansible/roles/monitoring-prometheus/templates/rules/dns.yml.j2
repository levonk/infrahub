---
# Prometheus alerting rules for the DNS pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Deployed chain (dns role): AdGuard -> dnsdist -> CoreDNS
#   -> {unbound-validator, unbound-tor, unbound-root,
#       dnscrypt-plaintext, dnscrypt-odoh, dnscrypt-anon, tor-proxy}
#   -> upstream resolvers
#
# Signal sources:
#   up{job=...}                 — native /metrics scrapes (dnsdist, coredns)
#   service_probe_success{...}  — per-service synthetic probes (textfile)
#   probe_success{...}          — blackbox probes (monitoring-catalog targets)

groups:
  - name: dns_pipeline_alerts
    rules:
      - alert: AdGuardDown
        expr: service_probe_success{pipeline="dns",service="adguard"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'filter'
          service: 'adguard'
          severity: 'critical'
        annotations:
          summary: 'AdGuard is down'
          description: 'AdGuard DNS filter is not responding to Prometheus scrapes.'

      - alert: DnsdistDown
        expr: up{job="dnsdist"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'router'
          service: 'dnsdist'
          severity: 'critical'
        annotations:
          summary: 'dnsdist is down'
          description: 'dnsdist DNS router is not responding to Prometheus scrapes.'

      - alert: CoreDNSDown
        expr: up{job="coredns"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'resolver'
          service: 'coredns'
          severity: 'critical'
        annotations:
          summary: 'CoreDNS is down'
          description: 'CoreDNS resolver is not responding to Prometheus scrapes.'

      - alert: UnboundDown
        expr: probe_success{service=~"unbound-validator|unbound-tor|unbound-root"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'resolver'
          severity: 'warning'
        annotations:
          summary: 'An Unbound resolver is down'
          description: 'One of the Unbound resolvers (validator/tor/root) is not responding.'

      - alert: DNSCryptDown
        expr: service_probe_success{pipeline="dns",service="dnscrypt"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'proxy'
          service: 'dnscrypt'
          severity: 'critical'
        annotations:
          summary: 'DNSCrypt is down'
          description: 'DNSCrypt proxy is not responding to Prometheus scrapes.'

      - alert: TorDNSDown
        expr: service_probe_success{pipeline="dns",service="tor-dns"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'proxy'
          service: 'tor-dns'
          severity: 'critical'
        annotations:
          summary: 'Tor DNS is down'
          description: 'Tor DNS proxy is not responding to Prometheus scrapes.'

      - alert: DNSPipelineSyntheticProbeFailed
        expr: dns_pipeline_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'synthetic-probe'
          severity: 'critical'
        annotations:
          summary: 'DNS pipeline synthetic probe failed'
          description: 'The DNS pipeline synthetic probe failed to resolve and validate a query end-to-end.'
