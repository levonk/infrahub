---
# Prometheus alerting rules for the DNS pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Deployed chain (dns role): AdGuard -> dnsdist -> CoreDNS
#   -> {unbound-validator, unbound-tor, unbound-root,
#       dnscrypt-plaintext, dnscrypt-odoh, dnscrypt-anon, tor-proxy}
#   -> upstream resolvers

groups:
  - name: dns_pipeline_alerts
    rules:
      - alert: AdGuardDown
        expr: probe_success{service="adguard"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'filter'
          service: 'adguard'
          severity: 'critical'
        annotations:
          summary: 'AdGuard is down'
          description: 'AdGuard DNS filter is not responding to blackbox probes.'

      - alert: DnsdistDown
        expr: (up{job="dnsdist"} == 0) or (probe_success{service="dnsdist"} == 0)
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'router'
          service: 'dnsdist'
          severity: 'critical'
        annotations:
          summary: 'dnsdist is down'
          description: 'dnsdist DNS router is not responding to scrapes/probes.'

      - alert: CoreDNSDown
        expr: (up{job="coredns"} == 0) or (probe_success{service="coredns"} == 0)
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'resolver'
          service: 'coredns'
          severity: 'critical'
        annotations:
          summary: 'CoreDNS is down'
          description: 'CoreDNS resolver is not responding to scrapes/probes.'

      - alert: UnboundDown
        expr: probe_success{service=~"unbound-validator|unbound-tor|unbound-root"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'resolver'
          severity: 'warning'
        annotations:
          summary: 'An Unbound resolver is down'
          description: 'One of the Unbound resolvers (validator/tor/root) is not responding.'

      - alert: DNSCryptDown
        expr: probe_success{service=~"dnscrypt-plaintext|dnscrypt-odoh|dnscrypt-anon"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'anonymity'
          severity: 'warning'
        annotations:
          summary: 'A DNSCrypt resolver is down'
          description: 'One of the DNSCrypt proxies (plaintext/odoh/anon) is not responding.'

      - alert: TorDNSDown
        expr: probe_success{service="tor-proxy"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'anonymity'
          service: 'tor-proxy'
          severity: 'critical'
        annotations:
          summary: 'Tor DNS proxy is down'
          description: 'The DNS-chain Tor proxy is not responding to blackbox probes.'

      - alert: DNSPipelineSyntheticProbeFailed
        expr: dns_pipeline_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'synthetic-probe'
          severity: 'critical'
        annotations:
          summary: 'DNS pipeline synthetic probe failed'
          description: 'The DNS pipeline synthetic probe failed to resolve and validate a query end-to-end.'
