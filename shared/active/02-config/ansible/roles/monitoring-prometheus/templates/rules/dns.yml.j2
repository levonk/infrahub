---
# Prometheus alerting rules for the DNS pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY

groups:
  - name: dns_pipeline_alerts
    rules:
      - alert: AdGuardDown
        expr: up{job="adguard"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'filter'
          service: 'adguard'
          severity: 'critical'
        annotations:
          summary: 'AdGuard is down'
          description: 'AdGuard DNS filter is not responding to Prometheus scrapes.'

      - alert: DnsdistDown
        expr: up{job="dnsdist"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'router'
          service: 'dnsdist'
          severity: 'critical'
        annotations:
          summary: 'dnsdist is down'
          description: 'dnsdist DNS router is not responding to Prometheus scrapes.'

      - alert: CoreDNSDown
        expr: up{job="coredns"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'resolver'
          service: 'coredns'
          severity: 'critical'
        annotations:
          summary: 'CoreDNS is down'
          description: 'CoreDNS resolver is not responding to Prometheus scrapes.'

      - alert: DNSCryptDown
        expr: up{job="dnscrypt"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'proxy'
          service: 'dnscrypt'
          severity: 'critical'
        annotations:
          summary: 'DNSCrypt is down'
          description: 'DNSCrypt proxy is not responding to Prometheus scrapes.'

      - alert: TorDNSDown
        expr: up{job="tor-dns"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'proxy'
          service: 'tor-dns'
          severity: 'critical'
        annotations:
          summary: 'Tor DNS is down'
          description: 'Tor DNS proxy is not responding to Prometheus scrapes.'

      - alert: DNSSyntheticProbeFailed
        expr: dns_pipeline_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'dns'
          stage: 'synthetic-probe'
          severity: 'critical'
        annotations:
          summary: 'DNS pipeline synthetic probe failed'
          description: 'The DNS pipeline synthetic probe failed to resolve and validate a query end-to-end.'
