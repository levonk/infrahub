---
# Prometheus alerting rules for infrastructure services (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Covers the monitoring stack itself (self-monitoring) plus ingress/auth/security.

groups:
  - name: infrastructure_alerts
    rules:
      - alert: PrometheusDown
        expr: up{job="prometheus"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'prometheus'
          severity: 'critical'
        annotations:
          summary: 'Prometheus is down'
          description: 'Prometheus monitoring service is not responding to scrapes.'

      - alert: GrafanaDown
        expr: (up{job="grafana"} == 0) or (probe_success{service="grafana"} == 0)
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'grafana'
          severity: 'warning'
        annotations:
          summary: 'Grafana is down'
          description: 'Grafana visualization service is not responding to scrapes/probes.'

      - alert: AlertmanagerDown
        expr: up{job="alertmanager"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'alertmanager'
          severity: 'critical'
        annotations:
          summary: 'Alertmanager is down'
          description: 'Alertmanager notification service is not responding to scrapes.'

      - alert: UptimeKumaDown
        expr: (up{job="uptime-kuma"} == 0) or (probe_success{service="uptime-kuma"} == 0)
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'uptime-kuma'
          severity: 'warning'
        annotations:
          summary: 'Uptime Kuma is down'
          description: 'Uptime Kuma monitoring service is not responding to scrapes/probes.'

      - alert: LokiDown
        expr: up{job="loki"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'loki'
          severity: 'critical'
        annotations:
          summary: 'Loki is down'
          description: 'Loki log aggregation service is not responding to scrapes.'

      - alert: PromtailDown
        expr: up{job="promtail"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'promtail'
          severity: 'warning'
        annotations:
          summary: 'Promtail is down'
          description: 'Promtail log collector is not responding to scrapes.'

      - alert: BlackboxDown
        expr: up{job="blackbox"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'blackbox'
          severity: 'critical'
        annotations:
          summary: 'Blackbox exporter is down'
          description: 'All probe_success signals stop when blackbox_exporter is down.'

      - alert: NodeExporterDown
        expr: up{job="node_exporter"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'node-exporter'
          severity: 'critical'
        annotations:
          summary: 'Node exporter is down'
          description: 'Node exporter is not responding; host metrics and synthetic probe metrics are lost.'

      - alert: TraefikDown
        expr: up{job="traefik"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'ingress'
          service: 'traefik'
          severity: 'critical'
        annotations:
          summary: 'Traefik is down'
          description: 'Traefik reverse proxy is not responding to scrapes.'

      - alert: AutheliaDown
        expr: up{job="authelia"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'auth'
          service: 'authelia'
          severity: 'critical'
        annotations:
          summary: 'Authelia is down'
          description: 'Authelia authentication service is not responding to scrapes.'

      - alert: CrowdSecDown
        expr: up{job="crowdsec"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'security'
          service: 'crowdsec'
          severity: 'warning'
        annotations:
          summary: 'CrowdSec is down'
          description: 'CrowdSec security engine is not responding to scrapes.'

      - alert: SyntheticProbeFileStale
        expr: (time() - node_textfile_mtime_seconds{file=~".*(ai|dns|web|vpn)_.*probe.*\\.prom"}) > {{ monitoring_probe_stale_seconds | default(300) }}  # project-lint: disable=magic-int  staleness window
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'synthetic-probe'
          severity: 'warning'
        annotations:
          summary: 'Synthetic probe metrics are stale'
          description: 'Synthetic probe has not written fresh metrics for more than {{ monitoring_probe_stale_seconds | default(300) }}s.'  # project-lint: disable=magic-int  staleness window
