---
# Prometheus alerting rules for the infrastructure pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Covers the monitoring stack itself (self-monitoring) plus ingress/auth/security.
#
# Signal sources:
#   up{job=...}                 — native /metrics scrapes
#   service_probe_success{...}  — per-service synthetic probes (textfile)
#   node_textfile_mtime_seconds — synthetic probe freshness

groups:
  - name: infra_pipeline_alerts
    rules:
      - alert: TraefikDown
        expr: up{job="traefik"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'ingress'
          service: 'traefik'
          severity: 'critical'
        annotations:
          summary: 'Traefik is down'
          description: 'Traefik ingress proxy is not responding to Prometheus scrapes.'

      - alert: AutheliaDown
        expr: up{job="authelia"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'auth'
          service: 'authelia'
          severity: 'critical'
        annotations:
          summary: 'Authelia is down'
          description: 'Authelia SSO is not responding to Prometheus scrapes.'

      - alert: CrowdSecDown
        expr: up{job="crowdsec"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'security'
          service: 'crowdsec'
          severity: 'critical'
        annotations:
          summary: 'CrowdSec is down'
          description: 'CrowdSec security service is not responding to Prometheus scrapes.'

      - alert: PrometheusDown
        expr: up{job="prometheus"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'prometheus'
          severity: 'critical'
        annotations:
          summary: 'Prometheus is down'
          description: 'Prometheus is not responding to its own scrape target.'

      - alert: LokiDown
        expr: up{job="loki"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'loki'
          severity: 'critical'
        annotations:
          summary: 'Loki is down'
          description: 'Loki log aggregation is not responding to Prometheus scrapes.'

      - alert: PromtailDown
        expr: up{job="promtail"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'promtail'
          severity: 'warning'
        annotations:
          summary: 'Promtail is down'
          description: 'Promtail log collector is not responding to scrapes.'

      - alert: BlackboxDown
        expr: up{job="blackbox"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'blackbox'
          severity: 'critical'
        annotations:
          summary: 'Blackbox exporter is down'
          description: 'All probe_success signals stop when blackbox_exporter is down.'

      - alert: GrafanaDown
        expr: up{job="grafana"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'grafana'
          severity: 'critical'
        annotations:
          summary: 'Grafana is down'
          description: 'Grafana visualization is not responding to Prometheus scrapes.'

      - alert: AlertmanagerDown
        expr: up{job="alertmanager"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'alertmanager'
          severity: 'critical'
        annotations:
          summary: 'Alertmanager is down'
          description: 'Alertmanager is not responding to Prometheus scrapes.'

      - alert: UptimeKumaDown
        expr: service_probe_success{pipeline="infra",service="uptime-kuma"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'monitoring'
          service: 'uptime-kuma'
          severity: 'critical'
        annotations:
          summary: 'Uptime Kuma is down'
          description: 'Uptime Kuma is not responding to Prometheus scrapes.'

      - alert: NodeExporterDown
        expr: up{job="node_exporter"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'host'
          service: 'node-exporter'
          severity: 'warning'
        annotations:
          summary: 'Node exporter is down'
          description: 'node_exporter host metrics agent is not responding; host metrics and synthetic probe metrics are lost.'

      - alert: SyntheticProbeFileStale
        expr: (time() - node_textfile_mtime_seconds{file=~".*/probes/.*"}) > {{ monitoring_probe_stale_seconds | default(600) }}  # project-lint: disable=magic-int  stale threshold seconds
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'infra'
          stage: 'synthetic-probe'
          severity: 'warning'
        annotations:
          summary: 'Synthetic probe textfile is stale'
          description: 'A node_exporter textfile probe has not been updated for more than {{ monitoring_probe_stale_seconds | default(600) }}s.'
