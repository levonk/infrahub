---
# Prometheus alerting rules for the Media pipeline (ADR-202608270001 §2)
# Media services run on dtop202311 (Windows Docker host); liveness is measured
# by the synthetic-probes container via host ports over the tailnet.
# Generated by Ansible — DO NOT EDIT MANUALLY

groups:
  - name: media_pipeline_alerts
    rules:
      - alert: JellyfinDown
        expr: service_probe_success{pipeline="media",service="jellyfin"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'media'
          stage: 'streaming'
          service: 'jellyfin'
          severity: 'critical'
        annotations:
          summary: 'Jellyfin is down'
          description: 'Jellyfin media server is not responding on its /health endpoint (dtop202311).'

      - alert: RadarrDown
        expr: service_probe_success{pipeline="media",service="radarr"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'media'
          stage: 'manager'
          service: 'radarr'
          severity: 'critical'
        annotations:
          summary: 'Radarr is down'
          description: 'Radarr movie manager is not responding on its /ping endpoint (dtop202311).'

      - alert: SonarrDown
        expr: service_probe_success{pipeline="media",service="sonarr"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'media'
          stage: 'manager'
          service: 'sonarr'
          severity: 'critical'
        annotations:
          summary: 'Sonarr is down'
          description: 'Sonarr TV manager is not responding on its /ping endpoint (dtop202311).'

      - alert: QBittorrentDown
        expr: service_probe_success{pipeline="media",service="qbittorrent"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'media'
          stage: 'download'
          service: 'qbittorrent'
          severity: 'critical'
        annotations:
          summary: 'qBittorrent is down'
          description: 'qBittorrent web UI is not responding via its Traefik domain (VPN-routed on dtop202311).'
