---
# Prometheus alerting rules for the VPN/egress pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY

groups:
  - name: vpn_pipeline_alerts
    rules:
      - alert: NordVPNDown
        expr: up{job="nordvpn", pipeline="vpn"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'egress'
          service: 'nordvpn'
          severity: 'critical'
        annotations:
          summary: 'NordVPN is down'
          description: 'NordVPN egress is not responding to Prometheus scrapes.'

      - alert: WireGuardDown
        expr: up{job="wireguard"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'egress'
          service: 'wireguard'
          severity: 'critical'
        annotations:
          summary: 'WireGuard is down'
          description: 'WireGuard egress is not responding to Prometheus scrapes.'

      - alert: TorEgressDown
        expr: up{job="tor-egress"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'egress'
          service: 'tor'
          severity: 'critical'
        annotations:
          summary: 'Tor egress is down'
          description: 'Tor egress is not responding to Prometheus scrapes.'

      - alert: VPNSyntheticProbeFailed
        expr: vpn_egress_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'synthetic-probe'
          severity: 'critical'
        annotations:
          summary: 'VPN egress synthetic probe failed'
          description: 'The VPN egress synthetic probe failed to verify outbound connectivity.'
