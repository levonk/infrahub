---
# Prometheus alerting rules for the VPN/egress pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Signal sources:
#   service_probe_success{...} — per-service synthetic probes (textfile)
#   probe_success{...}         — blackbox probes (monitoring_extra_probes:
#                                tailscale-mesh, host-egress host/network checks)

groups:
  - name: vpn_pipeline_alerts
    rules:
      - alert: TailscaleDown
        expr: probe_success{service="tailscale-mesh"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'mesh'
          service: 'tailscale'
          severity: 'critical'
        annotations:
          summary: 'Tailscale mesh is down'
          description: 'Tailscale on the cloud server is unreachable; all cross-cluster traffic fails.'

      - alert: NordVPNDown
        expr: service_probe_success{pipeline="vpn",service="nordvpn"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'egress'
          service: 'nordvpn'
          severity: 'critical'
        annotations:
          summary: 'NordVPN is down'
          description: 'NordVPN egress is not responding to Prometheus scrapes.'

      - alert: TorEgressDown
        expr: service_probe_success{pipeline="vpn",service="tor-egress"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'egress'
          service: 'tor'
          severity: 'critical'
        annotations:
          summary: 'Tor egress is down'
          description: 'Tor egress is not responding to Prometheus scrapes.'

      - alert: HostEgressDown
        expr: probe_success{service="host-egress"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'egress-host'
          service: 'host-direct'
          severity: 'critical'
        annotations:
          summary: 'Host internet egress is down'
          description: 'The cloud server cannot reach the internet directly.'

      - alert: VPNEgressSyntheticProbeFailed
        expr: vpn_egress_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'vpn'
          stage: 'synthetic-probe'
          severity: 'critical'
        annotations:
          summary: 'VPN egress synthetic probe failed'
          description: 'The VPN egress synthetic probe failed to verify outbound connectivity.'
