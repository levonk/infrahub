---
# Prometheus alerting rules for the Web proxy pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Chain: MITM Proxy -> Privoxy -> Varnish -> Gost -> {Direct, tor-proxy}

groups:
  - name: web_pipeline_alerts
    rules:
      - alert: MITMDown
        expr: probe_success{service="mitm"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'interception'
          service: 'mitm'
          severity: 'critical'
        annotations:
          summary: 'MITM proxy is down'
          description: 'MITM interception proxy is not responding to blackbox probes.'

      - alert: PrivoxyDown
        expr: probe_success{service="privoxy"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'filtering'
          service: 'privoxy'
          severity: 'critical'
        annotations:
          summary: 'Privoxy is down'
          description: 'Privoxy filtering proxy is not responding to blackbox probes.'

      - alert: VarnishDown
        expr: probe_success{service="varnish"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'cache'
          service: 'varnish'
          severity: 'critical'
        annotations:
          summary: 'Varnish is down'
          description: 'Varnish cache is not responding to blackbox probes.'

      - alert: GostDown
        expr: probe_success{service="gost"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'egress'
          service: 'gost'
          severity: 'critical'
        annotations:
          summary: 'Gost is down'
          description: 'Gost egress proxy is not responding to blackbox probes.'

      - alert: TorWebDown
        expr: probe_success{service="tor-proxy"} == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'egress'
          service: 'tor-proxy'
          severity: 'warning'
        annotations:
          summary: 'Tor web egress is down'
          description: 'Tor egress for the web proxy chain is down; Gost falls back to direct.'

      - alert: WebPipelineSyntheticProbeFailed
        expr: web_pipeline_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'synthetic-probe'
          severity: 'critical'
        annotations:
          summary: 'Web pipeline synthetic probe failed'
          description: 'The web proxy pipeline synthetic probe failed to complete an end-to-end request.'
