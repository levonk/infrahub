---
# Prometheus alerting rules for the Web proxy pipeline (ADR-202608270001 §2)
# Generated by Ansible — DO NOT EDIT MANUALLY

groups:
  - name: web_pipeline_alerts
    rules:
      - alert: MITMDown
        expr: up{job="mitm"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'interception'
          service: 'mitm'
          severity: 'critical'
        annotations:
          summary: 'MITM proxy is down'
          description: 'MITM interception proxy is not responding to Prometheus scrapes.'

      - alert: PrivoxyDown
        expr: up{job="privoxy"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'filtering'
          service: 'privoxy'
          severity: 'critical'
        annotations:
          summary: 'Privoxy is down'
          description: 'Privoxy filtering proxy is not responding to Prometheus scrapes.'

      - alert: VarnishDown
        expr: up{job="varnish"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'cache'
          service: 'varnish'
          severity: 'critical'
        annotations:
          summary: 'Varnish is down'
          description: 'Varnish cache is not responding to Prometheus scrapes.'

      - alert: GostDown
        expr: up{job="gost"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'egress'
          service: 'gost'
          severity: 'critical'
        annotations:
          summary: 'Gost is down'
          description: 'Gost egress proxy is not responding to Prometheus scrapes.'

      - alert: TorWebDown
        expr: up{job="tor-web"} == 0
        for: 1m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'egress'
          service: 'tor'
          severity: 'critical'
        annotations:
          summary: 'Tor web egress is down'
          description: 'Tor web egress is not responding to Prometheus scrapes.'

      - alert: WebPipelineSyntheticProbeFailed
        expr: web_pipeline_probe_success == 0
        for: 2m  # project-lint: disable=magic-unitnum  duration
        labels:
          pipeline: 'web'
          stage: 'synthetic-probe'
          severity: 'critical'
        annotations:
          summary: 'Web pipeline synthetic probe failed'
          description: 'The web proxy pipeline synthetic probe failed to complete an end-to-end request.'
