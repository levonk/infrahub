# Managed by Ansible (net-openwrt role) — manual edits will be overwritten.
# Router mode only. All WAN interfaces share the 'wan' zone — mwan3 picks
# the egress member via policy routing before NAT.

config defaults
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option synflood_protect '1'
	option drop_invalid '1'

config zone 'lan'
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	list network 'lan'
{% if 'tailscale' in openwrt_packages %}
	list network 'tailscale0'
{% endif %}
{% for iface in openwrt_extra_interfaces %}
{% if (iface.zone | default('lan')) == 'lan' %}
	list network '{{ iface.name }}'
{% endif %}
{% endfor %}

config zone 'wan'
	option name 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
{% for wan in openwrt_wan_interfaces %}
	list network '{{ wan.name }}'
{% endfor %}

config forwarding
	option src 'lan'
	option dest 'wan'
{% set seg_zones = openwrt_extra_interfaces
    | selectattr('zone', 'defined')
    | rejectattr('zone', 'equalto', 'lan')
    | map(attribute='zone') | unique | list %}
{% for z in seg_zones %}

config zone '{{ z }}'
	option name '{{ z }}'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
{% for iface in openwrt_extra_interfaces %}
{% if iface.zone | default('lan') == z %}
	list network '{{ iface.name }}'
{% endif %}
{% endfor %}

# Isolated segment: Internet-only. lan may initiate INTO the segment
# (management), but the segment cannot initiate back to lan.
config forwarding
	option src '{{ z }}'
	option dest 'wan'

config forwarding
	option src 'lan'
	option dest '{{ z }}'

# Zone input is REJECT — punch holes only for DHCP + DNS to the router.
config rule
	option name 'Allow-DHCP-{{ z }}'
	option src '{{ z }}'
	option proto 'udp'
	option dest_port '67'
	option target 'ACCEPT'
	option family 'ipv4'

config rule
	option name 'Allow-DNS-{{ z }}'
	option src '{{ z }}'
	list proto 'tcp'
	list proto 'udp'
	option dest_port '53'
	option target 'ACCEPT'
	option family 'ipv4'
{% endfor %}

config rule
	option name 'Allow-DHCP-Renew'
	option src 'wan'
	option proto 'udp'
	option dest_port '68'
	option target 'ACCEPT'
	option family 'ipv4'

config rule
	option name 'Allow-Ping'
	option src 'wan'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option family 'ipv4'
	option target 'ACCEPT'

config include
	option path '/etc/firewall.user'
	option type 'script'
	option reload '1'
	option fw4_compatible '1'
