# Managed by Ansible (net-openwrt role) — manual edits will be overwritten.

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00:0:0:1::/64'

config device
	option name '{{ openwrt_lan_device }}'
	option type 'bridge'
{% for port in openwrt_lan_ports %}
	list ports '{{ port }}'
{% endfor %}

config interface 'lan'
	option device '{{ openwrt_lan_device }}'
	option proto '{{ openwrt_lan_proto }}'
{% if openwrt_lan_proto == 'static' %}
	option ipaddr '{{ openwrt_lan_ipaddr }}'
	option netmask '{{ openwrt_lan_netmask }}'
{% if openwrt_mode == 'ap' %}
	option gateway '{{ openwrt_lan_gateway }}'
{% for dns in openwrt_lan_dns %}
	list dns '{{ dns }}'
{% endfor %}
{% endif %}
{% endif %}
{% for iface in openwrt_extra_interfaces %}

config device
	option name 'br-{{ iface.name }}'
	option type 'bridge'
{% for port in iface.ports | default([]) %}
	list ports '{{ port }}'
{% endfor %}

config interface '{{ iface.name }}'
	option device 'br-{{ iface.name }}'
	option proto 'static'
	option ipaddr '{{ iface.ipaddr }}'
	option netmask '{{ iface.netmask | default('255.255.255.0') }}'
{% endfor %}
{% if openwrt_mode == 'router' %}
{% for wan in openwrt_wan_interfaces %}

config interface '{{ wan.name }}'
	option proto '{{ wan.proto | default('dhcp') }}'
	option device '{{ wan.device | default(openwrt_wan_port) }}'
	option metric '{{ wan.metric | default(loop.index * 10) }}'
{% if (wan.proto | default('dhcp')) == 'static' %}
	option ipaddr '{{ wan.ipaddr }}'
	option netmask '{{ wan.netmask | default('255.255.255.0') }}'
	option gateway '{{ wan.gateway }}'
{% endif %}
{% if wan.peerdns is defined %}
	option peerdns '{{ wan.peerdns }}'
{% endif %}
{% for dns in wan.dns | default([]) %}
	list dns '{{ dns }}'
{% endfor %}
{% endfor %}
{% endif %}
