# Managed by Ansible (net-openwrt role) — manual edits will be overwritten.

config system
	option hostname '{{ openwrt_hostname }}'
	option timezone '{{ openwrt_timezone }}'
	option zonename '{{ openwrt_zonename }}'
	option ttylogin '0'
	option log_size '{{ openwrt_log_size | default('64') }}'
	option urandom_seed '0'
{% if openwrt_log_file | default('') != '' %}
	option log_type 'file'
	option log_file '{{ openwrt_log_file }}'
{% endif %}

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'
