# Cloudflare Tunnel ingress configuration
# Generated by Ansible — DO NOT EDIT MANUALLY
# Only hostnames listed below are publicly accessible through the tunnel.
# All other hostnames get a 404 (catch-all rule at the bottom).
# The tunnel token is passed via the TUNNEL_TOKEN env var, not this file.

ingress:
{% for rule in cloudflared_ingress_rules %}
{% if rule.hostname is defined %}
  - hostname: {{ rule.hostname }}
    service: {{ rule.service }}
{% if rule.path is defined %}
    path: {{ rule.path }}
{% endif %}
{% else %}
  - service: {{ rule.service }}
{% endif %}
{% endfor %}
