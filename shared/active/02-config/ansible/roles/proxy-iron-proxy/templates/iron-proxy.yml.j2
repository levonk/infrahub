---
# iron-proxy configuration
# This file controls DNS interception, TLS termination, and allowlist rules
# Generated by Ansible - DO NOT EDIT MANUALLY

# DNS server configuration
dns:
  enabled: {{ proxy_iron_proxy_dns_enabled | ternary('true', 'false') }}
  listen: ":{{ proxy_iron_proxy_dns_container_port }}"
  # The IP address returned for intercepted DNS queries
  proxy_ip: "{{ proxy_iron_proxy_dns_proxy_ip }}"
  # Optional upstream DNS resolver for the proxy's own lookups
  upstream_resolver: "{{ proxy_iron_proxy_upstream_dns }}"
  # Domains to pass through to the OS resolver (everything else resolves to proxy_ip)
  passthrough:
    - "*.internal.corp"
    - "metadata.google.internal"
    - "metadata.oracle.internal"
  # Static DNS records (take precedence over interception and passthrough)
  records:
    - name: "internal.example.com"
      type: A
      value: "10.0.0.5"

# Proxy listener configuration
proxy:
  http_listen: ":{{ proxy_iron_proxy_http_container_port }}"
  https_listen: ":{{ proxy_iron_proxy_https_container_port }}"
  # Global body buffer limits for transforms
  max_request_body_bytes: {{ proxy_iron_proxy_max_request_body_bytes }}
  max_response_body_bytes: {{ proxy_iron_proxy_max_response_body_bytes }}
  # Cap on how long the proxy waits for upstream response headers
  upstream_response_header_timeout: "{{ proxy_iron_proxy_upstream_timeout }}"
  
  # CIDRs the proxy refuses to dial upstream (prevents DNS rebinding and IMDS access)
  upstream_deny_cidrs:
    - "169.254.169.254/32"   # AWS / GCP / Azure IPv4 IMDS
    - "fd00:ec2::254/128"    # AWS IPv6 IMDS
    - "127.0.0.0/8"          # IPv4 loopback
    - "::1/128"              # IPv6 loopback

# TLS / MITM configuration
tls:
  mode: "{{ proxy_iron_proxy_tls_mode }}"
  ca_cert: "/etc/iron-proxy/ca.crt"
  ca_key: "/etc/iron-proxy/ca.key"
  cert_cache_size: {{ proxy_iron_proxy_cert_cache_size }}
  leaf_cert_expiry_hours: {{ proxy_iron_proxy_leaf_cert_expiry_hours }}

# Transform configuration
transforms:
  # Allowlist transform - controls which domains/CIDRs are accessible
  - name: allowlist
    config:
      # When true, log requests that would be blocked but allow them through
      warn: {{ proxy_iron_proxy_allowlist_warn | ternary('true', 'false') }}
      # Simple form: allow all methods and paths to these hosts
      domains:
{% for domain in proxy_iron_proxy_allowed_domains %}
        - "{{ domain }}"
{% endfor %}
      cidrs:
{% for cidr in proxy_iron_proxy_allowed_cidrs %}
        - "{{ cidr }}"
{% endfor %}
      # Rule form: restrict by method and/or path
      rules:
{% for rule in proxy_iron_proxy_allowlist_rules %}
        - host: "{{ rule.host }}"
          methods: {{ rule.methods | to_json }}
          paths: {{ rule.paths | to_json }}
{% endfor %}

  # Secrets transform - injects or replaces API keys
  - name: secrets
    config:
      secrets:
{% if proxy_iron_proxy_openai_enabled %}
        # OpenAI API key injection
        - source:
            type: env
            var: OPENAI_API_KEY
          inject:
            header: "Authorization"
            formatter: "Bearer {% raw %}{{ .Value }}{% endraw %}"
          rules:
            - host: "api.openai.com"
              methods: ["POST"]
              paths: ["/v1/*"]
{% endif %}

{% if proxy_iron_proxy_anthropic_enabled %}
        # Anthropic API key replacement
        - source:
            type: env
            var: ANTHROPIC_API_KEY
          replace:
            proxy_value: "{{ proxy_iron_proxy_anthropic_proxy_token }}"
            match_headers: ["X-Api-Key"]
            require: true
          rules:
            - host: "*.anthropic.com"
              methods: ["POST"]
              paths: ["/v1/messages", "/v1/complete"]
{% endif %}

{% if proxy_iron_proxy_google_enabled %}
        # Google API key injection
        - source:
            type: env
            var: GOOGLE_API_KEY
          inject:
            query_param: "key"
          rules:
            - host: "*.googleapis.com"
{% endif %}

{% if proxy_iron_proxy_github_enabled %}
        # GitHub token injection
        - source:
            type: env
            var: GITHUB_TOKEN
          inject:
            header: "Authorization"
            formatter: 'Basic {% raw %}{{ base64 "x-credential:" .Value }}{% endraw %}'
          rules:
            - host: "api.github.com"
{% endif %}
