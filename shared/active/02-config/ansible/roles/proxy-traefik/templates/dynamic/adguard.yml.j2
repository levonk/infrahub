# Traefik Dynamic Configuration - AdGuard Home Web UI Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_dns_adguard }}
#
# CROSS-MACHINE ROUTING: AdGuard Home runs on the Windows Docker host (dtop202311),
# NOT on the OCI cloud server where Traefik runs. Traefik routes to the
# Windows machine's Tailscale FQDN + host port via Tailscale.
#
# Security: AdGuard Home web UI is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    adguard-http:
      rule: "Host(`{{ infra_domain_dns_adguard }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: adguard

    # HTTPS behind Authelia SSO
    adguard-https:
      rule: "Host(`{{ infra_domain_dns_adguard }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: adguard
      tls:
        certResolver: letsencrypt

  services:
    adguard:
      loadBalancer:
        servers:
          - url: "http://{{ infra_tailscale_fqdn_windows_docker | default('dtop202311.' ~ (infra_tailscale_tailnet | default('example.ts.net'))) }}:{{ infra_port_dns_adguard_web_host | default(infra_port_monitoring_grafana_host) }}"
        passHostHeader: true
