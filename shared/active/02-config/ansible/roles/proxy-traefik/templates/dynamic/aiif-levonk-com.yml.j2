# Traefik Dynamic Configuration - AI InterFace (Omnigent) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ aiif_domain | default('aiif.levonk.com') }}
# Public alias "AI InterFace" for the Omnigent agent framework & meta-harness.
# Container name stays "omnigent" (see aigate pattern: LiteLLM container → aigate.levonk.com).
# Security Chain: Authelia (SSO with 2FA)
# NOTE: Docker provider is disabled in Traefik v3.0; routing is via file provider.
#       The Docker labels on the omnigent container are ignored — this file is
#       the single source of truth for the router. See ADR-20260629001.
#       Uses container name (not hardcoded IP) so it survives container recreation.
#       geoblock/crowdsec-bouncer omitted — disabled by default (proxy_traefik_crowdsec_enabled=false,
#       proxy_traefik_geoblock_enabled=false). Re-enable conditionally when those features are turned on.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    omnigent-http:
      rule: "Host(`{{ aiif_domain | default('aiif.levonk.com') }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: omnigent

    # HTTPS router with Authelia middleware
    omnigent-https:
      rule: "Host(`{{ aiif_domain | default('aiif.levonk.com') }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: omnigent
      tls:
        certResolver: letsencrypt

    # API routes bypass Authelia — Omnigent has its own auth (accounts mode
    # with JWT session cookie or bearer token). Without this bypass, the
    # `omni` CLI (login, host registration, query) gets 302 redirects to
    # Authelia instead of JSON responses, breaking headless runner registration.
    # Omnigent's API lives under /v1/ (sessions, hosts, runners, tunnel) and
    # /auth/ (login, setup, users) — NOT /api/. The /health endpoint is also
    # bypassed so the Docker healthcheck and external monitors work.
    # Same pattern as the airoute-levonk-com API bypass.
    omnigent-https-api:
      rule: "Host(`{{ aiif_domain | default('aiif.levonk.com') }}`) && (PathPrefix(`/v1/`) || PathPrefix(`/auth/`) || Path(`/health`))"
      entryPoints:
        - websecure
      service: omnigent
      tls:
        certResolver: letsencrypt
      priority: 100

  services:
    omnigent:
      loadBalancer:
        servers:
          - url: "http://{{ aiif_container_name | default('omnigent') }}:{{ aiif_container_port | default('8000') }}"
        passHostHeader: true
