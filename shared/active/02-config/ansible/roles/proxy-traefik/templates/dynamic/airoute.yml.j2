# Traefik Dynamic Configuration - OmniRoute AI Gateway Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ ai_omniroute_domain }}
# Purpose: OmniRoute AI Gateway (tier fallback, 9-factor scoring, free-tier draining)
# Security Chain: Authelia
# NOTE: Docker provider is disabled in Traefik v3.0; routing is via file provider.
#       The Docker labels on the omniroute container are ignored — this file is
#       the single source of truth for the router. See ADR-20260629001.
#       Uses container name (not hardcoded IP) so it survives container recreation.

http:
  routers:
    omniroute-http:
      rule: "Host(`{{ ai_omniroute_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: omniroute

    omniroute-https:
      rule: "Host(`{{ ai_omniroute_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: omniroute
      tls:
        certResolver: letsencrypt

    # API routes bypass Authelia — OmniRoute has its own auth (JWT session
    # cookie, CLI token, or bearer API key with manage scope). Without this,
    # expired Authelia sessions cause the dashboard's fetch() calls to get
    # 302 redirects instead of JSON, breaking the UI silently.
    omniroute-https-api:
      rule: "Host(`{{ ai_omniroute_domain }}`) && PathPrefix(`/api/`)"
      entryPoints:
        - websecure
      service: omniroute
      tls:
        certResolver: letsencrypt
      priority: 100  # project-lint: disable=magic-int  nftables chain priority, not a standalone magic number

  services:
    omniroute:
      loadBalancer:
        servers:
          - url: "http://{{ ai_omniroute_container_name | default('localnet-ai-omniroute') }}:{{ ai_omniroute_container_port | default(infra_port_vpn_netbird_management_host) }}"
        passHostHeader: true
