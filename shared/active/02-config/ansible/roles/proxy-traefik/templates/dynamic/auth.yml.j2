# Traefik Dynamic Configuration - Authelia Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_sso_authelia }}
# Purpose: Authelia SSO service

http:
  routers:
    # HTTP router (redirects to HTTPS)
    authelia-http:
      rule: "Host(`{{ infra_domain_sso_authelia }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: authelia

    # HTTPS router
    authelia-https:
      rule: "Host(`{{ infra_domain_sso_authelia }}`)"
      entryPoints:
        - websecure
      service: authelia
      tls:
        certResolver: letsencrypt

  services:
    authelia:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_authelia_container_name | default('proxy-authelia') }}:{{ proxy_authelia_web_container_port | default('9091') }}"  # project-lint: disable=magic-int  Jinja default port value, should use infra_port variable
        passHostHeader: true