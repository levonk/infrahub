# Traefik Dynamic Configuration - Buzz AI Collaboration Workspace
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ ai_buzz_domain }}
# Purpose: Buzz Nostr relay / human + AI agent collaboration workspace
# NOTE: Docker provider is disabled in Traefik v3.0; routing is via file provider.
#       Uses container name (not hardcoded IP) so it survives container recreation.

http:
  routers:
    # === WebSocket relay + web UI (SSO via Authelia) ===
    buzz-http:
      rule: "Host(`{{ ai_buzz_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: buzz

    buzz-https:
      rule: "Host(`{{ ai_buzz_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: buzz
      tls:
        certResolver: letsencrypt

  services:
    buzz:
      loadBalancer:
        servers:
          - url: "http://{{ ai_buzz_container_name | default('buzz') }}:{{ ai_buzz_container_port | default(infra_port_monitoring_grafana_host) }}"
        passHostHeader: true
