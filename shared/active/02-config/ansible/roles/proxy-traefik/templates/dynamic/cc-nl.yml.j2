# Traefik Dynamic Configuration - Control Center Dashboard (NL domain)
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_dashboard_control_center_nl }}
#
# CROSS-MACHINE ROUTING: Control Center runs on the Windows Docker host (dtop202311),
# NOT on the OCI cloud server where Traefik runs. Traefik routes to the
# Windows machine's Tailscale FQDN + host port via Tailscale.
#
# Security: Control Center web UI is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    control-center-nl-http:
      rule: "Host(`{{ infra_domain_dashboard_control_center_nl }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: control-center-nl

    # HTTPS behind Authelia SSO
    control-center-nl-https:
      rule: "Host(`{{ infra_domain_dashboard_control_center_nl }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: control-center-nl
      tls:
        certResolver: letsencrypt

  services:
    control-center-nl:
      loadBalancer:
        servers:
          - url: "http://{{ infra_tailscale_fqdn_windows_docker | default('dtop202311.' ~ (infra_tailscale_tailnet | default('example.ts.net'))) }}:{{ infra_port_dashboard_control_center_host | default('4537') }}"  # project-lint: disable=magic-int  fallback port for control-center
        passHostHeader: true
