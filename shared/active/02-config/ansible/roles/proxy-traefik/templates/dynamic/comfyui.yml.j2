# Traefik Dynamic Configuration - ComfyUI Web UI Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_ai_comfyui }}
#
# CROSS-MACHINE ROUTING: ComfyUI runs natively on the kckinai inference host
# (NVIDIA GB10), NOT on the OCI cloud server where Traefik runs. Traefik routes
# to kckinai's Tailscale FQDN + host port via Tailscale.
#
# Security: ComfyUI web UI is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    comfyui-http:
      rule: "Host(`{{ infra_domain_ai_comfyui }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: comfyui

    # HTTPS behind Authelia SSO
    comfyui-https:
      rule: "Host(`{{ infra_domain_ai_comfyui }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: comfyui
      tls:
        certResolver: letsencrypt

  services:
    comfyui:
      loadBalancer:
        servers:
          - url: "http://{{ infra_tailscale_fqdn_inference_host | default('kckinai.' ~ (infra_tailscale_tailnet | default('example.ts.net'))) }}:{{ infra_port_ai_comfyui_host | default('8188') }}"
        passHostHeader: true
