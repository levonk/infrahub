# Traefik Dynamic Configuration - copyparty Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ copyparty_domain }}
# Security: copyparty built-in basic auth (NOT Authelia — copyparty handles auth internally)

http:
  routers:
    copyparty-http:
      rule: "Host(`{{ copyparty_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: copyparty

    copyparty-https:
      rule: "Host(`{{ copyparty_domain }}`)"
      entryPoints:
        - websecure
      service: copyparty
      tls:
        certResolver: letsencrypt

  services:
    copyparty:
      loadBalancer:
        servers:
          - url: "http://{{ copyparty_container_name | default('copyparty') }}:{{ copyparty_container_port | default('3923') }}"  # project-lint: disable=magic-int  Jinja default port value, should use infra_port variable
        passHostHeader: true
