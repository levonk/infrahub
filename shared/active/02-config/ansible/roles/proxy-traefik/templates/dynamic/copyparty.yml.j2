# Traefik Dynamic Configuration - copyparty Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ copyparty_domain }}
# Purpose: File sharing server (web UI + uploads/downloads)
# Security: copyparty built-in auth — NO Authelia. Anonymous share links
#           (read /public, write-only /uploads) must stay reachable.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    copyparty-http:
      rule: "Host(`{{ copyparty_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: copyparty

    # HTTPS router — copyparty handles auth internally
    copyparty-https:
      rule: "Host(`{{ copyparty_domain }}`)"
      entryPoints:
        - websecure
      service: copyparty
      tls:
        certResolver: letsencrypt

  services:
    copyparty:
      loadBalancer:
        servers:
          - url: "http://{{ copyparty_container_name }}:{{ copyparty_container_port }}"
        passHostHeader: true
