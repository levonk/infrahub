# Traefik Dynamic Configuration - CrowdSec Web UI Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_security_crowdsec }}
#
# CrowdSec runs on the OCI cloud server (same machine as Traefik).
# Routing is local (container name + port).
#
# Security: CrowdSec web UI is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    crowdsec-http:
      rule: "Host(`{{ infra_domain_security_crowdsec }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: crowdsec

    # HTTPS behind Authelia SSO
    crowdsec-https:
      rule: "Host(`{{ infra_domain_security_crowdsec }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: crowdsec
      tls:
        certResolver: letsencrypt

  services:
    crowdsec:
      loadBalancer:
        servers:
          - url: "http://{{ infra_hostname_crowdsec | default('crowdsec') }}:{{ security_crowdsec_lapi_container_port | default(infra_port_proxy_mitm_webui_container) }}"
        passHostHeader: true
