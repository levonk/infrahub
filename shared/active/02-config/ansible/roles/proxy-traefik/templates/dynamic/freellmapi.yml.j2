# Traefik Dynamic Configuration - FreeLLMAPI
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ ai_freellmapi_domain }}
# Purpose: Free-tier LLM aggregator with OpenAI-compatible /v1 endpoint
# Security: Authelia SSO (dashboard is admin-only)

http:
  routers:
    # HTTP router (redirects to HTTPS)
    freellmapi-http:
      rule: "Host(`{{ ai_freellmapi_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: freellmapi

    # HTTPS router (behind Authelia SSO)
    freellmapi-https:
      rule: "Host(`{{ ai_freellmapi_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: freellmapi
      tls:
        certResolver: letsencrypt

  services:
    freellmapi:
      loadBalancer:
        servers:
          - url: "http://{{ ai_freellmapi_container_name }}:{{ ai_freellmapi_container_port }}"
        passHostHeader: true
