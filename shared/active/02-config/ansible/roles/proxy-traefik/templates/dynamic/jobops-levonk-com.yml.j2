# Traefik Dynamic Configuration - JobOps Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ jobops_domain | default('jobops.levonk.com') }}
# Security Chain: Authelia (SSO)
#
# CROSS-MACHINE ROUTING: JobOps runs on the Windows Docker host (dtop202311),
# NOT on the OCI cloud server where Traefik runs. Traefik routes to the
# Windows machine's Tailscale FQDN + host port via Tailscale.
#
# This is an exception to the "container names — NEVER hardcoded IPs" rule.
# The rule exists because container IPs are ephemeral. A Tailscale FQDN is
# stable — it survives container recreation, network reconnection, and host
# restarts. The FQDN is defined in infrastructure variables, not hardcoded.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    jobops-http:
      rule: "Host(`{{ jobops_domain | default('jobops.levonk.com') }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: jobops

    # HTTPS router with Authelia middleware
    jobops-https:
      rule: "Host(`{{ jobops_domain | default('jobops.levonk.com') }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: jobops
      tls:
        certResolver: letsencrypt

  services:
    jobops:
      loadBalancer:
        servers:
          - url: "{{ jobops_traefik_backend_url | default('http://' ~ infra_tailscale_fqdn_windows_docker | default('dtop202311.tale-grouper.ts.net') ~ ':' ~ infra_port_career_jobops_host | default('3005')) }}"
        passHostHeader: true
