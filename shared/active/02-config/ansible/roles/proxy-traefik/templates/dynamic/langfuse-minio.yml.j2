# Traefik Dynamic Configuration - Langfuse MinIO Console Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_ai_langfuse_minio }}
#
# Langfuse MinIO runs on the OCI cloud server (same machine as Traefik).
# Routing is local (container name + port).
#
# Security: MinIO console is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    langfuse-minio-http:
      rule: "Host(`{{ infra_domain_ai_langfuse_minio }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: langfuse-minio

    # HTTPS behind Authelia SSO
    langfuse-minio-https:
      rule: "Host(`{{ infra_domain_ai_langfuse_minio }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: langfuse-minio
      tls:
        certResolver: letsencrypt

  services:
    langfuse-minio:
      loadBalancer:
        servers:
          - url: "http://{{ infra_hostname_langfuse_minio | default('langfuse-minio') }}:{{ infra_port_ai_langfuse_minio_console_container | default('9001') }}"
        passHostHeader: true
