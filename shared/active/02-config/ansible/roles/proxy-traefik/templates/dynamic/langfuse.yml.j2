# Traefik Dynamic Configuration - Langfuse Web UI Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_ai_langfuse }}
#
# Langfuse runs on the OCI cloud server (same machine as Traefik).
# Routing is local (container name + port).
#
# Security: Langfuse web UI is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    langfuse-http:
      rule: "Host(`{{ infra_domain_ai_langfuse }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: langfuse

    # HTTPS behind Authelia SSO
    langfuse-https:
      rule: "Host(`{{ infra_domain_ai_langfuse }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: langfuse
      tls:
        certResolver: letsencrypt

  services:
    langfuse:
      loadBalancer:
        servers:
          - url: "http://{{ infra_hostname_langfuse_web | default('langfuse-web') }}:{{ infra_port_ai_langfuse_web_container | default(infra_port_monitoring_grafana_host) }}"
        passHostHeader: true
