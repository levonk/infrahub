# Traefik Dynamic Configuration - MITM CA Certificate Download
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_proxy_mitm_ca }}
#
# Serves the MITM proxy CA certificate for download.
# The CA cert is stored in the mitmproxy CA volume and served via
# a lightweight nginx sidecar or direct file access.
#
# Security: CA cert download is behind Authelia SSO (the CA is a
# trust root — only authorized users should download it).

http:
  routers:
    # HTTP redirect to HTTPS
    mitm-ca-http:
      rule: "Host(`{{ infra_domain_proxy_mitm_ca }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: mitm-ca

    # HTTPS behind Authelia SSO
    mitm-ca-https:
      rule: "Host(`{{ infra_domain_proxy_mitm_ca }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: mitm-ca
      tls:
        certResolver: letsencrypt

  services:
    mitm-ca:
      loadBalancer:
        servers:
          # The mitmweb UI serves the CA cert at /mitmproxy-ca-cert.cer
          - url: "http://{{ infra_network_ip_proxy_mitm | default('172.26.255.80') }}:{{ infra_port_proxy_mitm_webui_container | default('8081') }}"
        passHostHeader: true
