# Traefik Dynamic Configuration - MITM Proxy Web UI Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_proxy_mitm }}
#
# MITM Proxy (mitmweb) runs on the same machine as Traefik.
# Routing is local (container IP + port on localnet-network).
#
# Security: MITM proxy web UI is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    mitm-http:
      rule: "Host(`{{ infra_domain_proxy_mitm }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: mitm

    # HTTPS behind Authelia SSO
    mitm-https:
      rule: "Host(`{{ infra_domain_proxy_mitm }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: mitm
      tls:
        certResolver: letsencrypt

  services:
    mitm:
      loadBalancer:
        servers:
          - url: "http://{{ infra_network_ip_proxy_mitm | default(infra_network_ip_proxy_mitm) }}:{{ infra_port_proxy_mitm_webui_container | default(infra_port_proxy_mitm_webui_container) }}"
        passHostHeader: true
