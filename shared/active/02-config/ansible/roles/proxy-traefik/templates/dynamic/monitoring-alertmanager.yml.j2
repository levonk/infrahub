# Traefik Dynamic Configuration - Alertmanager Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_monitoring_alertmanager }}
# Security Chain: Authelia (SSO)
# Uses container hostname (not hardcoded IP) so it survives container recreation.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    alertmanager-http:
      rule: "Host(`{{ infra_domain_monitoring_alertmanager }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: alertmanager

    # HTTPS router with Authelia middleware
    alertmanager-https:
      rule: "Host(`{{ infra_domain_monitoring_alertmanager }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: alertmanager
      tls:
        certResolver: letsencrypt

  services:
    alertmanager:
      loadBalancer:
        servers:
          - url: "http://{{ infra_hostname_monitoring_alertmanager }}:{{ infra_port_monitoring_alertmanager_container }}"
        passHostHeader: true
