# Traefik Dynamic Configuration - Grafana Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_monitoring_grafana }}
# Security Chain: Authelia (SSO)
# Uses container hostname (not hardcoded IP) so it survives container recreation.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    grafana-http:
      rule: "Host(`{{ infra_domain_monitoring_grafana }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: grafana

    # HTTPS router with Authelia middleware
    grafana-https:
      rule: "Host(`{{ infra_domain_monitoring_grafana }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: grafana
      tls:
        certResolver: letsencrypt

  services:
    grafana:
      loadBalancer:
        servers:
          - url: "http://{{ infra_hostname_monitoring_grafana }}:{{ infra_port_monitoring_grafana_container }}"
        passHostHeader: true
