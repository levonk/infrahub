# Traefik Dynamic Configuration - Uptime Kuma Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_monitoring_uptime_kuma }}
# Security Chain: Authelia (SSO)
# Uses container hostname (not hardcoded IP) so it survives container recreation.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    uptime-kuma-http:
      rule: "Host(`{{ infra_domain_monitoring_uptime_kuma }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: uptime-kuma

    # HTTPS router with Authelia middleware
    uptime-kuma-https:
      rule: "Host(`{{ infra_domain_monitoring_uptime_kuma }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: uptime-kuma
      tls:
        certResolver: letsencrypt

  services:
    uptime-kuma:
      loadBalancer:
        servers:
          - url: "http://{{ infra_hostname_monitoring_uptime_kuma }}:{{ infra_port_monitoring_uptime_kuma_container }}"
        passHostHeader: true
