# Traefik Dynamic Configuration - n8n Grafana Dashboard Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ n8n_grafana_domain }}
# Security Chain: Authelia (SSO)
# Grafana dashboards for n8n observability (webhook/form executions).
# Uses container name (not hardcoded IP) so it survives container recreation.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    n8n-grafana-http:
      rule: "Host(`{{ n8n_grafana_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: n8n-grafana

    # HTTPS router with Authelia middleware
    n8n-grafana-https:
      rule: "Host(`{{ n8n_grafana_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: n8n-grafana
      tls:
        certResolver: letsencrypt

  services:
    n8n-grafana:
      loadBalancer:
        servers:
          - url: "http://{{ n8n_grafana_container_name | default('localnet-n8n-grafana') }}:{{ n8n_grafana_container_port | default('3000') }}"
        passHostHeader: true
