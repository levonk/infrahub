# Traefik Dynamic Configuration - n8n Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ n8n_domain }}
# Security Chain: Authelia (SSO)
# n8n runs in standalone mode with Postgres + Prometheus + Grafana.
# Uses container name (not hardcoded IP) so it survives container recreation.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    n8n-http:
      rule: "Host(`{{ n8n_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: n8n

    # HTTPS router with Authelia middleware
    n8n-https:
      rule: "Host(`{{ n8n_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: n8n
      tls:
        certResolver: letsencrypt

  services:
    n8n:
      loadBalancer:
        servers:
          - url: "http://{{ n8n_container_name | default('localnet-n8n') }}:{{ n8n_container_port | default('5678') }}"
        passHostHeader: true
