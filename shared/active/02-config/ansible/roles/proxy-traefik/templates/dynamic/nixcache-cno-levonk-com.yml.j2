# Traefik Dynamic Configuration - Nix Cache Chain (cno) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ nix_ncps_domain_cno | default('nixcache.cno.levonk.com') }}
#
# SAME-MACHINE ROUTING: ncps runs on the OCI cloud server (cno), same machine
# as Traefik. Routes to the ncps container via the traefik-network.
#
# Security: Nix binary cache is a public API — Nix clients verify NARs via
# public keys, not web UI auth. No Authelia middleware. HTTP → HTTPS redirect
# for cache-info discovery, TLS with letsencrypt.

http:
  routers:
    # HTTP redirect to HTTPS (Nix clients may try HTTP first for cache-info)
    nix-cache-cno-http:
      rule: "Host(`{{ nix_ncps_domain_cno | default('nixcache.cno.levonk.com') }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: nix-cache-cno

    # HTTPS — Nix binary cache API (no Authelia, public cache)
    nix-cache-cno-https:
      rule: "Host(`{{ nix_ncps_domain_cno | default('nixcache.cno.levonk.com') }}`)"
      entryPoints:
        - websecure
      service: nix-cache-cno
      tls:
        certResolver: letsencrypt

  services:
    nix-cache-cno:
      loadBalancer:
        servers:
          - url: "http://{{ nix_ncps_container_name_cno | default('localnet-nix-ncps-cno') }}:{{ nix_ncps_container_port | default('8080') }}"
        passHostHeader: true
