# Traefik Dynamic Configuration - Verdaccio NPM Registry (cno) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ verdaccio_domain_cno }}
#
# SAME-MACHINE ROUTING: Verdaccio runs on the OCI cloud server (cno),
# same machine as Traefik. Routes to the container via the traefik-network.
#
# Security: Web UI is behind Authelia SSO. npm CLI endpoints bypass
# Authelia — npm CLI authenticates via htpasswd tokens directly. Traefik
# still terminates TLS and applies security headers, rate limiting, and
# access logging for all traffic.
#
# Routing strategy: The web UI router matches ONLY the root path (/) with
# high priority and applies Authelia. The npm CLI router matches ALL
# other paths with lower priority, bypassing Authelia. npm CLI never
# fetches the root path — it uses /-/ping for connectivity checks and
# /<package> for metadata.

http:
  routers:
    # HTTP redirect to HTTPS
    verdaccio-cno-http:
      rule: "Host(`{{ verdaccio_domain_cno }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: verdaccio-cno

    # HTTPS — Web UI (root path only) behind Authelia SSO
    # Highest priority so / matches this router, not the catch-all below
    verdaccio-cno-web-ui:
      rule: "Host(`{{ verdaccio_domain_cno }}`) && Path(`/`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      priority: 200  # project-lint: disable=magic-int  higher than npm-cli catch-all
      service: verdaccio-cno
      tls:
        certResolver: letsencrypt

    # HTTPS — npm CLI (all other paths, bypass Authelia)
    # Lower priority than the web UI router. Matches /-/*, /<package>,
    # /@scope/<pkg>, /<pkg>/-/<tgz> — everything except the root /.
    verdaccio-cno-npm-cli:
      rule: "Host(`{{ verdaccio_domain_cno }}`)"
      entryPoints:
        - websecure
      priority: 100  # project-lint: disable=magic-int  lower than web-ui root match
      service: verdaccio-cno
      tls:
        certResolver: letsencrypt

  services:
    verdaccio-cno:
      loadBalancer:
        servers:
          - url: "http://{{ verdaccio_container_name_cno | default('localnet-artifact-verdaccio') }}:{{ verdaccio_container_port | default('4873') }}"  # project-lint: disable=magic-int  Jinja default port value, should use infra_port variable
        passHostHeader: true
