# Traefik Dynamic Configuration - Verdaccio NPM Registry (cno) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ verdaccio_domain_cno }}
#
# SAME-MACHINE ROUTING: Verdaccio runs on the OCI cloud server (cno),
# same machine as Traefik. Routes to the container via the traefik-network.
#
# Security: Web UI is behind Authelia SSO. npm CLI endpoints (/-/) bypass
# Authelia — npm CLI authenticates via htpasswd tokens directly.

http:
  routers:
    # HTTP redirect to HTTPS
    verdaccio-cno-http:
      rule: "Host(`{{ verdaccio_domain_cno }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: verdaccio-cno

    # HTTPS — npm CLI endpoints (bypass Authelia, use htpasswd tokens)
    # Priority higher than the web UI router so /-/ paths match this one first
    verdaccio-cno-npm-cli:
      rule: "Host(`{{ verdaccio_domain_cno }}`) && PathPrefix(`/-/`)"
      entryPoints:
        - websecure
      priority: 100  # project-lint: disable=magic-int  nftables chain priority, not a standalone magic number
      service: verdaccio-cno
      tls:
        certResolver: letsencrypt

    # HTTPS — Web UI behind Authelia SSO
    verdaccio-cno-https:
      rule: "Host(`{{ verdaccio_domain_cno }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: verdaccio-cno
      tls:
        certResolver: letsencrypt

  services:
    verdaccio-cno:
      loadBalancer:
        servers:
          - url: "http://{{ verdaccio_container_name_cno | default('localnet-artifact-verdaccio') }}:{{ verdaccio_container_port | default('4873') }}"  # project-lint: disable=magic-int  Jinja default port value, should use infra_port variable
        passHostHeader: true
