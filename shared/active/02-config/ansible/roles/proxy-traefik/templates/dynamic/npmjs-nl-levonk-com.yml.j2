# Traefik Dynamic Configuration - Verdaccio NPM Registry (nl) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ verdaccio_domain_nl | default('npmjs.nl.levonk.com') }}
#
# CROSS-MACHINE ROUTING: Verdaccio runs on the Windows Docker host (dtop202311),
# NOT on the OCI cloud server where Traefik runs. Traefik routes to the
# Windows machine's Tailscale FQDN + host port via Tailscale.
#
# Security: Web UI is behind Authelia SSO. npm CLI endpoints (/-/) bypass
# Authelia — npm CLI authenticates via htpasswd tokens directly.

http:
  routers:
    # HTTP redirect to HTTPS
    verdaccio-nl-http:
      rule: "Host(`{{ verdaccio_domain_nl | default('npmjs.nl.levonk.com') }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: verdaccio-nl

    # HTTPS — npm CLI endpoints (bypass Authelia, use htpasswd tokens)
    # Priority higher than the web UI router so /-/ paths match this one first
    verdaccio-nl-npm-cli:
      rule: "Host(`{{ verdaccio_domain_nl | default('npmjs.nl.levonk.com') }}`) && PathPrefix(`/-/`)"
      entryPoints:
        - websecure
      priority: 100
      service: verdaccio-nl
      tls:
        certResolver: letsencrypt

    # HTTPS — Web UI behind Authelia SSO
    verdaccio-nl-https:
      rule: "Host(`{{ verdaccio_domain_nl | default('npmjs.nl.levonk.com') }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: verdaccio-nl
      tls:
        certResolver: letsencrypt

  services:
    verdaccio-nl:
      loadBalancer:
        servers:
          - url: "http://{{ infra_tailscale_fqdn_windows_docker | default('dtop202311.tale-grouper.ts.net') }}:{{ verdaccio_host_port | default('4873') }}"
        passHostHeader: true
