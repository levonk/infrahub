# Traefik Dynamic Configuration - Paperclip AI Orchestration Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ ai_paperclip_domain | default('paperclip.' ~ (infra_domain_base | default('example.com'))) }}
# Security Chain: Authelia (SSO) + secure-headers
# Paperclip runs on port 3100 (Node.js server + React UI).
# Uses container name (not hardcoded IP) so it survives container recreation.

http:
  routers:
    # HTTP router (redirects to HTTPS)
    paperclip-http:
      rule: "Host(`{{ ai_paperclip_domain | default('paperclip.' ~ (infra_domain_base | default('example.com'))) }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: paperclip

    # HTTPS router with Authelia middleware
    paperclip-https:
      rule: "Host(`{{ ai_paperclip_domain | default('paperclip.' ~ (infra_domain_base | default('example.com'))) }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: paperclip
      tls:
        certResolver: letsencrypt

  services:
    paperclip:
      loadBalancer:
        servers:
          - url: "http://{{ ai_paperclip_container_name | default('paperclip') }}:{{ ai_paperclip_container_port | default('3100') }}"
        passHostHeader: true

  middlewares:
    # HTTPS redirect middleware
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true
