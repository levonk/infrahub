# Traefik Dynamic Configuration - QM Web UI Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ qm_domain | default('qm.levonk.com') }}
#
# CROSS-MACHINE ROUTING: QM runs on the Windows Docker host (dtop202311),
# NOT on the OCI cloud server where Traefik runs. Traefik routes to the
# Windows machine's Tailscale FQDN + host port via Tailscale.
#
# Security: QM web UI is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    qm-http:
      rule: "Host(`{{ qm_domain | default('qm.levonk.com') }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: qm

    # HTTPS behind Authelia SSO
    qm-https:
      rule: "Host(`{{ qm_domain | default('qm.levonk.com') }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: qm
      tls:
        certResolver: letsencrypt

  services:
    qm:
      loadBalancer:
        servers:
          - url: "{{ qm_traefik_backend_url | default('http://' ~ infra_tailscale_fqdn_windows_docker | default('dtop202311.tale-grouper.ts.net') ~ ':' ~ infra_port_ai_qm_web_host | default('3105')) }}"
        passHostHeader: true
