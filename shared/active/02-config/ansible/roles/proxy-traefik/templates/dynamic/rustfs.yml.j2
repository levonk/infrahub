# Traefik Dynamic Configuration - RustFS Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# S3 API Domain: {{ rustfs_domain }}
# Console Domain: {{ rustfs_console_domain }}
#
# CROSS-MACHINE ROUTING: RustFS runs on the Windows Docker host (dtop202311),
# NOT on the OCI cloud server where Traefik runs. Traefik routes to the
# Windows machine's Tailscale FQDN + host port via Tailscale.
#
# Security: S3 API is accessed with access/secret keys (no Authelia). Console
# WebUI is behind Authelia SSO.

http:
  routers:
    # S3 API — HTTP redirect to HTTPS
    rustfs-http:
      rule: "Host(`{{ rustfs_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: rustfs

    # S3 API — HTTPS, no auth middleware (S3-compatible keys)
    rustfs-https:
      rule: "Host(`{{ rustfs_domain }}`)"
      entryPoints:
        - websecure
      service: rustfs
      tls:
        certResolver: letsencrypt

    # Console — HTTP redirect to HTTPS
    rustfs-console-http:
      rule: "Host(`{{ rustfs_console_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: rustfs-console

    # Console — HTTPS behind Authelia SSO
    rustfs-console-https:
      rule: "Host(`{{ rustfs_console_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: rustfs-console
      tls:
        certResolver: letsencrypt

  services:
    rustfs:
      loadBalancer:
        servers:
          - url: "{{ rustfs_traefik_backend_url | default('http://' ~ infra_tailscale_fqdn_windows_docker | default('dtop202311.' ~ (infra_tailscale_tailnet | default('example.ts.net'))) ~ ':' ~ infra_port_storage_rustfs_s3_host | default('9000')) }}"
        passHostHeader: true

    rustfs-console:
      loadBalancer:
        servers:
          - url: "{{ rustfs_console_traefik_backend_url | default('http://' ~ infra_tailscale_fqdn_windows_docker | default('dtop202311.' ~ (infra_tailscale_tailnet | default('example.ts.net'))) ~ ':' ~ infra_port_storage_rustfs_console_host | default('9001')) }}"
        passHostHeader: true
