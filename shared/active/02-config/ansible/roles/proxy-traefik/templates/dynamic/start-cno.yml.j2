# Traefik Dynamic Configuration - Homepage (cno)
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_dashboard_homepage_cno }}
# Purpose: cno-specific Homepage startpage — routes to the same homepage container
# Security Chain: Authelia

http:
  routers:
    homepage-cno-http:
      rule: "Host(`{{ infra_domain_dashboard_homepage_cno }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: homepage-cno

    homepage-cno-https:
      rule: "Host(`{{ infra_domain_dashboard_homepage_cno }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: homepage-cno
      tls:
        certResolver: letsencrypt

  services:
    homepage-cno:
      loadBalancer:
        servers:
          - url: "http://{{ dashboard_homepage_container_name | default('homepage') }}:{{ dashboard_homepage_container_port | default('3000') }}"
        passHostHeader: true
