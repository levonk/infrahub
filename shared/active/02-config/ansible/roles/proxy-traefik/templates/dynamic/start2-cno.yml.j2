# Traefik Dynamic Configuration - TraLa (cno)
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_dashboard_trala_cno }}
# Purpose: cno-specific TraLa dashboard — routes to the same trala container
# Security Chain: Authelia

http:
  routers:
    trala-cno-http:
      rule: "Host(`{{ infra_domain_dashboard_trala_cno }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: trala-cno

    trala-cno-https:
      rule: "Host(`{{ infra_domain_dashboard_trala_cno }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: trala-cno
      tls:
        certResolver: letsencrypt

  services:
    trala-cno:
      loadBalancer:
        servers:
          - url: "http://{{ dashboard_trala_container_name | default('trala') }}:{{ dashboard_trala_container_port | default(infra_port_proxy_dashboard_host) }}"
        passHostHeader: true
