# Traefik Dynamic Configuration - treg Tool Registry (cno) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ treg_domain }}
#
# SAME-MACHINE ROUTING: treg runs on the OCI cloud server (cno),
# same machine as Traefik. Routes to the container via the traefik-network.
#
# Security split (Verdaccio-style):
#   - Web UI (/app, /) → Authelia SSO middleware
#   - API/proxy paths (/call/, /mcp/, /meta, /api/, /llms.txt, /install.sh, /docs)
#     → public, authenticated via X-Treg-Token header (no Authelia)

http:
  routers:
    # HTTP redirect to HTTPS (all paths)
    treg-http:
      rule: "Host(`{{ treg_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: treg

    # HTTPS — API/proxy paths (public, X-Treg-Token auth)
    # Higher priority so these match before the web UI catch-all
    treg-api-https:
      rule: "Host(`{{ treg_domain }}`) && PathPrefix(`/call/`) || PathPrefix(`/mcp/`) || PathPrefix(`/meta`) || PathPrefix(`/api/`) || PathPrefix(`/llms.txt`) || PathPrefix(`/install.sh`) || PathPrefix(`/docs`) || PathPrefix(`/openapi.json`) || PathPrefix(`/redoc`)"
      entryPoints:
        - websecure
      priority: 100  # project-lint: disable=magic-int  Traefik router priority, not a standalone magic number
      service: treg
      tls:
        certResolver: letsencrypt

    # HTTPS — Web UI behind Authelia SSO (catch-all, lower priority)
    treg-web-https:
      rule: "Host(`{{ treg_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: treg
      tls:
        certResolver: letsencrypt

  services:
    treg:
      loadBalancer:
        servers:
          - url: "http://{{ treg_container_name | default('localnet-ai-treg') }}:{{ treg_container_port | default('18790') }}"
        passHostHeader: true
