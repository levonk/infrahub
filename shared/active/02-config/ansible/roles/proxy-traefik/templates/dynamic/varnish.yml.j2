# Traefik Dynamic Configuration - Varnish Admin UI Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_proxy_varnish }}
#
# Varnish admin runs on the same machine as Traefik.
# Routing is local (container IP + port on localnet-network).
#
# Security: Varnish admin is behind Authelia SSO.

http:
  routers:
    # HTTP redirect to HTTPS
    varnish-http:
      rule: "Host(`{{ infra_domain_proxy_varnish }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: varnish

    # HTTPS behind Authelia SSO
    varnish-https:
      rule: "Host(`{{ infra_domain_proxy_varnish }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: varnish
      tls:
        certResolver: letsencrypt

  services:
    varnish:
      loadBalancer:
        servers:
          - url: "http://{{ infra_network_ip_proxy_varnish | default(infra_network_ip_proxy_varnish) }}:{{ infra_port_proxy_varnish_http_container | default('6081') }}"  # project-lint: disable=magic-int  Jinja default port value, should use infra_port variable
        passHostHeader: true
