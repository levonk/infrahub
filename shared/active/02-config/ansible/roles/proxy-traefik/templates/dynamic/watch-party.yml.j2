# Traefik Dynamic Configuration - Local Watch Party Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ media_watch_party_domain }}
# Purpose: Synchronized movie watching with friends (web UI + Socket.IO)
# Security: Authelia SSO (no built-in auth in the app)

http:
  routers:
    # HTTP router (redirects to HTTPS)
    watch-party-http:
      rule: "Host(`{{ media_watch_party_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: watch-party

    # HTTPS router with Authelia SSO
    watch-party-https:
      rule: "Host(`{{ media_watch_party_domain }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: watch-party
      tls:
        certResolver: letsencrypt

  services:
    watch-party:
      loadBalancer:
        servers:
          - url: "http://{{ media_watch_party_container_name }}:{{ media_watch_party_container_port }}"
        passHostHeader: true
