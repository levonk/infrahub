# Traefik Dynamic Configuration - Wazuh Dashboard Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ wazuh_domain | default('wazuh.levonk.com') }}
#
# CROSS-MACHINE ROUTING: Wazuh runs on the Windows Docker host (dtop202311),
# NOT on the OCI cloud server where Traefik runs. Traefik routes to the
# Windows machine's Tailscale FQDN + host port via Tailscale.
#
# Security: Wazuh dashboard has its own auth (wazuh-wui user). Authelia SSO
# is added as an additional layer.

http:
  routers:
    # HTTP redirect to HTTPS
    wazuh-http:
      rule: "Host(`{{ wazuh_domain | default('wazuh.levonk.com') }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: wazuh

    # HTTPS behind Authelia SSO
    wazuh-https:
      rule: "Host(`{{ wazuh_domain | default('wazuh.levonk.com') }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: wazuh
      tls:
        certResolver: letsencrypt

  services:
    wazuh:
      loadBalancer:
        servers:
          - url: "{{ wazuh_traefik_backend_url | default('http://' ~ infra_tailscale_fqdn_windows_docker | default('dtop202311.tale-grouper.ts.net') ~ ':' ~ infra_port_security_wazuh_dashboard_host | default('5601')) }}"
        passHostHeader: true
