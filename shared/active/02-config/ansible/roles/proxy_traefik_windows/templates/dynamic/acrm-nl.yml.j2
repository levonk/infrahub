# Traefik Dynamic Configuration - ACRM (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_acrm_domain }}
# API subdomain: {{ proxy_traefik_windows_acrm_api_domain }} (no Authelia — app enforces x-acrm-api-key)
# Purpose: Context-aware communication intelligence platform (Next.js 16 + Postgres)
# Security: Authelia SSO (forwarded to OCI via Tailscale) on dashboard
#           API key auth on API subdomain (Vencord plugin + headless clients)

http:
  routers:
    acrm-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_acrm_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: acrm-nl

    acrm-nl-https:
      rule: "Host(`{{ proxy_traefik_windows_acrm_domain }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: acrm-nl
      tls:
        certResolver: letsencrypt

    # API subdomain — no Authelia middleware (app enforces x-acrm-api-key)
    acrm-api-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_acrm_api_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: acrm-nl

    acrm-api-nl-https:
      rule: "Host(`{{ proxy_traefik_windows_acrm_api_domain }}`)"
      entryPoints:
        - websecure
      service: acrm-nl
      tls:
        certResolver: letsencrypt

  services:
    acrm-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_acrm_container_name }}:{{ proxy_traefik_windows_acrm_container_port }}"
        passHostHeader: true
