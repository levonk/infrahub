# Traefik Dynamic Configuration - Control Center (default) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_control_center_domain_default }}
#
# Routes to the control-center container (dashboard).
# Web UI is behind Authelia SSO (forwarded to OCI via Tailscale).

http:
  routers:
    # HTTP redirect to HTTPS
    control-center-default-http:
      rule: "Host(`{{ proxy_traefik_windows_control_center_domain_default }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: control-center-default

    # HTTPS — Web UI behind Authelia SSO
    control-center-default-https:
      rule: "Host(`{{ proxy_traefik_windows_control_center_domain_default }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: control-center-default
      tls:
        certResolver: letsencrypt

  services:
    control-center-default:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_control_center_container_name }}:{{ proxy_traefik_windows_control_center_container_port }}"
        passHostHeader: true
