# Traefik Dynamic Configuration - Garnix CI (nl) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_garnix_ci_domain }}
#
# Routes to the garnix-ci container (Nix-based CI builder).
# Web UI is behind Authelia SSO (forwarded to OCI via Tailscale).
# API endpoints bypass Authelia (CI clients authenticate via tokens).

http:
  routers:
    # HTTP redirect to HTTPS
    garnix-ci-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_garnix_ci_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: garnix-ci-nl

    # HTTPS — API endpoints (bypass Authelia, use token auth)
    # Priority higher than the web UI router so /api/ paths match this one first
    garnix-ci-nl-api:
      rule: "Host(`{{ proxy_traefik_windows_garnix_ci_domain }}`) && PathPrefix(`/api/`)"
      entryPoints:
        - websecure
      priority: 100
      service: garnix-ci-nl-api
      tls:
        certResolver: letsencrypt

    # HTTPS — Web UI behind Authelia SSO
    garnix-ci-nl-https:
      rule: "Host(`{{ proxy_traefik_windows_garnix_ci_domain }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: garnix-ci-nl
      tls:
        certResolver: letsencrypt

  services:
    garnix-ci-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_garnix_ci_container_name }}:{{ proxy_traefik_windows_garnix_ci_web_container_port }}"
        passHostHeader: true

    garnix-ci-nl-api:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_garnix_ci_container_name }}:{{ proxy_traefik_windows_garnix_ci_api_container_port }}"
        passHostHeader: true
