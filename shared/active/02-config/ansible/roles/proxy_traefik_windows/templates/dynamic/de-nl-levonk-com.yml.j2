# Traefik Dynamic Configuration - Directory Empire (nl) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_directory_empire_domain }}
#
# Routes to the directory-empire container (Next.js orchestration dashboard).
# Web UI is behind Authelia SSO (forwarded to OCI via Tailscale).

http:
  routers:
    # HTTP redirect to HTTPS
    directory-empire-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_directory_empire_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: directory-empire-nl

    # HTTPS — Web UI behind Authelia SSO
    directory-empire-nl-https:
      rule: "Host(`{{ proxy_traefik_windows_directory_empire_domain }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: directory-empire-nl
      tls:
        certResolver: letsencrypt

  services:
    directory-empire-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_directory_empire_container_name }}:{{ proxy_traefik_windows_directory_empire_container_port }}"
        passHostHeader: true
