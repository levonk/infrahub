# Traefik Dynamic Configuration - DNSDist Web Console Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_dns_dnsdist }}
#
# DNSDist runs on the Windows Docker host (same machine as this Traefik).
# Routing is local (container name + port).
#
# Security: DNSDist web console is behind Authelia SSO (forwarded to OCI via Tailscale).

http:
  routers:
    # HTTP redirect to HTTPS
    dnsdist-http:
      rule: "Host(`{{ infra_domain_dns_dnsdist }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: dnsdist

    # HTTPS behind Authelia SSO
    dnsdist-https:
      rule: "Host(`{{ infra_domain_dns_dnsdist }}`)"
      entryPoints:
        - websecure
      middlewares:
        - authelia
      service: dnsdist
      tls:
        certResolver: letsencrypt

  services:
    dnsdist:
      loadBalancer:
        servers:
          - url: "http://{{ dns_dnsdist_container_name | default('localnet-dns-dnsdist') }}:{{ infra_port_dns_dnsdist_metrics_container | default('8083') }}"  # project-lint: disable=magic-int  Jinja default port value, should use infra_port variable
        passHostHeader: true
