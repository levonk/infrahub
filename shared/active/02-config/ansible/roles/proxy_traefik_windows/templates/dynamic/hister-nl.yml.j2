# Traefik Dynamic Configuration - Hister (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ search_hister_domain }}
# Purpose: Self-hosted search engine for browsing history and documents
# Security: Authelia SSO (forwarded to OCI via Tailscale)

http:
  routers:
    hister-nl-http:
      rule: "Host(`{{ search_hister_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: hister-nl

    hister-nl-https:
      rule: "Host(`{{ search_hister_domain }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: hister-nl
      tls:
        certResolver: letsencrypt

  services:
    hister-nl:
      loadBalancer:
        servers:
          - url: "http://{{ search_hister_container_name }}:{{ search_hister_container_port }}"
        passHostHeader: true
