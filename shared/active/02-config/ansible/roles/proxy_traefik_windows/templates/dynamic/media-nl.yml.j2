# Traefik Dynamic Configuration - Media Stack (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Purpose: Jellyfin + *arr media pipeline on dtop202311 (Windows Docker Desktop)
# Security: Authelia SSO on all browser-facing services
# Domains: {software}.nl.levonk.com (specific) + {service}.levonk.com (generic alias)
# See shared/docs/pipelines/media/PIPELINE-MEDIA.md for the full pipeline.

http:
  routers:
    # Jellyfin — media server
    jellyfin-nl-http:
      rule: "Host(`{{ media_stack_jellyfin_domain }}`) || Host(`{{ media_stack_jellyfin_domain_alias }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: jellyfin-nl

    jellyfin-nl-https:
      rule: "Host(`{{ media_stack_jellyfin_domain }}`) || Host(`{{ media_stack_jellyfin_domain_alias }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: jellyfin-nl
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ media_stack_jellyfin_domain }}"
            sans:
              - "{{ media_stack_jellyfin_domain_alias }}"

