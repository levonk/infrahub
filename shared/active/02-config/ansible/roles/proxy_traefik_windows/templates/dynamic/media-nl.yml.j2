    # qBittorrent + SABnzbd route to the nordvpn (gluetun) container because
    # they share nordvpn's network namespace (--network container:nordvpn).
    # Their web UI ports are accessible via nordvpn's IP on traefik-windows-network.
    qbittorrent-nl:
      loadBalancer:
        servers:
          - url: "http://{{ media_stack_vpn_gateway_container | default('nordvpn') }}:{{ media_stack_qbittorrent_container_port }}"
        passHostHeader: true

    sabnzbd-nl:
      loadBalancer:
        servers:
          - url: "http://{{ media_stack_vpn_gateway_container | default('nordvpn') }}:{{ media_stack_sabnzbd_container_port }}"
        passHostHeader: true
