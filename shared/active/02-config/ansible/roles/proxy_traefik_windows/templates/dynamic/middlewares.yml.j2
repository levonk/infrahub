# Traefik Dynamic Configuration - Middlewares (Windows)
# Generated by Ansible - DO NOT EDIT MANUALLY

http:
  middlewares:
{% if proxy_traefik_windows_authelia_enabled %}
    # Authelia middleware — forwards auth to OCI's Authelia via Tailscale
    authelia:
      forwardAuth:
        address: "{{ proxy_traefik_windows_authelia_url }}"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Group
          - Remote-Name
          - Remote-Email
          - Authorization
{% endif %}

    # HTTP-to-HTTPS redirect
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true
