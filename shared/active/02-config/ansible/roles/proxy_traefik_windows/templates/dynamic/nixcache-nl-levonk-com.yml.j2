# Traefik Dynamic Configuration - ncps Nix Cache (nl) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_nix_ncps_domain }}
#
# Routes to the ncps container (NAR caching proxy).
# ncps is the front door for Nix clients — it caches NARs locally
# and queries ncro (parallel racing proxy) on miss.
#
# Security: Nix cache protocol uses signed NARs, so no Authelia needed.
# The cache is public-read (substituters use HTTP GET).

http:
  routers:
    # HTTP redirect to HTTPS
    nix-ncps-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_nix_ncps_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: nix-ncps-nl

    # HTTPS — Nix cache endpoints (no Authelia, Nix uses signed NARs)
    nix-ncps-nl-https:
      rule: "Host(`{{ proxy_traefik_windows_nix_ncps_domain }}`)"
      entryPoints:
        - websecure
      service: nix-ncps-nl
      tls:
        certResolver: letsencrypt

  services:
    nix-ncps-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_nix_ncps_container_name }}:{{ proxy_traefik_windows_nix_ncps_container_port }}"
        passHostHeader: true
