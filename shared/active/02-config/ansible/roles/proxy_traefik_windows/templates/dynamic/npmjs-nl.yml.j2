# Traefik Dynamic Configuration - Verdaccio NPM Registry (nl) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_verdaccio_domain }}
#
# This Traefik instance runs ON the Windows machine (nl). Verdaccio also
# runs on this machine, so routing is local (container name + port).
#
# Security: Web UI is behind Authelia SSO (forwarded to OCI via Tailscale).
# npm CLI endpoints (/-/) bypass Authelia — npm CLI authenticates via
# htpasswd tokens directly.

http:
  routers:
    # HTTP redirect to HTTPS
    verdaccio-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_verdaccio_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: verdaccio-nl

    # HTTPS — npm CLI endpoints (bypass Authelia, use htpasswd tokens)
    # Priority higher than the web UI router so /-/ paths match this one first
    verdaccio-nl-npm-cli:
      rule: "Host(`{{ proxy_traefik_windows_verdaccio_domain }}`) && PathPrefix(`/-/`)"
      entryPoints:
        - websecure
      priority: 100  # project-lint: disable=magic-int  nftables chain priority, not a standalone magic number
      service: verdaccio-nl
      tls:
        certResolver: letsencrypt

    # HTTPS — Web UI behind Authelia SSO
    verdaccio-nl-https:
      rule: "Host(`{{ proxy_traefik_windows_verdaccio_domain }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: verdaccio-nl
      tls:
        certResolver: letsencrypt

  services:
    verdaccio-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_verdaccio_container_name }}:{{ proxy_traefik_windows_verdaccio_container_port }}"
        passHostHeader: true
