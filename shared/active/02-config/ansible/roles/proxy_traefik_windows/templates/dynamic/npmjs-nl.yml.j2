# Traefik Dynamic Configuration - Verdaccio NPM Registry (nl) Routing
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_verdaccio_domain }}
#
# This Traefik instance runs ON the Windows machine (nl). Verdaccio also
# runs on this machine, so routing is local (container name + port).
#
# Security: Web UI is behind Authelia SSO (forwarded to OCI via Tailscale).
# npm CLI endpoints bypass Authelia — npm CLI authenticates via htpasswd
# tokens directly. Traefik still terminates TLS and applies security
# headers, rate limiting, and access logging for all traffic.
#
# Routing strategy: The web UI router matches ONLY the root path (/) with
# high priority and applies Authelia. The npm CLI router matches ALL
# other paths with lower priority, bypassing Authelia. npm CLI never
# fetches the root path — it uses /-/ping for connectivity checks and
# /<package> for metadata.

http:
  routers:
    # HTTP redirect to HTTPS
    verdaccio-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_verdaccio_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: verdaccio-nl

    # HTTPS — Web UI (root path only) behind Authelia SSO
    # Highest priority so / matches this router, not the catch-all below
    verdaccio-nl-web-ui:
      rule: "Host(`{{ proxy_traefik_windows_verdaccio_domain }}`) && Path(`/`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      priority: 200  # project-lint: disable=magic-int  higher than npm-cli catch-all
      service: verdaccio-nl
      tls:
        certResolver: letsencrypt

    # HTTPS — npm CLI (all other paths, bypass Authelia)
    # Lower priority than the web UI router. Matches /-/*, /<package>,
    # /@scope/<pkg>, /<pkg>/-/<tgz> — everything except the root /.
    verdaccio-nl-npm-cli:
      rule: "Host(`{{ proxy_traefik_windows_verdaccio_domain }}`)"
      entryPoints:
        - websecure
      priority: 100  # project-lint: disable=magic-int  lower than web-ui root match
      service: verdaccio-nl
      tls:
        certResolver: letsencrypt

  services:
    verdaccio-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_verdaccio_container_name }}:{{ proxy_traefik_windows_verdaccio_container_port }}"
        passHostHeader: true
