# Traefik Dynamic Configuration - Postiz (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ proxy_traefik_windows_postiz_domain }}
# Purpose: Self-hosted social-media scheduling (all-in-one: UI /, API /api,
#          uploads /uploads, OAuth callbacks /integrations — one port)
# Security: App's own auth — NO Authelia (provider OAuth callbacks and
#           registration need a direct path)

http:
  routers:
    postiz-nl-http:
      rule: "Host(`{{ proxy_traefik_windows_postiz_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: postiz-nl

    postiz-nl-https:
      rule: "Host(`{{ proxy_traefik_windows_postiz_domain }}`)"
      entryPoints:
        - websecure
      service: postiz-nl
      tls:
        certResolver: letsencrypt

  services:
    postiz-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_postiz_container_name }}:{{ proxy_traefik_windows_postiz_container_port }}"
        passHostHeader: true
