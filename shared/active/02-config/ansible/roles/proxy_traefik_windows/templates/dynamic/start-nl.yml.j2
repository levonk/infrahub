# Traefik Dynamic Configuration - Homepage (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_dashboard_homepage_nl }}
# Purpose: nl-specific Homepage startpage — routes to the homepage-nl container
# Security Chain: Authelia (forwarded to OCI via Tailscale)

http:
  routers:
    homepage-nl-http:
      rule: "Host(`{{ infra_domain_dashboard_homepage_nl }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: homepage-nl

    homepage-nl-https:
      rule: "Host(`{{ infra_domain_dashboard_homepage_nl }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: homepage-nl
      tls:
        certResolver: letsencrypt

  services:
    homepage-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_homepage_container_name | default('homepage-nl') }}:{{ proxy_traefik_windows_homepage_container_port | default(infra_port_monitoring_grafana_host) }}"
        passHostHeader: true
