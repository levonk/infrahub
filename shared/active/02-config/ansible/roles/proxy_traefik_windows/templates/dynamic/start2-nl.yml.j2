# Traefik Dynamic Configuration - TraLa (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ infra_domain_dashboard_trala_nl }}
# Purpose: nl-specific TraLa dashboard — routes to the trala-nl container
# Security Chain: Authelia (forwarded to OCI via Tailscale)

http:
  routers:
    trala-nl-http:
      rule: "Host(`{{ infra_domain_dashboard_trala_nl }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: trala-nl

    trala-nl-https:
      rule: "Host(`{{ infra_domain_dashboard_trala_nl }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: trala-nl
      tls:
        certResolver: letsencrypt

  services:
    trala-nl:
      loadBalancer:
        servers:
          - url: "http://{{ proxy_traefik_windows_trala_container_name | default('trala-nl') }}:{{ proxy_traefik_windows_trala_container_port | default(infra_port_proxy_dashboard_host) }}"
        passHostHeader: true
