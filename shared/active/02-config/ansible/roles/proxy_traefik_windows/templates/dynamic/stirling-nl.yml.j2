# Traefik Dynamic Configuration - Stirling-PDF (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ tools_stirling_pdf_domain }}
# Purpose: Self-hosted PDF utility suite (merge, split, convert, sign, OCR)
# Security: Authelia SSO (forwarded to OCI via Tailscale)

http:
  routers:
    stirling-nl-http:
      rule: "Host(`{{ tools_stirling_pdf_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: stirling-nl

    stirling-nl-https:
      rule: "Host(`{{ tools_stirling_pdf_domain }}`)"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: stirling-nl
      tls:
        certResolver: letsencrypt

  services:
    stirling-nl:
      loadBalancer:
        servers:
          - url: "http://{{ tools_stirling_pdf_container_name }}:{{ tools_stirling_pdf_container_port }}"
        passHostHeader: true
