# Traefik Dynamic Configuration - Stirling-PDF (nl) — Windows
# Generated by Ansible - DO NOT EDIT MANUALLY
# Domain: {{ tools_stirling_pdf_domain }}
# Alias: {{ tools_stirling_pdf_domain_alias | default('') }}
{% if tools_stirling_pdf_domain_api is defined and tools_stirling_pdf_domain_api | length > 0 %}
# API subdomain: {{ tools_stirling_pdf_domain_api }} (no Authelia — for desktop client)
{% endif %}
# Purpose: Self-hosted PDF utility suite (merge, split, convert, sign, OCR)
# Security: Authelia SSO (forwarded to OCI via Tailscale) on primary + alias
#           Direct API access on API subdomain (Tailscale-only network boundary)

http:
  routers:
    stirling-nl-http:
      rule: "Host(`{{ tools_stirling_pdf_domain }}`){% if tools_stirling_pdf_domain_alias is defined and tools_stirling_pdf_domain_alias | length > 0 %} || Host(`{{ tools_stirling_pdf_domain_alias }}`){% endif %}"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: stirling-nl

    stirling-nl-https:
      rule: "Host(`{{ tools_stirling_pdf_domain }}`){% if tools_stirling_pdf_domain_alias is defined and tools_stirling_pdf_domain_alias | length > 0 %} || Host(`{{ tools_stirling_pdf_domain_alias }}`){% endif %}"
      entryPoints:
        - websecure
{% if proxy_traefik_windows_authelia_enabled %}
      middlewares:
        - authelia
{% endif %}
      service: stirling-nl
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ tools_stirling_pdf_domain }}"
{% if tools_stirling_pdf_domain_alias is defined and tools_stirling_pdf_domain_alias | length > 0 %}
          - sans:
              - "{{ tools_stirling_pdf_domain_alias }}"
{% endif %}

{% if tools_stirling_pdf_domain_api is defined and tools_stirling_pdf_domain_api | length > 0 %}
    # API subdomain — no Authelia middleware (desktop client direct API access)
    # Security boundary: A record points to Tailscale IP (100.x.x.x), only
    # reachable from within the tailnet.
    stirling-api-http:
      rule: "Host(`{{ tools_stirling_pdf_domain_api }}`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: stirling-nl

    stirling-api-https:
      rule: "Host(`{{ tools_stirling_pdf_domain_api }}`)"
      entryPoints:
        - websecure
      service: stirling-nl
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ tools_stirling_pdf_domain_api }}"
{% endif %}

  services:
    stirling-nl:
      loadBalancer:
        servers:
          - url: "http://{{ tools_stirling_pdf_container_name }}:{{ tools_stirling_pdf_container_port }}"
        passHostHeader: true
