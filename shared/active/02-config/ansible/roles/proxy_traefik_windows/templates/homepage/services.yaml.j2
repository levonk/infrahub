        icon: searxng.svg
        description: Privacy-focused meta search engine
    - Croc Relay:
        href: https://{{ infra_domain_tools_croc_relay }}
        icon: mdi-file-send
        description: File transfer relay

{% if proxy_traefik_windows_media_stack_enabled | bool %}
