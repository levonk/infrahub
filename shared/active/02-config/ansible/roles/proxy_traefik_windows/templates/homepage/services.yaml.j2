---
# Homepage services.yaml — nl (Windows)
# Lists ALL services across both networks (cno + nl).
# Duplicate services (verdaccio) shown as separate blocks per network.

- Launch Pages:
    - Homepage (cno):
        href: https://{{ infra_domain_dashboard_homepage_cno }}
        icon: mdi-view-dashboard
        description: Homepage dashboard on OCI (cno network)
    - Homepage (nl):
        href: https://{{ infra_domain_dashboard_homepage_nl }}
        icon: mdi-view-dashboard
        description: Homepage dashboard on Windows (nl network)
    - TraLa (cno):
        href: https://{{ infra_domain_dashboard_trala_cno }}
        icon: mdi-view-dashboard
        description: Traefik service catalog on OCI (cno network)
    - TraLa (nl):
        href: https://{{ infra_domain_dashboard_trala_nl }}
        icon: mdi-view-dashboard
        description: Traefik service catalog on Windows (nl network)

- NPM Registries:
    - Verdaccio (cno):
        href: https://{{ infra_domain_artifact_verdaccio_cno }}
        icon: mdi-package-variant
        description: NPM registry on OCI (cno network)
    - Verdaccio (nl):
        href: https://{{ infra_domain_artifact_verdaccio_nl }}
        icon: mdi-package-variant
        description: NPM registry on Windows (nl network)

- AI Services:
    - AI Gateway (LiteLLM):
        href: https://{{ infra_domain_ai_litellm }}
        icon: litellm.svg
        description: LLM proxy gateway
    - AI Gateway API:
        href: https://{{ infra_domain_ai_litellm_api }}
        icon: mdi-api
        description: LiteLLM API endpoint
    - OmniRoute:
        href: https://{{ infra_domain_ai_omniroute }}
        icon: mdi-route
        description: AI routing service
    - AI InterFace (Omnigent):
        href: https://{{ infra_domain_ai_omnigent }}
        icon: mdi-robot-outline
        description: Agent framework
    - Agent Memory:
        href: https://{{ infra_domain_ai_agentmemory }}
        icon: mdi-database-outline
        description: Agent memory store
    - Headroom (AI Shrink):
        href: https://{{ infra_domain_ai_aishrink }}
        icon: mdi-compress
        description: AI response compression
    - Langfuse:
        href: https://{{ infra_domain_ai_langfuse }}
        icon: langfuse.svg
        description: LLM observability & tracing
    - Paperclip:
        href: https://{{ infra_domain_ai_paperclip }}
        icon: mdi-robot-outline
        description: AI agent orchestration platform
    - Buzz:
        href: https://{{ infra_domain_ai_buzz }}
