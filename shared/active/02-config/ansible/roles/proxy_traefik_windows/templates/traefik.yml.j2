# Traefik Static Configuration — Windows Docker Desktop
# Generated by Ansible - DO NOT EDIT MANUALLY
# This Traefik instance runs on the Windows Docker host (nl) and handles
# TLS termination for services running on the Windows machine.

global:
  checkNewVersion: false
  sendAnonymousUsage: false

# API and Dashboard configuration
# insecure: true serves the dashboard on the internal traefik entrypoint
# (port 8080) without authentication. The container maps 8882:{{ infra_port_proxy_dashboard_host }} so the
# dashboard is accessible on the host's port 8882 but not exposed externally.
api:
  dashboard: true
  insecure: true

# Entry points
entryPoints:
  web:
    address: ":{{ proxy_traefik_windows_http_port }}"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":{{ proxy_traefik_windows_https_port }}"
    http:
      tls: true

# File provider — dynamic config from mounted volume
providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

# ACME/Let's Encrypt configuration — DNS-01 challenge via Cloudflare
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ proxy_traefik_windows_acme_email | to_json }}
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: cloudflare
        delayBeforeCheck: "{{ infra_dns_ttl_short }}"
        resolvers:
          - "{{ infra_endpoint_cloudflare_dns_primary }}"
          - "{{ infra_endpoint_google_dns_primary }}"
{% if proxy_traefik_windows_acme_staging %}
      caServer: https://acme-staging-v02.api.letsencrypt.org/directory
{% else %}
      caServer: https://acme-v02.api.letsencrypt.org/directory
{% endif %}

# Logging configuration
log:
  level: {{ proxy_traefik_windows_log_level | to_json }}
  filePath: /var/log/traefik/traefik.log
  format: json

accessLog:
  filePath: /var/log/traefik/access.log
  format: json
  fields:
    headers:
      defaultMode: keep
      names:
        User-Agent: keep
        Authorization: drop
        Content-Type: keep
