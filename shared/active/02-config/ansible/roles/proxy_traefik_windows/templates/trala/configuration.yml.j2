---
# TraLa Configuration — nl (Windows)
# Auto-discovers routers from the Windows Traefik instance.
# Manual entries list services from the cno network that are not on this Traefik.

version: "3.0"  # project-lint: disable=magic-dotted  version number, not an operational magic number

environment:
  selfhst_icon_url: https://cdn.jsdelivr.net/gh/selfhst/icons/
  traefik:
    enable_basic_auth: false

services:
  # Exclude HTTP-to-HTTPS redirect routers, the Traefik API router,
  # and the trala/homepage routers themselves
  exclude:
    routers:
      - "*-http"
      - "traefik-api"
      - "web-to-websecure"
      - "prometheus"
      - "trala-nl-http"
      - "trala-nl-https"
      - "homepage-nl-http"
      - "homepage-nl-https"
    entrypoints:
      - "web"

  overrides:
    - service: "verdaccio-nl-https"
      display_name: "Verdaccio (nl)"
      icon: mdi-package-variant
      group: NPM Registries

  manual:
    # Cross-network dashboards
    - name: Homepage (cno)
      url: https://{{ infra_domain_dashboard_homepage_cno }}
      icon: mdi-view-dashboard
      group: Launch Pages
    - name: Homepage (nl)
      url: https://{{ infra_domain_dashboard_homepage_nl }}
      icon: mdi-view-dashboard
      group: Launch Pages
    - name: TraLa (cno)
      url: https://{{ infra_domain_dashboard_trala_cno }}
      icon: mdi-view-dashboard
      group: Launch Pages

    # NPM Registries — cno duplicate
    - name: Verdaccio (cno)
      url: https://{{ infra_domain_artifact_verdaccio_cno }}
      icon: mdi-package-variant
      group: NPM Registries

    # AI Services (cno only)
    - name: AI Gateway (LiteLLM)
      url: https://{{ infra_domain_ai_litellm }}
      icon: litellm.svg
      group: AI Services
    - name: OmniRoute
      url: https://{{ infra_domain_ai_omniroute }}
      icon: mdi-route
      group: AI Services
    - name: AI InterFace (Omnigent)
      url: https://{{ infra_domain_ai_omnigent }}
      icon: mdi-robot-outline
      group: AI Services
    - name: Agent Memory
      url: https://{{ infra_domain_ai_agentmemory }}
      icon: mdi-database-outline
      group: AI Services
    - name: Headroom (AI Shrink)
      url: https://{{ infra_domain_ai_aishrink }}
      icon: mdi-compress
      group: AI Services
    - name: Langfuse
      url: https://{{ infra_domain_ai_langfuse }}
      icon: langfuse.svg
      group: AI Services
    - name: Paperclip
      url: https://{{ infra_domain_ai_paperclip }}
      icon: mdi-robot-outline
      group: AI Services
    - name: Buzz
      url: https://{{ infra_domain_ai_buzz }}
      icon: mdi-bug
      group: AI Services

    # Search & Tools (cno only)
    - name: SearXNG Search
      url: https://{{ infra_domain_proxy_search }}
      icon: searxng.svg
      group: Search & Tools
    - name: Croc Relay
      url: https://{{ infra_domain_tools_croc_relay }}
      icon: mdi-file-send
      group: Search & Tools

    # Security (cno only)
    - name: Authelia SSO
      url: https://{{ infra_domain_sso_authelia }}
      icon: authelia.svg
      group: Security
    - name: Wazuh
      url: https://{{ infra_domain_security_wazuh }}
      icon: wazuh.svg
      group: Security

    # Infrastructure (cno only)
    - name: Traefik Dashboard (cno)
      url: https://{{ infra_domain_traefik_dashboard }}
      icon: mdi-router-network
      group: Infrastructure
    - name: RustFS
      url: https://{{ infra_domain_storage_rustfs }}
      icon: mdi-database
      group: Infrastructure
    - name: RustFS Console
      url: https://{{ infra_domain_storage_rustfs_console }}
      icon: mdi-console
      group: Infrastructure
    - name: QM
      url: https://{{ infra_domain_ai_qm }}
      icon: mdi-account-group
      group: Infrastructure

    # Career (cno only)
    - name: JobOps
      url: https://{{ infra_domain_career_jobops }}
      icon: mdi-briefcase
      group: Career
