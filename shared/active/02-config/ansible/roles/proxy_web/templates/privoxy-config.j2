# Privoxy Configuration
# Generated by proxy-web role from privoxy-config.j2
# See: diagrams/proxy/complete-web-proxy-chain.mmd

# Listen address — internal only (not exposed to host)
listen-address  0.0.0.0:{{ proxy_web_privoxy_container_port }}

# Forward to Varnish cache (Layer 4)
forward /  {{ proxy_web_varnish_ip }}:{{ proxy_web_varnish_http_container_port }}

# Disable toggles via remote — security
enable-remote-toggle  0
enable-edit-actions 0

# Log level — minimal
logfile privoxy.log
logdir /var/log/privoxy
