# Varnish VCL — Forward Proxy Cache
# Generated by proxy-web role from varnish-default.vcl.j2
# See: diagrams/proxy/complete-web-proxy-chain.mmd
# See: requirements/proxy/caching-strategy.md
#
# stale-while-revalidate: handled via beresp.grace (built-in)
# stale-if-error: handled via grace + vcl_backend_error fallback

vcl 4.1;

import std;

# Default backend — Gost egress multiplexer
backend default {
    .host = "{{ proxy_web_gost_ip }}";
    .port = "{{ proxy_web_gost_http_container_port }}";
    .connect_timeout = 5s;
    .first_byte_timeout = 30s;
    .between_bytes_timeout = 10s;
}

# Grace period for stale-while-revalidate and stale-if-error
sub vcl_backend_response {
    # Serve stale for up to 10 seconds while revalidating
    set beresp.grace = 10s;

    # Default TTL: 1 hour for cacheable responses
    if (beresp.ttl <= 0s) {
        set beresp.ttl = 1h;
    }

    # Don't cache responses with Authorization or Set-Cookie headers
    if (beresp.http.Authorization || beresp.http.Set-Cookie) {
        set beresp.uncacheable = true;
        set beresp.ttl = 120s;
        return (deliver);
    }

    # Cache successful responses
    if (beresp.status >= 200 && beresp.status < 300) {
        unset beresp.http.Set-Cookie;
        return (deliver);
    }
}

sub vcl_recv {
    # Pass through non-cacheable requests
    if (req.method != "GET" && req.method != "HEAD") {
        return (pass);
    }

    # Pass through requests with Authorization header
    if (req.http.Authorization) {
        return (pass);
    }

    # Pass through requests with Cookie header
    if (req.http.Cookie) {
        return (pass);
    }

    return (hash);
}

sub vcl_hit {
    # Object is fresh — deliver
    if (obj.ttl >= 0s) {
        return (deliver);
    }

    # Object is stale but within grace — deliver and background fetch
    if (obj.ttl + obj.grace > 0s) {
        return (deliver);
    }

    return (pass);
}

# Note: stale-if-error via vcl_backend_error + stale.exists requires Varnish 6.0+.
# The grace period above (beresp.grace) provides stale-while-revalidate for all versions.
