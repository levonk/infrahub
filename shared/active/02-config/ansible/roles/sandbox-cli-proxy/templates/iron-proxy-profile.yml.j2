---
# iron-proxy configuration for {{ profile.name }} profile
# Generated by Ansible - DO NOT EDIT MANUALLY
# See ADR-202608051501 for the sandboxed CLI egress architecture.

# DNS server configuration
dns:
  enabled: {{ sandbox_cli_proxy_dns_enabled | ternary('true', 'false') }}
  listen: ":{{ profile.dns_port | default(infra_port_dns_host) }}"
  proxy_ip: "{{ sandbox_cli_proxy_dns_proxy_ip }}"
  upstream_resolver: "{{ sandbox_cli_proxy_upstream_dns }}"
  passthrough:
    - "*.internal.corp"
    - "metadata.google.internal"
    - "metadata.oracle.internal"

# Proxy listener configuration
proxy:
  http_listen: ":{{ sandbox_cli_proxy_http_container_port | default(infra_port_proxy_http_host) }}"
  https_listen: ":{{ sandbox_cli_proxy_https_container_port | default(infra_port_proxy_https_host) }}"
  max_request_body_bytes: {{ sandbox_cli_proxy_max_request_body_bytes }}
  max_response_body_bytes: {{ sandbox_cli_proxy_max_response_body_bytes }}
  upstream_response_header_timeout: "{{ sandbox_cli_proxy_upstream_timeout }}"

  # CIDRs the proxy refuses to dial upstream (prevents DNS rebinding and IMDS access)
  upstream_deny_cidrs:
    - "{{ infra_network_metadata_endpoint }}"   # AWS / GCP / Azure IPv4 IMDS
    - "fd00:ec2::254/128"    # AWS IPv6 IMDS  # project-lint: disable=magic-int  memory/buffer/IPv6 constant, not a standalone magic number
    - "{{ infra_network_localhost_cidr }}"          # IPv4 loopback
    - "::1/128"              # IPv6 loopback  # project-lint: disable=magic-int  memory/buffer/IPv6 constant, not a standalone magic number

# TLS / MITM configuration
tls:
  mode: "{{ sandbox_cli_proxy_tls_mode }}"
  ca_cert: "/etc/iron-proxy/ca.crt"
  ca_key: "/etc/iron-proxy/ca.key"
  cert_cache_size: {{ sandbox_cli_proxy_cert_cache_size }}
  leaf_cert_expiry_hours: {{ sandbox_cli_proxy_leaf_cert_expiry_hours }}

# Transform configuration
transforms:
  # Allowlist transform - default-deny egress for sandboxed CLI tools
  - name: allowlist
    config:
      # When false, block non-allowlisted traffic (default-deny)
      warn: {{ sandbox_cli_proxy_allowlist_warn | ternary('true', 'false') }}
      # Rule form: restrict by method and path
      rules:
{% for rule in profile.allowlist_rules %}
        - host: "{{ rule.host }}"
          methods: {{ rule.methods | to_json }}
          paths: {{ rule.paths | to_json }}
{% endfor %}
