# Wazuh certificate generation config
# Used by wazuh-certs-generator container to create TLS certs for
# internal inter-container communication (manager ↔ indexer ↔ dashboard).
# Generated by Ansible - DO NOT EDIT MANUALLY.
---
nodes:
  indexer:
    - name: "{{ wazuh_indexer_container_name }}"
      ip: "{{ wazuh_indexer_ip }}"
  server:
    - name: "{{ wazuh_manager_container_name }}"
      ip: "{{ wazuh_manager_ip }}"
  dashboard:
    - name: "{{ wazuh_dashboard_container_name }}"
      ip: "{{ wazuh_dashboard_ip }}"
