# copyparty configuration
# Pseudo-YAML: [section] headers with 2-space indented keys.
# Inline comments require TWO spaces before #.
# See internal-docs/research/service/copyparty/copyparty-overview.md.

[global]
  p: {{ copyparty_container_port }}
  e2dsa  # enable file indexing
  e2ts  # enable media tag indexing
  hist: /cfg/hists  # keep sqlite index/thumbnails out of shared volumes
  xff-hdr: cf-connecting-ip  # Cloudflare Tunnel sends real client IP in this header
  xff-src: lan  # trust proxy headers from the docker network (cloudflared container)
  rproxy: 1  # project-lint: disable=magic-int  copyparty config: one reverse proxy in front
  acao: *  # allow all origins — copyparty handles auth internally; CORS check otherwise rejects HTTPS origin when behind Cloudflare Tunnel (HTTP to origin)
  i: 0.0.0.0  # project-lint: disable  copyparty config: bind all interfaces inside container
  css-browser: /public/.res/catppuccin-mocha.css  # custom theme served from /w/public/.res/
  themes: 11  # project-lint: disable=magic-int  copyparty config: add theme slot 10 for catppuccin
  theme: 10  # project-lint: disable=magic-int  copyparty config: default to catppuccin theme

[accounts]
  admin: {{ copyparty_admin_password }}

[/public]
  /w/public
  accs:
    r: *  # anonymous read
    rwmda: admin  # admin full access

[/uploads]
  /w/uploads
  accs:
    w: *  # anonymous write-only (drop-box: upload but cannot see contents)
    rwmda: admin  # admin full access

[/family]
  /w/family
  accs:
    rwmda: admin  # admin full access
