{
  "_bug_note": "devbox >=0.14 ignores a top-level 'scripts' key — scripts must live under 'shell.scripts', otherwise 'devbox run <script>' silently falls back to the arbitrary-command path and fails with '<name>: command not found' (exit 127). Verified on devbox 0.18.0. See ADR-20260131001.",
  "packages": {
    "jq": "",
    "just": "",
    "yq-go": "",
    "ripgrep": "",
    "github:levonk/tkr#tkr": "",
    "nodejs": "",
    "pnpm": "",
    "git-secrets": "",
    "git-imerge": "",
    "github:kunchenguid/treehouse": ""
  },
  "env": {
    "SHELL": "/bin/zsh",
    "XDG_CACHE_DIR": "/var/cache",
    "XDG_RUNTIME_DIR": "/run/user/1000"
  },
  "shell": {
    "init_hook": [
      "just bootstrap-internal"
    ],
    "scripts": {
      "bootstrap": "just bootstrap",
      "clean": "just clean",
      "clean-full": "just clean-full",
      "clean-configs": "just clean-configs",
      "fix-configs": "just fix-configs",
      "build": "just build",
      "lint": "just lint",
      "lint-claude": "just lint-claude",
      "test": "just test",
      "test-all": "just test-all",
      "test-claude": "just test-claude",
      "up": "just up",
      "down": "just down",
      "restart": "just restart",
      "logs": "just logs",
      "health-check": "just health-check",
      "ps": "just ps",
      "stats": "just stats",
      "pull": "just pull",
      "config": "just config",
      "cloud-up": "just cloud-up",
      "cloud-down": "just cloud-down",
      "base-up": "just base-up",
      "up-agents": "just up-agents",
      "up-base01": "just up-base01",
      "up-base02": "just up-base02",
      "up-core": "just up-core",
      "up-nix": "just up-nix",
      "up-dns": "just up-dns",
      "up-security": "just up-security",
      "up-core-nix": "just up-core-nix",
      "up-localnet": "just up-localnet",
      "up-prod": "just up-prod",
      "up-test": "just up-test",
      "doc-search": "just doc-search",
      "tasks": "just tasks",
      "task-ready": "just task-ready",
      "task-start": "just task-start"
    }
  }
