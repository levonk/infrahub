graph LR
    subgraph "Transparent Mode external queries"
        T1["Client"] -->|Port 53| T2["nftables"]
        T2 -->|TPROXY| T3["AdGuard"]
        T3 --> A2
    end

    subgraph "Direct Mode external queries"
        D1["Client"] -->|Port 5353/5501| D2["dnsdist direct"]
        D2 --> A2
    end

    subgraph "VPN Mode external queries via Tailscale"
        V1["VPN Client"] -->|WireGuard Tunnel| V2["Host DNS"]
        V2 -->|Port 5353| V3["AdGuard"]
        V3 --> A2
    end

    subgraph "Tailscale Internal Mode trusted no encryption stack"
        TS1["Tailscale Client"] -->|MagicDNS / local zone| TS2["CoreDNS local zones"]
        TS2 -->|Direct response<br/>WireGuard encrypts transport| TS1
        TS_NOTE["No AdGuard, dnsdist, Unbound, or fallback chain needed.<br/>Tailscale WireGuard tunnel provides transport encryption.<br/>Only applies to internal/Tailscale names."]
    end

    subgraph "Remaining Stack external queries only"
        A2["dnsdist:5353"] -->|Security blocklists| A3["CoreDNS:5353"]
        A3 -->|Validating cache| A3b["Unbound:5353"]
        A3b -->|Fallback chain| A4["Encrypted tiers:5353"]
    end

    style T2 fill:#ff9999,color:#1a1a1a
    style D2 fill:#99ff99,color:#1a1a1a
    style V2 fill:#99ccff,color:#1a1a1a
    style T3 fill:#F4CCCC,color:#1a1a1a
    style TS2 fill:#D9EAD3,color:#1a1a1a
    style TS_NOTE fill:#D9EAD3,color:#1a1a1a
