    log_start "Linting configuration files"
    @{{DC_LOCAL}} --profile all config > /dev/null && log_end "docker-compose.yml syntax valid" || (log_error "docker-compose.yml syntax invalid"; exit 1)
    if command -v yamllint >/dev/null 2>&1; then \
        find . -name "*.yml" -o -name "*.yaml" | xargs yamllint --no-warnings || log_warn "yamllint not configured"; \
    else \
        log_warn "yamllint not installed"; \
    fi
    log_end "Lint complete"

# Run tests for Claude Code services
test-claude:
    @just _devbox test-claude_impl

[private]
test-claude_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running Claude Code service tests"
    @{{DC_LOCAL}} --profile claude-code ps | grep -q "claude-code" && log_end "Claude Code services are running" || (log_error "Claude Code services not running"; exit 1)
    log_info "Testing Claude Code API health..."
    @{{DC_LOCAL}} exec -T claude-code curl -f http://localhost:8081/health >/dev/null 2>&1 && log_end "Claude Code API healthy" || log_warn "Claude Code API not responding"
    @{{DC_LOCAL}} exec -T claude-code-ui curl -f http://localhost:3000/health >/dev/null 2>&1 && log_end "Claude Code UI healthy" || log_warn "Claude Code UI not responding"
    @{{DC_LOCAL}} exec -T claude-code-auth curl -f http://localhost:8080/health >/dev/null 2>&1 && log_end "Claude Code Auth healthy" || log_warn "Claude Code Auth not responding"
    log_end "Claude Code tests complete"

# Lint Claude Code docker-compose configuration
lint-claude:
    @just _devbox lint-claude_impl

[private]
lint-claude_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting Claude Code configuration"
    @COMPOSE_PARALLEL_LIMIT={{COMPOSE_PARALLEL_LIMIT}} DOCKER_BUILDKIT=1 docker compose -f services/ai-codeassist/claude-code/claude-code/docker-compose.claude-code.yml config > /dev/null && log_end "Claude Code docker-compose.yml syntax valid" || (log_error "Claude Code docker-compose.yml syntax invalid"; exit 1)
    if command -v yamllint >/dev/null 2>&1; then \
        yamllint services/ai-codeassist/claude-code/claude-code/docker-compose.claude-code.yml || log_warn "yamllint issues found"; \
    else \
        log_warn "yamllint not installed"; \
    fi
    log_end "Claude Code lint complete"

