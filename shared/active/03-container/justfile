# Remove Docker-created config directories (safe, no data loss)
clean-configs:
    @just _devbox clean-configs_impl

[private]
clean-configs_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning up Docker-created config directories"
    @docker run --rm -v "{{justfile_directory()}}/configs:/configs" alpine sh -c '\
        find /configs -type d \( \
            -name "*.conf" -o \
            -name "*.yaml" -o \
            -name "*.yml" -o \
            -name "config" -o \
            -name "config.yaml" \
        \) -exec rm -rf {} + 2>/dev/null || true'
    log_end "Config directories removed"
    log_info "Run .just fix-configs. to recreate config files"

# Recreate all config files from templates
fix-configs:
    @just _devbox fix-configs_impl

[private]
fix-configs_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    devbox run clean-configs_impl
    log_start "Recreating config files"
    @./scripts/create-configs.sh
    log_end "Config files created"

# Remove all containers, volumes, and networks, then restart services
clean-full:
    @just _devbox clean-full_impl

[private]
clean-full_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just log-start "clean-full"
    log_start "Cleaning up Docker resources and restarting"
    log_info "Stopping and removing all containers..."
    ({{DC_LOCAL}} --profile all down -v --remove-orphans 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]}) || true
    log_info "Force-removing any stuck containers..."
    ./scripts/cleanup-containers.sh 2>&1 | tee -a {{LOG_FILE}} || true
    log_info "Removing networks..."
    @docker network rm {{NETWORK_NAME}} 2>&1 | tee -a {{LOG_FILE}} || true
    @docker network rm localnet_default 2>&1 | tee -a {{LOG_FILE}} || true
    log_info "Pruning system..."
    @docker system prune -f --volumes 2>&1 | tee -a {{LOG_FILE}} || true
    @sleep 2
    log_end "Cleanup complete, starting services..."
    just up 2>&1 | tee -a {{LOG_FILE}}
    @just log-end "clean-full" "SUCCESS"

