# View just execution log
view-log:
    @if [ -f {{LOG_FILE}} ]; then \
        ./scripts/echo-colors.sh blue "=== Just Execution Log ==="; \
        cat {{LOG_FILE}}; \
    else \
        ./scripts/echo-colors.sh yellow "No log file found at {{LOG_FILE}}"; \
    fi

# Tail just execution log (follow mode)
tail-log:
    @if [ -f {{LOG_FILE}} ]; then \
        ./scripts/echo-colors.sh blue "=== Tailing Just Log (Ctrl+C to exit) ==="; \
        tail -f {{LOG_FILE}}; \
    else \
        ./scripts/echo-colors.sh yellow "No log file found at {{LOG_FILE}}"; \
    fi

# Clear just execution log
clear-log:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_warn "Clearing log file..."
    @rm -f {{LOG_FILE}}
    log_end "Log cleared"

# ============================================================================
# NX Build Orchestration (NEW - Phase 8.6)
# ============================================================================

# NX: Build base images (foundation layer)
nx-build-base:
    @just _devbox nx-build-base_impl

[private]
nx-build-base_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "NX: Building base images with dependency graph"
    @if [ "{{NX_AVAILABLE}}" = "true" ]; then \
        {{NX_BIN}} run-many --verbose -t docker:build --projects=tag:base --parallel=1; \
    else \
        log_info "NX not installed, falling back to legacy build..."; \
        just base-up; \
    fi

# NX: Build sidecars (depends on base images)
nx-build-sidecars:
    @just _devbox nx-build-sidecars_impl

[private]
nx-build-sidecars_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "NX: Building sidecar containers"
    @if [ "{{NX_AVAILABLE}}" = "true" ]; then \
        {{NX_BIN}} run-many --verbose -t docker:build --projects=tag:sidecar --parallel=2; \
    else \
        log_info "NX not installed, using docker compose..."; \
        just up-core-nix_impl; \
    fi

# NX: Build all services (uses dependency graph for optimal ordering)
nx-build:
    @just _devbox nx-build_impl

[private]
nx-build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "NX: Building all services with smart caching"
    @if [ "{{NX_AVAILABLE}}" = "true" ]; then \
        {{NX_BIN}} run-many --verbose -t docker:build --all --parallel=2; \
    else \
        log_info "NX not installed, falling back to just build..."; \
        just build_impl; \
    fi

# NX: Build only affected services (changed since last commit)
nx-affected:
    @just _devbox nx-affected_impl

[private]
nx-affected_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "NX: Building only affected services"
    @if [ "{{NX_AVAILABLE}}" = "true" ]; then \
        {{NX_BIN}} affected --verbose -t docker:build --base=main --head=HEAD; \
    else \
        log_info "NX not installed"; \
        exit 1; \
    fi

# NX: Visualize dependency graph
nx-graph:
    @just _devbox nx-graph_impl

[private]
nx-graph_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "NX: Opening dependency graph"
    @if [ "{{NX_AVAILABLE}}" = "true" ]; then \
        {{NX_BIN}} --verbose graph; \
    else \
        log_info "NX not installed. Run: pnpm install"; \
        exit 1; \
    fi

# NX: Install dependencies
nx-install:
    @just _devbox nx-install_impl

[private]
nx-install_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Installing NX dependencies"
    @export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}" && \
        export PATH="$PNPM_HOME:$PATH" && \
        pnpm install && \
        log_end "NX dependencies installed"

# NX: Clear build cache
nx-clear-cache:
    @just _devbox nx-clear-cache_impl

[private]
nx-clear-cache_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_warn "Clearing NX build cache..."
    @rm -rf .nx/cache
    @docker builder prune -f
    log_end "NX cache cleared"

