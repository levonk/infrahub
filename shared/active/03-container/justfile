# Memory management & task tracking (NEW - ADR-20260322003)
doc-search query=".":
    @just _devbox doc-search_impl {{query}}

[private]
doc-search_impl query=".":
    #!/usr/bin/env bash
    set -euo pipefail
    # Search memory and documentation with qmd
    if command -v qmd >/dev/null 2>&1; then \
        qmd search "{{query}}" | head -20; \
    else \
        echo "qmd not found - install with: cargo install qmd"; \
        echo "Falling back to ripgrep..."; \
        rg --type md "{{query}}" docs/ internal-docs/ memory/ || true; \
    fi

tasks:
    @just _devbox tasks_impl

[private]
tasks_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    # List current tasks
    if [ -f ".devbox/nix/profile/default/bin/tkr" ]; then \
        .devbox/nix/profile/default/bin/tkr list --status=open; \
    elif command -v tkr >/dev/null 2>&1; then \
        tkr list --status=open; \
    else \
        echo "tkr not found - install from: https://github.com/levonk/tkr"; \
    fi

task-ready:
    @just _devbox task-ready_impl

[private]
task-ready_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Getting next available task"
    @if [ -f ".devbox/nix/profile/default/bin/tkr" ]; then \
        .devbox/nix/profile/default/bin/tkr ready; \
    elif command -v tkr >/dev/null 2>&1; then \
        tkr ready; \
    else \
        echo "tkr not found - install from: https://github.com/levonk/tkr"; \
    fi

task-start:
    @just _devbox task-start_impl

[private]
task-start_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting available task"
    @if command -v tkr >/dev/null 2>&1; then \
        task_id=$$(tkr ready | head -1 | cut -d' ' -f1); \
        if [ -n "$$task_id" ]; then \
            tkr start "$$task_id"; \
            log_info "Started task: $$task_id"; \
        else \
            log_info "No available tasks"; \
        fi; \
    else \
        echo "tkr not found - install from: https://github.com/levonk/tkr"; \
    fi

