# Archon Environment Configuration
# Generated by Ansible from .env.archon.j2 — DO NOT EDIT MANUALLY
# Secrets sourced from client vault (infrahub-levonk-all.vault.yml)
# Infrastructure vars sourced from shared/levonk infrastructure/*.yml

# ============================================================================
# Archon PostgreSQL
# ============================================================================
ARCHON_DB_PASSWORD={{ archon_postgres_password }}
ARCHON_DB_USER={{ archon_db_user | default('archon') }}
ARCHON_DB_NAME={{ archon_db_name | default('remote_coding_agent') }}
ARCHON_DB_CONTAINER_NAME={{ infra_hostname_archon_postgres | default('archon-postgres') }}

# ============================================================================
# Archon Server
# ============================================================================
ARCHON_IMAGE={{ archon_image | default('ghcr.io/coleam00/archon') }}
ARCHON_IMAGE_TAG={{ archon_image_tag | default('latest') }}
ARCHON_CONTAINER_NAME={{ infra_hostname_archon | default('archon') }}
ARCHON_CONTAINER_PORT={{ infra_port_ai_archon_container | default('3000') }}
ARCHON_HOST_PORT={{ infra_port_ai_archon_host | default('3090') }}
ARCHON_LOG_LEVEL={{ archon_log_level | default('info') }}
ARCHON_MAX_CONCURRENT={{ archon_max_concurrent | default('10') }}

# ============================================================================
# AI Credentials — Pipeline-routed
# ============================================================================
# CLAUDE_API_KEY is a LiteLLM virtual key when ANTHROPIC_BASE_URL is set.
# The Claude Code SDK inside the container routes through the LiteLLM pipeline
# (aigate) instead of directly to Anthropic. This gives all LLM calls:
# auth, PII masking, spend tracking, Langfuse traces, compression, routing.
CLAUDE_API_KEY={{ archon_claude_api_key }}
ANTHROPIC_BASE_URL={{ archon_anthropic_base_url | default('') }}

# ============================================================================
# Web UI Auth (Better Auth — PostgreSQL deploys)
# ============================================================================
BETTER_AUTH_SECRET={{ archon_better_auth_secret }}
ARCHON_AUTH_ALLOWED_EMAILS={{ archon_auth_allowed_emails | default('') }}
ARCHON_AUTH_OPEN_SIGNUP={{ archon_auth_open_signup | default('false') }}

# ============================================================================
# Platform Adapters
# ============================================================================
TELEGRAM_BOT_TOKEN={{ archon_telegram_bot_token | default('') }}
DISCORD_BOT_TOKEN={{ archon_discord_bot_token | default('') }}
GH_TOKEN={{ archon_github_token | default('') }}
GITHUB_TOKEN={{ archon_github_token | default('') }}
WEBHOOK_SECRET={{ archon_webhook_secret | default('') }}
