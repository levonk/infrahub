# Archon Environment Example
# Copy to .env and fill in values for local testing.
# For client deploys, Ansible generates .env.archon from .env.archon.j2 using vault secrets.

# ── Database ──────────────────────────────────────
ARCHON_DB_PASSWORD=changeme
ARCHON_DB_USER=archon
ARCHON_DB_NAME=remote_coding_agent

# ── Server ────────────────────────────────────────
ARCHON_IMAGE=ghcr.io/coleam00/archon
ARCHON_IMAGE_TAG=latest
ARCHON_CONTAINER_NAME=archon
ARCHON_CONTAINER_PORT=3000
ARCHON_HOST_PORT=3090
ARCHON_LOG_LEVEL=info
ARCHON_MAX_CONCURRENT=10

# ── AI Credentials (required) ─────────────────────
# Option A: Direct Claude API key (bypasses pipeline)
# CLAUDE_API_KEY=sk-ant-xxxxx
# Option B: Pipeline-routed (LiteLLM virtual key + base URL)
CLAUDE_API_KEY=sk-ant-xxxxx
ANTHROPIC_BASE_URL=http://localhost:4000

# ── Web UI Auth (Better Auth) ──────────────────────
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
ARCHON_AUTH_ALLOWED_EMAILS=admin@example.com
ARCHON_AUTH_OPEN_SIGNUP=false

# ── Platform Adapters (optional) ───────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
GH_TOKEN=
GITHUB_TOKEN=
WEBHOOK_SECRET=
