# Nuxt Tweet Organizer Service - Standard Developer UX Flow
# Following ADR-20260131001 Standard Developer UX Flow

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Default target
default:
    @echo "Available targets:"
    @echo "  up          - Start the service"
    @echo "  down        - Stop the service"
    @echo "  build       - Build the Docker image"
    @echo "  rebuild     - Rebuild the Docker image"
    @echo "  logs        - Show service logs"
    @echo "  health      - Check service health"
    @echo "  shell       - Open shell in container"
    @echo "  test        - Run tests"
    @echo "  clean       - Clean up containers and images"
    @echo "  bootstrap   - Bootstrap the service"

# Normal targets - Developer interface (REQUIRED)
up:
    @just up_impl

[private]
up_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting Nuxt Tweet Organizer service"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet up -d
    log_end "Service started at http://localhost:${APPS_NUXT_TWEET_ORG_HOST_PORT:-3000}"

down:
    @just down_impl

[private]
down_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Stopping Nuxt Tweet Organizer service"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet down
    log_end "Service stopped"

build:
    @just build_impl

[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building Nuxt Tweet Organizer image"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet build
    log_end "Build complete"

rebuild:
    @just rebuild_impl

[private]
rebuild_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Rebuilding Nuxt Tweet Organizer image"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet build --no-cache
    log_end "Rebuild complete"

logs:
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet logs -f

health:
    @just health_impl

[private]
health_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Checking Nuxt Tweet Organizer health"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet ps
    @echo ""
    @docker exec localnet-apps-nuxt-tweet-org curl -f http://localhost:${APPS_NUXT_TWEET_ORG_CONTAINER_PORT:-3000} || log_error "Service not responding"

shell:
    @docker exec -it localnet-apps-nuxt-tweet-org /bin/sh

test:
    @just test_impl

[private]
test_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Running Nuxt Tweet Organizer tests"
    @./tests/test-nuxt-tweet-org.sh

clean:
    @just clean_impl

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Cleaning up Nuxt Tweet Organizer"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet down -v
    @docker image prune -f
    log_end "Cleanup complete"

# Bootstrap recipes (REQUIRED)
bootstrap:
    @just bootstrap_impl

[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping Nuxt Tweet Organizer service"
    just setup_impl
    log_end "Bootstrap complete"

# Health and diagnostics (REQUIRED)
doctor:
    @echo "🩺 Running diagnostics for Nuxt Tweet Organizer..."
    @echo "Checking Docker..."
    @docker --version
    @echo "Checking docker-compose..."
    @docker compose version
    @echo "Checking environment file..."
    @test -f ../../.env.local.localnet && echo "✅ Environment file exists" || echo "❌ Environment file missing"
    @echo "Checking required variables..."
    @grep -q "X_CLIENT_ID" ../../.env.local.localnet && echo "✅ X_CLIENT_ID found" || echo "❌ X_CLIENT_ID missing"
    @grep -q "X_CLIENT_SECRET" ../../.env.local.localnet && echo "✅ X_CLIENT_SECRET found" || echo "❌ X_CLIENT_SECRET missing"
    @grep -q "NUXT_SESSION_PASSWORD" ../../.env.local.localnet && echo "✅ NUXT_SESSION_PASSWORD found" || echo "❌ NUXT_SESSION_PASSWORD missing"

# Quality checks (OPTIONAL but RECOMMENDED)
quality:
    @just quality_impl

[private]
quality_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just lint_impl
    just test_impl
    just health_impl

# Language-specific commands (OPTIONAL)
lint:
    @just lint_impl

[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting Docker configuration"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet config --quiet

# Development setup (OPTIONAL)
setup:
    @just setup_impl

[private]
setup_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Setting up development environment"
    log_info "Checking pnpm-sidecar dependency..."
    @docker network inspect localnet > /dev/null 2>&1 || (log_error "localnet network not found - run from localnet root"; exit 1)
    @docker volume inspect localnet-pnpm-cache > /dev/null 2>&1 || (log_error "pnpm-cache volume not found - run from localnet root"; exit 1)
    log_end "Development environment ready"

# Deep clean (OPTIONAL)
clean-all:
    @just clean-all_impl

[private]
clean-all_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Deep cleanup"
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet down -v
    @docker image rm localnet-apps-nuxt-tweet-org:latest 2>/dev/null || true
    log_end "Deep cleanup complete"

# Development shortcuts
dev: up
restart: down up
status: health
ps:
    @docker compose -f docker-compose.yml --env-file ../../.env.local.localnet ps

# Production shortcuts
prod-up:
    @just prod-up_impl

[private]
prod-up_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting Nuxt Tweet Organizer in production mode"
    @NODE_ENV=production docker compose -f docker-compose.yml --env-file ../../.env.local.localnet up -d

prod-rebuild:
    @just prod-rebuild_impl

[private]
prod-rebuild_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Rebuilding for production"
    @NODE_ENV=production docker compose -f docker-compose.yml --env-file ../../.env.local.localnet build --no-cache
    @just prod-up

# Utility targets
env-check:
    @echo "🔍 Checking environment variables..."
    @echo "X_CLIENT_ID: ${X_CLIENT_ID:+SET}"
    @echo "X_CLIENT_SECRET: ${X_CLIENT_SECRET:+SET}"
    @echo "NUXT_SESSION_PASSWORD: ${NUXT_SESSION_PASSWORD:+SET}"
    @echo "APPS_NUXT_TWEET_ORG_HOST_PORT: ${APPS_NUXT_TWEET_ORG_HOST_PORT:-3000}"
    @echo "APPS_NUXT_TWEET_ORG_IP: ${APPS_NUXT_TWEET_ORG_IP:-172.20.255.71}"

# Help target
help:
    @echo "Nuxt Tweet Organizer Service - Standard Developer UX Flow"
    @echo ""
    @echo "Quick start:"
    @echo "  just up          # Start the service"
    @echo "  just logs        # View logs"
    @echo "  just down        # Stop the service"
    @echo ""
    @echo "Development:"
    @echo "  just rebuild     # Rebuild the image"
    @echo "  just test        # Run tests"
    @echo "  just health      # Check health"
    @echo "  just shell       # Open shell"
    @echo ""
    @echo "Environment:"
    @echo "  just doctor      # Check environment"
    @echo "  just env-check   # Show env vars"
    @echo ""
    @echo "Cleanup:"
    @echo "  just clean       # Clean containers"
    @echo "  just clean-all   # Deep clean"
