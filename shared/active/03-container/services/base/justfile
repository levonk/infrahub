# View logs from all base services
logs:
    @just _devbox logs_impl

[private]
logs_impl:
    @{{DC_BASE}} logs --tail=100

# Follow logs from all base services
logs-follow:
    @just _devbox logs-follow_impl

[private]
logs-follow_impl:
    @{{DC_BASE}} logs -f

# Show running containers
ps:
    @just _devbox ps_impl

[private]
ps_impl:
    @{{DC_BASE}} ps

# Health check for base services
health-check:
    @just _devbox health-check_impl

[private]
health-check_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Checking base service health"
    {{DC_BASE}} ps
    log_end "Health check complete"

# Clean up containers and networks
clean:
    @just _devbox clean_impl

[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just log-start "clean"
    log_start "Cleaning up base containers and networks"
    ({{DC_BASE}} down --remove-orphans 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]}) && (log_end "Cleanup complete"; just log-end "clean" "SUCCESS") || (log_error "Cleanup failed"; just log-end "clean" "FAILED"; exit 1)

# Clean up containers, networks, and volumes
clean-all:
    @just _devbox clean-all_impl

[private]
clean-all_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just log-start "clean-all"
    log_start "Cleaning up base containers, networks, and volumes"
    ({{DC_BASE}} down -v --remove-orphans 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]}) && (log_end "Full cleanup complete"; just log-end "clean-all" "SUCCESS") || (log_error "Full cleanup failed"; just log-end "clean-all" "FAILED"; exit 1)

