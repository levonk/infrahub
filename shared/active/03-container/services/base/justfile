    @just _devbox down_impl

[private]
down_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just log-start "down"
    log_start "Stopping all base services"
    ({{DC_BASE}} down 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]}) && (log_end "Base services stopped"; just log-end "down" "SUCCESS") || (log_error "Base services failed to stop"; just log-end "down" "FAILED"; exit 1)

