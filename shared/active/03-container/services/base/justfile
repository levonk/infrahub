# Build all base images (profile-based)
build:
    @just _devbox build_impl

[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just log-start "build"
    log_start "Building all base images"
    # Build base01 (debian/alpine/sidecar)
    log_start "Building base01 (debian/alpine/sidecar)"
    ({{DC_BASE}} --profile base01 build 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]})
    # Build base02 (debnix)
    log_start "Building base02 (debnix)"
    ({{DC_BASE}} --profile base02 build 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]})
    # Build base03 (dev)
    log_start "Building base03 (dev)"
    ({{DC_BASE}} --profile base03 build 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]}) && (log_end "All base images built"; just log-end "build" "SUCCESS") || (log_error "Build failed"; just log-end "build" "FAILED"; exit 1)

