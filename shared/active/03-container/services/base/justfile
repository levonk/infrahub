# Build base-alpine
build-base-alpine:
    @just _devbox build-base-alpine_impl

[private]
build-base-alpine_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    just log-start "build-base-alpine"
    log_start "Building base-alpine"
    ({{DC_BASE}} --progress=plain build base-alpine 2>&1 | tee -a {{LOG_FILE}}; exit ${PIPESTATUS[0]}) && (log_end "base-alpine built"; just log-end "build-base-alpine" "SUCCESS") || (log_error "base-alpine build failed"; just log-end "build-base-alpine" "FAILED"; exit 1)

