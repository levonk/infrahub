# no-mistakes Global Configuration
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# This template is rendered by Ansible at deploy time and mounted into the
# container at /home/gate/config.yaml. The entrypoint copies it to
# $NM_HOME/config.yaml on startup.
#
# Reference: https://kunchenguid.github.io/no-mistakes/reference/global-config/

agent: acp:devin
acpx_path: /usr/local/bin/acpx

acp_registry_overrides:
  devin: devin acp --model swe-1-7-medium

# Telemetry is disabled via the NO_MISTAKES_TELEMETRY=0 environment variable
# set in the Dockerfile. No config key needed here.

# Auto-fix attempt limits per pipeline step.
# When a step fails, no-mistakes asks the AI agent to fix the issue and
# retries up to this many times before giving up.
auto_fix:
  rebase: 3
  review: 3
  test: 3
  document: 3
  lint: 3
  ci: 3
