http:
  address: 0.0.0.0:{{ dns_adguard_web_container_port }}
  session_ttl: 720h
users:
  - name: {{ dns_adguard_admin_user }}
    password: "{{ dns_adguard_admin_password_hash }}"
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: ""
theme: auto
dns:
  bind_hosts:
    - 0.0.0.0
  port: {{ dns_adguard_container_port }}
  anonymize_client_ip: false
  protection_enabled: true
  blocking_mode: default
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_response_ttl: 10
  protection_disabled_sec: 0
  edns_cs_enabled: false
  edns_cs_use_custom: false
  edns_cs_custom_ip: ""
  disable_ipv6: false
  upstream_dns:
    - "{{ dns_dnsdist_ip }}:{{ dns_dnsdist_main_container_port }}"
  upstream_dns_file: ""
  bootstrap_dns:
    - 1.1.1.1
    - 9.9.9.9
  fallback_dns:
    - "{{ dns_dnscrypt_plaintext_ip }}:{{ dns_dnscrypt_plaintext_container_port }}"
  fallback_dns_file: ""
  all_servers: false
  fastest_addr: false
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies: []
  cache_size: 4194304
  cache_ttl_min: 60
  cache_ttl_max: 86400
  cache_optimistic: true
  bogus_nxdomain: []
  aaaa_blocked: false
  remove_private_addresses: false
  dnssec_enabled: false
  upstream_mode: load_balance
  max_goroutines: 50
  ipset: []
  use_private_ptr_resolvers: true
  local_ptr_upstreams: []
  use_dns64: false
  dns64_cidrs: []
  default_local_ptr_upstream: ""
tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 853
  port_dnscrypt: 5443
  dnscrypt_config_file: ""
  allow_unencrypted_do_h: false
  strict_sni_check: false
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2
whitelist_filters: []
user_rules: []
dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_cidr: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false
clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    hosts: true
    persistent: true
log_file: ""
log_maxbackups: 0
log_maxsize: 100
log_maxage: 3
log_compress: false
log_localtime: false
verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0
schema_version: 28
