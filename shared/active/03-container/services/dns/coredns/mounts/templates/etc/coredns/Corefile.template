# CoreDNS Corefile — Updated for Unbound validating cache (Option C)
# See: requirements/dns/dnssec-gap-and-unbound-fix.md
#
# Two listener blocks:
#   1. External port (from dnsdist) — cache + local zones, forwards to Unbound
#   2. Internal port (from Unbound) — runs the ordered fallback chain through tiers

# External listener — receives queries from dnsdist
.:{DNS_COREDNS_MAIN_CONTAINER_PORT} {
    forward . {DNS_UNBOUND_VALIDATOR_IP}:{DNS_UNBOUND_VALIDATOR_CONTAINER_PORT} {
        policy sequential
    }
    log
    debug
    errors
    cache 3600 {
        success 9984 30
        denial 9984 30
        prefetch 5 10s 80%
        serve_stale 8h verify
    }
    health :{DNS_COREDNS_MAIN_HEALTH_CONTAINER_PORT} {
        lameduck 2s
    }
}

# Internal listener — Unbound forwards to this port for the fallback chain
# Ordered fallback through privacy tiers, ending with Unbound Root (direct
# ICANN recursive resolution, no third party) and Plaintext (last resort).
# No third-party DNS resolvers (e.g. Quad9, Cloudflare) in this chain —
# those are only used as bootstrap DNS in AdGuard/Windows to resolve
# DoH/DoT/ODoH endpoint hostnames before encrypted DNS is available.
.:{DNS_COREDNS_INTERNAL_CONTAINER_PORT} {
    forward . {DNS_DNSCRYPT_ODOH_IP}:{DNS_DNSCRYPT_ODOH_CONTAINER_PORT} {DNS_DNSCRYPT_ANON_IP}:{DNS_DNSCRYPT_ANON_CONTAINER_PORT} {DNS_UNBOUND_TOR_IP}:{DNS_UNBOUND_TOR_CONTAINER_PORT} {DNS_DNSCRYPT_STD_IP}:{DNS_DNSCRYPT_STD_CONTAINER_PORT} {DNS_DNSCRYPT_DOH_IP}:{DNS_DNSCRYPT_DOH_CONTAINER_PORT} {DNS_DNSCRYPT_ENCRYPTED_IP}:{DNS_DNSCRYPT_ENCRYPTED_CONTAINER_PORT} {DNS_UNBOUND_ROOT_IP}:{DNS_UNBOUND_ROOT_CONTAINER_PORT} {DNS_DNSCRYPT_PLAINTEXT_IP}:{DNS_DNSCRYPT_PLAINTEXT_CONTAINER_PORT} {
        policy sequential
    }
    errors
}
