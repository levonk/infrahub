# DNS Service Stack - Justfile
# Following ADR-20260131001: direnv → devbox → just (*_impl) → [command]

_log := '
_jv_has() {
  local cat="$1"
  local v="${JUST_LOG:-0}"
  case "$v" in
    1|all) return 0 ;;
    0|"") return 1 ;;
  esac
  v="${v//startend/start,end}"
  echo ",$v," | grep -q ",$cat,"
}
log_info()   { _jv_has info   && echo "$*" || true; }
log_start()  { _jv_has start  && echo "▶ $*" || true; }
log_end()    { _jv_has end    && echo "✔ $*" || true; }
log_status() { _jv_has status && echo "$*" || true; }
log_warn()   { echo "⚠️  $*" >&2; }
log_error()  { echo "❌ $*" >&2; }
log_startend() {
  local msg="$1"; shift
  local rc
  _jv_has start && echo "▶ $msg" || true
  rc=0; "$@" || rc=$?
  _jv_has end && echo "✔ $msg complete" || true
  return $rc
}
'

# Devbox auto-detection: run impl target directly if in devbox,
# re-exec via devbox run if not, or fail with doctor diagnostic.
_devbox target *args:
    #!/usr/bin/env bash
    {{_log}}
    if [ "${DEVBOX_SHELL_ENABLED:-0}" = "1" ]; then
        exec just "{{target}}" {{args}}
    elif command -v devbox >/dev/null 2>&1; then
        exec devbox run -- just "{{target}}" {{args}}
    else
        log_error "devbox not found in PATH."
        log_warn "Running doctor to diagnose environment issues..."
        just doctor 2>/dev/null || true
        exit 1
    fi

# Configuration
PROJECT_DIR := "../.."
COMPOSE_FILE := "docker-compose.dns.yml"
ENSURE_NETWORK := "../../scripts/ensure-network.py"

# Determine env args for docker compose
ENV_ARGS := if path_exists(".env") == "true" { "--env-file ./.env" } else { "" }
ENV_ARGS2 := ENV_ARGS + if path_exists("../../.env") == "true" { " --env-file ../../.env" } else { "" }

# Docker compose command base
COMPOSE_BASE := "docker compose --project-directory " + PROJECT_DIR + " -f " + COMPOSE_FILE + " " + ENV_ARGS2

# Default recipe - show help
[private]
default:
    @just --list

# =============================================================================
# Normal Targets (Developer Interface)
# Primary pattern: just x → _devbox → just x_impl
# =============================================================================

# Build local Docker images for the DNS stack
build:
    @just _devbox build_impl

# Start DNS services in detached mode
up:
    @just _devbox up_impl

# Stop DNS services and remove containers
down:
    @just _devbox down_impl

# Restart DNS services
restart:
    @just _devbox restart_impl

# Show container status
status:
    @just _devbox status_impl

# Tail last 200 lines from all DNS containers
logs:
    @just _devbox logs_impl

# Follow logs for all DNS containers
logs-follow:
    @just _devbox logs-follow_impl

# Run DNS health probes inside the stack
health-check:
    @just _devbox health-check_impl

# Validate docker-compose configuration
lint:
    @just _devbox lint_impl

# Remove containers and networks (keep volumes)
clean:
    @just _devbox clean_impl

# Open a shell in the dnsdist container (default)
shell:
    @just _devbox shell_impl

# Rebuild DNS blocklists using compiler container
blocklists-refresh:
    @just _devbox blocklists-refresh_impl

# List compiled blocklist entries summary
blocklists-view:
    @just _devbox blocklists-view_impl

# Development mode - follow logs
dev:
    @just _devbox dev_impl

# Run tests (placeholder for DNS stack)
test:
    @just _devbox test_impl

# =============================================================================
# Internal Targets (Actual Implementation)
# These are called by _devbox and do the actual work
# =============================================================================

# Internal: Build local Docker images
[private]
build_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Building DNS service images"
    {{COMPOSE_BASE}} build
    log_end "Images built"

# Internal: Start DNS services
[private]
up_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Starting DNS services"
    {{ENSURE_NETWORK}} --project-directory {{PROJECT_DIR}} -f {{COMPOSE_FILE}}
    {{COMPOSE_BASE}} up -d
    log_end "Services started"
    log_info "Run 'just health-check' once the containers have finished booting."

# Internal: Stop DNS services
[private]
down_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Stopping DNS services"
    {{COMPOSE_BASE}} down
    log_end "Services stopped"

# Internal: Restart DNS services
[private]
restart_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Restarting DNS services"
    {{ENSURE_NETWORK}} --project-directory {{PROJECT_DIR}} -f {{COMPOSE_FILE}}
    {{COMPOSE_BASE}} restart dnsdist coredns dnscrypt-proxy
    log_end "Services restarted"

# Internal: Show container status
[private]
status_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "DNS container status"
    {{COMPOSE_BASE}} ps

# Internal: Show logs (last 200 lines)
[private]
logs_impl:
    {{COMPOSE_BASE}} logs --tail=200

# Internal: Follow logs
[private]
logs-follow_impl:
    {{COMPOSE_BASE}} logs -f

# Internal: Show dnsdist logs
[private]
logs-dnsdist_impl:
    {{COMPOSE_BASE}} logs --tail=200 dnsdist

# Internal: Show CoreDNS logs
[private]
logs-coredns_impl:
    {{COMPOSE_BASE}} logs --tail=200 coredns

# Internal: Show dnscrypt-proxy logs
[private]
logs-dnscrypt_impl:
    {{COMPOSE_BASE}} logs --tail=200 dnscrypt-proxy

# Internal: Run health checks
[private]
health-check_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_info "Inspecting container status..."
    {{COMPOSE_BASE}} ps
    echo ""
    log_info "Running dnsdist resolution probe..."
    DNSDIST_OUTPUT=$({{COMPOSE_BASE}} exec dnsdist dig +short health.check.local @127.0.0.1 2>/dev/null)
    if [ -n "$DNSDIST_OUTPUT" ]; then
        log_end "dnsdist responded to health.check.local"
    else
        log_error "dnsdist failed to resolve health.check.local"
    fi
    log_info "Validating dnscrypt-proxy upstream resolution..."
    {{COMPOSE_BASE}} exec dnscrypt-proxy dnscrypt-proxy -resolve cloudflare.com -config /etc/dnscrypt-proxy/dnscrypt-proxy.toml >/dev/null 2>&1 && \
        log_end "dnscrypt-proxy resolved cloudflare.com" || \
        log_error "dnscrypt-proxy could not resolve cloudflare.com"
    log_info "Checking blocklist artifacts..."
    {{COMPOSE_BASE}} exec dnsdist test -f /etc/dnsdist/blocklists/blocklist.cdb && \
        log_end "Compiled blocklist available" || \
        log_error "Compiled blocklist missing"

# Internal: Validate docker-compose configuration
[private]
lint_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Linting docker-compose configuration"
    {{COMPOSE_BASE}} config >/dev/null && log_end "docker-compose configuration valid"
    if command -v yamllint >/dev/null 2>&1; then
        yamllint {{COMPOSE_FILE}}
    else
        log_warn "yamllint not installed"
    fi

# Internal: Remove containers and networks (keep volumes)
[private]
clean_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Removing DNS containers and networks"
    {{COMPOSE_BASE}} down --remove-orphans
    docker network prune -f >/dev/null
    log_end "Containers and networks removed"

# Internal: Deep clean (remove volumes - data loss!)
[private]
clean-all_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_warn "This will delete all DNS volumes and data"
    read -p "Are you sure? [y/N] " -n 1 -r
    echo ""
    if echo "$REPLY" | grep -Eq '^[Yy]$'; then
        {{COMPOSE_BASE}} down -v --remove-orphans
        docker network prune -f >/dev/null
        log_end "All DNS volumes removed"
    else
        log_warn "Cancelled"
    fi

# Internal: Open shell in dnsdist (default)
[private]
shell_impl:
    just shell-dnsdist_impl

# Internal: Open shell in dnsdist
[private]
shell-dnsdist_impl:
    {{COMPOSE_BASE}} exec dnsdist /bin/sh

# Internal: Open shell in CoreDNS
[private]
shell-coredns_impl:
    {{COMPOSE_BASE}} exec coredns /bin/sh

# Internal: Open shell in dnscrypt-proxy
[private]
shell-dnscrypt_impl:
    {{COMPOSE_BASE}} exec dnscrypt-proxy /bin/sh

# Internal: Rebuild blocklists
[private]
blocklists-refresh_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Rebuilding DNS blocklists"
    {{COMPOSE_BASE}} run --rm blocklist-compiler
    log_end "Blocklists rebuilt"

# Internal: List blocklist files
[private]
blocklists-view_impl:
    {{COMPOSE_BASE}} exec dnsdist ls -lh /etc/dnsdist/blocklists

# =============================================================================
# Required ADR-20260131001 Targets
# =============================================================================

# Bootstrap the development environment
bootstrap:
    @just _devbox bootstrap_impl

# Internal: Bootstrap logic
[private]
bootstrap_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Bootstrapping DNS service stack"
    # Ensure docker network exists
    {{ENSURE_NETWORK}} --project-directory {{PROJECT_DIR}} -f {{COMPOSE_FILE}} || true
    # Build images
    just build_impl
    log_end "Bootstrap complete"

# Prime code indexing and analysis tools
prime:
    @just _devbox prime_impl

# Internal: Prime logic
[private]
prime_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    {{_log}}
    log_start "Priming code indexing for DNS stack"
    # DNS stack doesn't need traditional code indexing, but we can validate configs
    just lint_impl
    log_end "Prime complete"

# Check development environment health
doctor:
    @just _devbox doctor_impl

# Internal: Doctor logic
[private]
doctor_impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Checking DNS stack environment health..."
    # Check Docker is running
    if ! docker info >/dev/null 2>&1; then
        echo "❌ Docker is not running"
        exit 1
    fi
    echo "✅ Docker is running"
    # Check docker compose is available
    if ! docker compose version >/dev/null 2>&1; then
        echo "❌ docker compose is not available"
        exit 1
    fi
    echo "✅ docker compose is available"
    # Check compose file exists
    if [ ! -f "{{COMPOSE_FILE}}" ]; then
        echo "❌ {{COMPOSE_FILE}} not found"
        exit 1
    fi
    echo "✅ {{COMPOSE_FILE}} exists"
    # Validate compose configuration
    just lint_impl
    echo "✅ Environment health check passed"

# Development mode (follow logs)
[private]
dev_impl:
    just logs-follow_impl

# Run tests (for DNS stack, this is health-check)
[private]
test_impl:
    just health-check_impl

