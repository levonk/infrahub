graph TD
    subgraph "Client Layer"
        Client[Client Device]
    end

    subgraph "Layer 0: Traffic Interception Host"
        direction LR
        nftables["nftables TPROXY<br/>Host Port 53 → AdGuard"]
    end

    subgraph "Layer 1: AdGuard — Ad/Tracker Blocking + UI"
        direction LR
        keepalived_adguard["keepalived VIP<br/>Local LAN cluster only"] --> adguard["AdGuard Home<br/>Ad/Tracker Blocking, Web UI, DHCP<br/>DNSSEC: sets DO bit, does NOT validate"]
    end

    subgraph "Layer 2: dnsdist — Security Blocklists + Rate Limiting"
        direction LR
        keepalived_dnsdist["keepalived VIP<br/>Local LAN cluster only"] --> dnsdist["dnsdist<br/>172.20.255.49:15353<br/>Security blocklists malware/phishing<br/>ECS stripping, rate limiting"]
        dnsdist --> Blocklist["CDB Blocklist<br/>Security — separate from AdGuard"]
        dnsdist --> RateLimit["Rate Limiter"]
        dnsdist --> ECSStrip["ECS Stripper"]
    end

    subgraph "Tailscale Trust Boundary"
        direction TB
        TSNote["Internal queries Tailscale MagicDNS, local zones<br/>are served directly by CoreDNS local zones.<br/>No encryption needed — WireGuard tunnel encrypts transport.<br/>Only EXTERNAL queries enter the fallback chain below."]
    end

    subgraph "Layer 3: CoreDNS — Fallback Orchestrator + Serve-Stale Cache"
        direction LR
        keepalived_coredns["keepalived VIP<br/>Local LAN cluster only"] --> coredns["CoreDNS<br/>172.20.255.51:15353<br/>Ordered fallback via forward plugin<br/>Cache with serve_stale answers when domain is down<br/>Local zones internal/Tailscale names<br/>DNSSEC: does NOT validate signing only"]
        coredns --> Cache["Cache + serve_stale"]
        coredns --> LocalZones["Local Zones<br/>Tailscale / internal"]
    end

    subgraph "Layer 3b: Unbound — Validating Cache DNSSEC Gap Fix"
        direction LR
        unbound_validator["Unbound Validating Cache<br/>172.20.255.50:15353<br/>Validates DNSSEC on ALL responses<br/>from the fallback chain before<br/>returning to CoreDNS<br/>Additional cache layer"]
    end

    subgraph "Layer 4: DNS Forwarding — Protocol Fallback Chain"
        direction LR
        subgraph "Tier 1: Oblivious DoH — ACTIVE"
            dnscrypt_odoh["dnscrypt-proxy ODoH<br/>172.20.255.52:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 2: Anonymized DNSCrypt — ACTIVE"
            keepalived_dnscrypt_anon["keepalived VIP"] --> dnscrypt_anon["dnscrypt-proxy Anon<br/>172.20.255.53:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 3: Unbound over Tor — ACTIVE"
            keepalived_unbound["keepalived VIP"] --> unbound_tor["Unbound over Tor<br/>172.20.255.54:15353<br/>Recursive → Root NS<br/>DNSSEC: validated natively by Unbound"]
        end
    end

    subgraph "Layer 4b: DNS Forwarding — Dark Tiers documented, not running by default"
        direction LR
        subgraph "Tier 4: DNSCrypt over Tor — DARK"
            dnscrypt_dnscrypt_tor["dnscrypt-proxy DNSCrypt/Tor<br/>172.20.255.55:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 5: DoH over Tor — DARK"
            dnscrypt_doh_tor["dnscrypt-proxy DoH/Tor<br/>172.20.255.56:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 6: DoT/TLS over Tor — DARK"
            dnscrypt_tls_tor["dnscrypt-proxy DoT/Tor<br/>172.20.255.57:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 7: Standard DNSCrypt — DARK"
            dnscrypt_std["dnscrypt-proxy STD<br/>172.20.255.58:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 8: DoH — DARK"
            dnscrypt_doh["dnscrypt-proxy DoH<br/>172.20.255.59:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 9: DoT/TLS — DARK"
            dnscrypt_encrypted["dnscrypt-proxy DoT/TLS<br/>172.20.255.60:5053<br/>DNSSEC: upstream validates<br/>+ Unbound re-validates"]
        end
        subgraph "Tier 10: Unbound to Root — ACTIVE"
            unbound_root["Unbound<br/>172.20.255.61:15353<br/>Recursive → Root NS<br/>DNSSEC: validated natively by Unbound"]
        end
        subgraph "Tier 11: Plaintext over Tor — DARK"
            dnscrypt_plaintext_tor["dnscrypt-proxy Plaintext/Tor<br/>172.20.255.62:5053<br/>DNSSEC: NO upstream validation<br/>Unbound validates response only"]
        end
        subgraph "Tier 12: Plaintext — DARK last resort"
            dnscrypt_plaintext["dnscrypt-proxy Plaintext<br/>172.20.255.63:5053<br/>DNSSEC: NO upstream validation<br/>Unbound validates response only"]
        end
    end

    subgraph "Layer 5: External Resolvers + Tor Transport"
        direction LR
        unbound_tor -- "Forwards through" --> tor_proxy
        dnscrypt_dnscrypt_tor -- "Forwards through" --> tor_proxy
        dnscrypt_doh_tor -- "Forwards through" --> tor_proxy
        dnscrypt_tls_tor -- "Forwards through" --> tor_proxy
        dnscrypt_plaintext_tor -- "Forwards through" --> tor_proxy
        tor_proxy["Tor SOCKS Proxy<br/>172.20.255.70:9050"]
        Resolvers["Cloudflare, Google, Quad9, Root NS, etc."]
    end

    subgraph "Cross-Cluster Failover see cross-cluster-dns-failover.md"
        direction TB
        LocalCluster["Local Cluster — nl.<base> LAN<br/>Windows host + Raspberry Pi<br/>keepalived VIP floats between them<br/>LAN clients use VIP"]
        CloudCluster["Cloud Cluster — cno.<base> OCI<br/>Single host, no keepalived<br/>Tailscale clients use OCI Tailscale IP"]
        FailoverNote["If cloud DNS fails:<br/>Oracle nodes fall back to local cluster<br/>via direct Tailscale IPs not hostname<br/>Constraint: cno has no blanket LAN access<br/>Only DNS port exposed via Tailscale"]
        LocalCluster -.-> "Tailscale node-to-node<br/>DNS port only" -.-> CloudCluster
        CloudCluster -.-> "Fallback direct Tailscale IPs<br/>100.x.x.10 Windows 100.x.x.11 Pi" -.-> LocalCluster
    end

    Client -- "Internal query<br/>Tailscale/local zone" --> coredns
    coredns -- "Local zone hit" --> LocalZones
    LocalZones -- "Direct response<br/>no encryption needed" --> coredns

    Client -- "External DNS query<br/>port 53" --> nftables
    nftables -- "Redirect to AdGuard" --> keepalived_adguard
    adguard -- "Filtered DNS" --> keepalived_dnsdist
    dnsdist -- "Forward" --> keepalived_coredns

    coredns -- "External query<br/>→ validating cache" --> unbound_validator
    unbound_validator -- "Forward to fallback chain" --> dnscrypt_odoh
    unbound_validator -- "Fallback 2" --> keepalived_dnscrypt_anon
    unbound_validator -- "Fallback 3" --> keepalived_unbound
    unbound_validator -- "Fallback 4 DARK" --> dnscrypt_dnscrypt_tor
    unbound_validator -- "Fallback 5 DARK" --> dnscrypt_doh_tor
    unbound_validator -- "Fallback 6 DARK" --> dnscrypt_tls_tor
    unbound_validator -- "Fallback 7 DARK" --> dnscrypt_std
    unbound_validator -- "Fallback 8 DARK" --> dnscrypt_doh
    unbound_validator -- "Fallback 9 DARK" --> dnscrypt_encrypted
    unbound_validator -- "Fallback 10" --> unbound_root

    dnscrypt_odoh -- "Encrypted query" --> Resolvers
    dnscrypt_anon -- "Encrypted query" --> Resolvers
    tor_proxy -- "via Tor" --> Resolvers
    dnscrypt_std -- "Encrypted query" --> Resolvers
    dnscrypt_doh -- "Encrypted query" --> Resolvers
    dnscrypt_encrypted -- "Encrypted query" --> Resolvers
    unbound_root -- "Recursive query" --> Resolvers
    dnscrypt_plaintext -- "Plaintext query" --> Resolvers

    Resolvers -- "Response" --> dnscrypt_odoh
    Resolvers -- "Response" --> dnscrypt_anon
    Resolvers -- "Response" --> unbound_tor
    Resolvers -- "Response" --> dnscrypt_dnscrypt_tor
    Resolvers -- "Response" --> dnscrypt_std
    Resolvers -- "Response" --> dnscrypt_doh
    Resolvers -- "Response" --> dnscrypt_encrypted
    Resolvers -- "Response" --> unbound_root
    Resolvers -- "Response" --> dnscrypt_plaintext

    dnscrypt_odoh -- "Response" --> unbound_validator
    dnscrypt_anon -- "Response" --> unbound_validator
    unbound_tor -- "Response DNSSEC validated natively" --> unbound_validator
    dnscrypt_dnscrypt_tor -- "Response" --> unbound_validator
    dnscrypt_std -- "Response" --> unbound_validator
    dnscrypt_doh -- "Response" --> unbound_validator
    dnscrypt_encrypted -- "Response" --> unbound_validator
    unbound_root -- "Response DNSSEC validated natively" --> unbound_validator
    dnscrypt_plaintext -- "Response" --> unbound_validator

    unbound_validator -- "DNSSEC-validated response" --> coredns
    coredns -- "Final response" --> dnsdist
    dnsdist -- "Final response" --> adguard
    adguard -- "Final response" --> Client

