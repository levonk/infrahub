    style dnsdist fill:#A6C1D5,color:#1a1a1a
    style coredns fill:#A6D5B2,color:#1a1a1a
    style unbound_validator fill:#B6D7A8,color:#1a1a1a
    style dnscrypt_odoh fill:#D5C4A6,color:#1a1a1a
    style dnscrypt_anon fill:#D5B3A6,color:#1a1a1a
    style unbound_tor fill:#C9DAF8,color:#1a1a1a
    style dnscrypt_std fill:#D5A6A6,color:#1a1a1a
    style dnscrypt_doh fill:#C4A6D5,color:#1a1a1a
    style dnscrypt_encrypted fill:#A6A6D5,color:#1a1a1a
    style unbound_root fill:#A6D5D5,color:#1a1a1a
